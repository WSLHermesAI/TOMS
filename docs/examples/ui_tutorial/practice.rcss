/* practice.rcss -- the UI editor tutorial's practice screen (docs/37_UI_EDITOR.md). Sizes are design pixels of the
   game's 1024 x 768 screen. */
body { z-index: 90; }

#card { position: absolute; left: 312px; top: 190px; width: 400px; padding: 24px 28px; }
#card-title { font-size: 30px; color: #f9e9b1; margin-bottom: 14px; }

.line { height: 42px; line-height: 42px; font-size: 22px; }
.line img { width: 32px; height: 32px; margin-right: 12px; vertical-align: middle; }
.label { color: #eef1f8; }
.value { color: #ffe066; margin-left: 14px; }

#you { margin-top: 10px; font-size: 17px; color: #cad0e1; }
#accept { margin-top: 20px; height: 48px; line-height: 48px; font-size: 22px; }
