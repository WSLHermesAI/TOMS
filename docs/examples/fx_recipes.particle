          "speed": 0,
          "size": 40,
          "rotation": [0, 45],
          "color": [1, 0.95, 0.8, 1],
          "sprite": "fx:star",
          "overLife": {
            "color": [ { "t": 0, "v": [1, 1, 1, 1], "ease": "quadraticIn" }, { "t": 1, "v": [1, 1, 1, 0] } ],
            "size": [ { "t": 0, "v": 0.6, "ease": "backOut" }, { "t": 1, "v": 1.3 } ]
          },
          "render": { "blend": "add", "order": 2 }
        }
      ]
    },
