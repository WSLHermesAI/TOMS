{
  "version": 1,
  "atlases": [
    "../../assets/media/atlas/fx.atlas",
    "../../assets/media/atlas/game.atlas"
  ],
  "effects": [
    {
      "name": "torch_fire",
      "prewarm": 1.0,
      "emitters": [
        {
          "name": "flames",
          "maxParticles": 60,
          "emission": { "rate": 40 },
          "shape": { "type": "circle", "radius": 5 },
          "life": [0.45, 0.8],
          "direction": -90, "spread": 12,
          "speed": [35, 60],
          "size": [14, 20],
          "rotation": [-8, 8],
          "color": [[1, 0.85, 0.45, 1], [1, 0.6, 0.25, 1]],
          "flipbook": { "frames": ["fx:flame_0", "fx:flame_1", "fx:flame_2", "fx:flame_3"], "mode": "fps", "fps": 10, "randomStart": true },
          "overLife": {
            "color": [
              { "t": 0, "v": [1, 1, 1, 0] },
              { "t": 0.15, "v": [1, 1, 1, 1] },
              { "t": 0.6, "v": [1, 0.55, 0.3, 0.8], "ease": "quadraticIn" },
              { "t": 1, "v": [0.6, 0.15, 0.05, 0] }
            ],
            "size": [ { "t": 0, "v": 1, "ease": "quadraticIn" }, { "t": 1, "v": 0.35 } ]
          },
          "forces": { "gravity": [0, -20] },
          "render": { "blend": "add", "order": 1 }
        },
        {
          "name": "embers",
          "maxParticles": 20,
          "emission": { "rate": 6 },
          "shape": { "type": "circle", "radius": 6 },
          "life": [0.8, 1.4],
          "direction": -90, "spread": 25,
          "speed": [30, 70],
          "size": [2, 4],
          "color": [1, 0.7, 0.3, 1],
          "sprite": "fx:dot",
          "overLife": { "color": [ { "t": 0.6, "v": [1, 1, 1, 1] }, { "t": 1, "v": [1, 0.4, 0.2, 0] } ] },
          "forces": { "drag": 0.6, "tangential": [-20, 20] },
          "render": { "blend": "add", "order": 2 }
        },
        {
          "name": "smoke",
          "offset": [0, -26],
          "maxParticles": 20,
          "emission": { "rate": 5 },
          "life": [1.5, 2.2],
          "direction": -90, "spread": 15,
          "speed": [15, 25],
          "size": [16, 22],
          "rotation": [0, 360], "spin": [-30, 30],
          "color": [0.25, 0.22, 0.2, 1],
          "sprite": "fx:smoke",
          "overLife": {
            "color": [ { "t": 0, "v": [1, 1, 1, 0] }, { "t": 0.25, "v": [1, 1, 1, 0.45] }, { "t": 1, "v": [1, 1, 1, 0] } ],
            "size": [ { "t": 0, "v": 0.6, "ease": "quadraticOut" }, { "t": 1, "v": 2 } ]
          },
          "render": { "order": 0 }
        }
      ]
    },
    {
      "name": "hit_sparks",
