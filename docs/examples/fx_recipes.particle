            "color": [ { "t": 0.5, "v": [1, 1, 1, 1] }, { "t": 1, "v": [1, 0.5, 0.2, 0] } ],
            "size": [ { "t": 0, "v": 1 }, { "t": 1, "v": 0.4 } ]
          },
          "forces": { "drag": 4, "gravity": [0, 200] },
          "render": { "blend": "add", "alignToVelocity": true, "order": 1 }
        },
        {
          "name": "flash",
          "maxParticles": 1,
          "emission": { "rate": 0, "bursts": [ { "t": 0, "count": 1 } ] },
