{
  "_comment": [
    "Special moves and special guards as data (docs/gameplay/16_SKILLS_AND_PLAYS.md Â§6; src/core/game/systems/special_moves.h).",
    "A new move is a new entry: its name (a text.json key), its play, three shows and its damage.",
    "use: ultimate (a weapon's, when the super charge is full: weapon_play.json \"ultimate\" names the move), guard (a monster's move names it: moves.json guardPlay).",
    "play.kind, a play type (docs/gameplay/17 Â§4.1): drawShape (trace the shape shown), swipeWay (the sword's prompts: cues), pullRelease (aim `points` moving targets),",
    "  mash (tap `points` times), freeSwipe / freeTap / freeShot (any swipe or tap counts for timeMs, 17 Â§5); timeMs: a shape's, a mash's or a free mode's time;",
    "  hitDamage: a free mode's each swipe or tap, times a normal attack; size / cornerRadius: a shape on the screen.",
    "demo: before the play; step: at each step done (at the step's place); finish: after the play.",
    "A beat: at (ms), do: pathFx (particles along the shape, `corner` at each corner) fx (on player / monster, else at the",
    "  step) dim countdown banner (text) name namePart (the name a step's share at a time) count (3/5) camera (zoom, on",
    "  player / monster, ms) clip (the player's clip) hits (count x gapMs: the move's damage over them) shake sound.",
    "damage: times a normal attack (the owner: N = 10 to start), times the share of the play done (Q45)."
  ],
  "free_swipe": {
    "name": "skill.free_swipe",
    "use": "ultimate",
    "prompt": "skill.prompt_free_swipe",
    "damage": 0,
    "play": { "kind": "freeSwipe", "timeMs": 3000, "hitDamage": 0.6 },
    "demo": [ { "at": 0, "do": "name", "ms": 700 }, { "at": 0, "do": "fx", "fx": "sword_great", "on": "player" }, { "at": 600, "do": "dim" } ],
    "step": [ { "do": "fx", "fx": "sword_great" } ],
    "finish": [ { "at": 0, "do": "shake", "value": 5, "ms": 300 } ]
  },
  "free_shot": {
    "name": "skill.free_shot",
    "use": "ultimate",
    "prompt": "skill.prompt_free_shot",
    "damage": 0,
    "play": { "kind": "freeShot", "timeMs": 2000, "hitDamage": 0.8 },
    "demo": [ { "at": 0, "do": "name", "ms": 700 }, { "at": 0, "do": "fx", "fx": "bow_great", "on": "player" }, { "at": 600, "do": "dim" } ],
    "step": [ { "do": "fx", "fx": "bow_perfect" } ],
    "finish": [ { "at": 0, "do": "shake", "value": 5, "ms": 300 } ]
  },
  "free_tap": {
    "name": "skill.free_tap",
    "use": "ultimate",
    "prompt": "skill.prompt_free_tap",
    "damage": 0,
    "play": { "kind": "freeTap", "timeMs": 2000, "hitDamage": 0.4 },
    "demo": [ { "at": 0, "do": "name", "ms": 700 }, { "at": 0, "do": "fx", "fx": "staff_great", "on": "player" }, { "at": 600, "do": "dim" } ],
    "step": [ { "do": "fx", "fx": "staff_perfect" } ],
    "finish": [ { "at": 0, "do": "shake", "value": 5, "ms": 300 } ]
  },
  "star_seal": {
    "name": "skill.star_seal",
    "weapon": "staff",
    "use": "ultimate",
    "prompt": "skill.prompt_draw",
    "damage": 10,
    "play": {
      "kind": "drawShape",
      "shape": "pentagram",
      "timeMs": 6000,
      "size": 230,
      "cornerRadius": 44
    },
    "demo": [
      {
        "at": 0,
        "do": "pathFx",
        "shape": "pentagram",
        "fx": "star_trail",
        "corner": "star_burst",
        "ms": 2000
      },
      {
        "at": 2100,
        "do": "dim"
      },
      {
        "at": 2100,
        "do": "countdown"
      }
    ],
    "step": [
      {
        "do": "fx",
        "fx": "star_burst_big"
      },
      {
        "do": "count"
      },
      {
        "do": "namePart"
      }
    ],
    "finish": [
      {
        "at": 0,
        "do": "name"
      },
      {
        "at": 0,
        "do": "camera",
        "zoom": 1.5,
        "on": "player",
        "ms": 1700
      },
      {
        "at": 200,
        "do": "clip",
        "clip": "attack_big"
      },
      {
        "at": 400,
        "do": "hits",
        "count": 10,
        "gapMs": 110
      },
      {
        "at": 400,
        "do": "shake",
        "value": 6,
        "ms": 1100
      }
    ]
  },
  "tiger_wind": {
    "name": "skill.tiger_wind",
    "weapon": "sword",
    "use": "ultimate",
    "prompt": "skill.prompt_cut",
    "damage": 4,
    "play": {
      "kind": "swipeWay",
      "cues": [
        "way",
        "way",
        "way",
        "way",
        "v"
      ]
    },
    "demo": [
      {
        "at": 0,
        "do": "name",
        "ms": 1000
      },
      {
        "at": 0,
        "do": "fx",
        "fx": "sword_great",
        "on": "player"
      },
      {
        "at": 900,
        "do": "dim"
      }
