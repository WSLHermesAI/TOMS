      "en": "The {item} turns. The gate opens."
    },
    "event.gotItem": {
      "zh_TW": "ç²å¾—ï¼š{item}",
      "en": "Received: {item}"
    },
    "npc.villager.name": {
      "zh_TW": "æ‘é•·",
      "en": "Village Elder"
    },
    "npc.villager.greeting": {
      "zh_TW": "å•Šï¼Œåˆæ˜¯ä½ ã€‚ä»Šå¤©æƒ³èŠä»€éº¼ï¼Ÿ",
      "en": "Ah, it's you again. What's on your mind?"
    },
    "talk.ok": {
      "zh_TW": "ç¢ºå®š",
