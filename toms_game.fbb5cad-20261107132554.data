    "stopMs": { "hit": 25, "great": 50, "perfect": 80, "parry": 90, "break": 120, "hurt": 30, "heavyHurt": 60, "ultimate": 120 },
    "shakePx": { "hit": 2, "great": 4, "perfect": 7, "parry": 4, "break": 9, "hurt": 4, "heavyHurt": 8, "ultimate": 10, "phase": 6 },
    "shakeMs": 250,
    "sounds": { "hit": "sfx.battle_hit", "great": "sfx.battle_great", "perfect": "sfx.battle_perfect", "miss": "sfx.battle_miss",
                "parry": "sfx.battle_parry", "block": "sfx.battle_block", "break": "sfx.battle_break", "ultimate": "sfx.battle_ultimate",
                "phase": "sfx.battle_phase", "win": "sfx.battle_win" },
    "slowMoMs": 450, "slowMoScale": 0.3,
    "winClip": "win", "winBigClip": "win_big", "winParClip": "win_par", "loseClip": "lose", "winParHp": 0.25, "endMaxMs": 2500, "reducedScale": 0.25, "chainStep": 0.1, "chainMax": 10
  },
  "grade": { "parSeconds": 25, "timePenalty": 1.5, "damagePenalty": 60, "perfectBonus": 30, "chainBonus": 3,
             "s": 95, "a": 75, "b": 55, "sGold": 0.2, "sCard": 0.25 },
  "guard": { "mode": "warn", "warnMs": 500, "parryShare": 0.4, "missLockMs": 400,
             "parryMs": 160, "blockMs": 550, "earlyMs": 1200, "blockPower": 70, "cooldownMs": 700 },
  "music": { "volume": 0.45, "fadeInMs": 400, "fadeOutMs": 800 },
  "backdrops": [
    { "from": 1, "to": 9999, "music": "music.forest_battle", "anim": "anim/battle_forest.anim", "clip": "idle", "size": [1792, 1024], "fx": ["forest_motes", "forest_fireflies"] }
  ],
  "cells": { "cols": 3, "rows": 2, "areaW": 450, "rowH": 58, "gap": 6, "maxH": 150, "perspective": 0.14, "warnMs": 1400, "shiftX": 55, "shiftNear": 40, "shiftY": 18,
             "intro": { "ms": 2200, "uiAtMs": 1200, "popMs": 350, "zoom": 1.25, "clip": "special", "fx": "danger_intro", "text": "battle.cell_intro" },
             "shapes": { "near": [{ "row": 0 }], "line": [{ "cols": "each" }], "fan": [{ "allBut": "start" }] } },
  "tutorial": {
    "_comment": "The new game's trial fight (docs/gameplay/19 B6). Each step shows its text until doneOn happens count times; once: not again for the next weapon tried.",
    "enemy": "thicketoad",
    "overrides": { "hp": 300, "atk": 8, "def": 0 },
    "steps": [
      { "text": "tutorial.attack", "mark": "attack", "doneOn": "heroHit", "count": 2, "hold": true },
      { "text": "tutorial.move", "mark": "cells", "doneOn": "dodge", "move": "toad_lesson_line", "once": true },
      { "text": "tutorial.guard", "mark": "guard", "doneOn": "guarded", "move": "toad_lesson_crush", "once": true },
      { "text": "tutorial.finish" }
    ]
  },
  "battleSpeeds": [0.75, 1, 1.25, 1.5],
  "plays": { "bowTimeMs": 4000, "bowMoveMs": 500, "bowMoveDist": 90, "bowHoldMs": 1500, "bowHoldPerStr": 40,
             "bowShakePx": 10, "bowShakePerDex": 0.05,
             "cueMs": 1000, "inputMs": 750, "inputAtEnd": true, "cueGapMs": 150,
             "cueExtraMs": { "v": 400, "m": 900, "square": 1100, "triangle": 800, "circle": 800 },
             "dexWayDeg": 1.5, "dexWayMaxDeg": 40, "dexGestureMaxDeg": 15, "dexCornerPct": 1.5, "dexWindowMs": 10, "freeMinSwipe": 25,
             "circleCountMs": 450, "circleHideMs": 500, "circleWarnMs": 500, "circleTapMs": 900, "circlePerfectMs": 500 },
  "training": { "cards": 1, "runsPerDay": 3, "fights": 3, "exp": 2.0, "weaponExp": 2 }
}
{
  "_comment": [
    "Per-character nudges for character clips (docs/engine/05_ANIMATION.md, 'Characters'; e.g. media/anim/archer_bow.anim).",
    "A character clip is made with one character and fitted to any other automatically: its 'hand' (where the bow is",
    "held) keeps its share of the visible body's height and its distance from the body's right edge, measured from the",
    "sprite's pixels. A character whose hand still looks off gets an entry here: the sprite name and the hand's extra",
    "move in pixels, x right and y down. Example: \"player_viking\": { \"hand\": [0, -1] } lifts the bow one pixel.",
    "A character not listed needs nothing."
  ]
}
