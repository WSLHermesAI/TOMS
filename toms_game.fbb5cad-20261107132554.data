{
  "npcId": "weapon_master",
  "_comment": "The start story (docs/gameplay/07 phase 3): the player tries the weapons (tryWeapon: the tutorial fight with a toad, battle.json tutorial), comes back to 'after' each time, and keeps one (chooseWeapon). Opened by the title's New Game.",
  "start": "intro",
  "nodes": {
    "intro": {
      "text": {
        "zh_TW": "æ‘å£ï¼Œä¸€ä½è€æ­¦å¸«æ””ä½äº†ä½ ï¼šã€Œè¦ä¸Šå¡”ï¼Ÿå…ˆæŒ‘ä¸€æŠŠè¶æ‰‹çš„å…µå™¨ã€‚å…ˆæ‹¿æ—é‚Šé‚£éš»è‹”è›™ç·´ç·´æ‰‹ï¼Œæˆ‘æ•™ä½ æ€éº¼æ‰“ï¼Œä¸åˆæ‰‹å°±æ›ã€‚ã€",
        "en": "At the edge of the village an old weapon master stops you: \"Climbing the tower? Pick a weapon that fits your hand first. Practise on the toad at the edge of the woods, and I will show you how to fight. Change if one does not suit you.\""
      },
      "choices": [
        {
          "label": {
            "zh_TW": "è½è½å„ç¨®å…µå™¨ã€‚",
            "en": "Tell me about them."
          },
          "next": "weapons"
        },
        {
          "label": {
            "zh_TW": "è©¦è©¦å¼“",
            "en": "Try the bow"
          },
          "action": {
            "type": "tryWeapon",
            "weapon": "bow"
          },
          "next": null
        },
        {
          "label": {
            "zh_TW": "è©¦è©¦åŠ",
            "en": "Try the sword"
          },
          "action": {
            "type": "tryWeapon",
            "weapon": "sword"
          },
          "next": null
        },
        {
          "label": {
            "zh_TW": "è©¦è©¦æ³•æ–",
            "en": "Try the staff"
          },
          "action": {
            "type": "tryWeapon",
            "weapon": "staff"
          },
          "next": null
        }
      ]
    },
    "weapons": {
      "text": {
        "zh_TW": "ã€Œå¼“ï¼šå¾€å¾Œæ‹‰å†æ”¾é–‹ï¼Œæ‹‰å¾—è¶Šä¹…è¶Šæœ‰åŠ›ã€‚åŠï¼šç…§è‘—æŒ‡ç¤ºçš„æ–¹å‘æ®ç ã€‚æ³•æ–ï¼šä¾åºé»ä¸­å‡ºç¾çš„åœ“åœˆã€‚ã€",
        "en": "\"The bow: draw back and let go, and the longer the draw, the harder the shot. The sword: slash the way it shows you. The staff: touch the circles in their order.\""
      },
      "choices": [
        {
          "label": {
            "zh_TW": "è©¦è©¦å¼“",
