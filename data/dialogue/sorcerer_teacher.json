          "next": "missions"
        },
        {
          "label": "懂了。",
          "next": null,
          "action": { "type": "setStoryFlag", "flag": "met_sorcerer" }
        }
      ]
    },
    "tip": {
      "text": "先吃攻擊寶石再打高防敵人，損血最少。防禦則降低你承受的每一擊。",
      "choices": [
        {
          "label": "記住了。",
          "next": null,
          "action": { "type": "setStoryFlag", "flag": "met_sorcerer" }
        }
      ]
    },
