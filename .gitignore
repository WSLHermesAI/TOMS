# build output (CMakePresets.json puts every preset under out/)
out/
build*/
.vs/
CMakeUserPresets.json
*.user
# runtime files written next to the exe
toms.log
# runtime saves when the game runs from the repo root (under out/ they are already ignored).
# Root-anchored: src/core/game/save/ is source code.
/save/

# local Claude Code settings (machine-specific)
.claude/
# runtime logs / ImGui layout
*.log
imgui.ini
# packaged builds (build_windows.bat / build_web.bat)
/dist/

# rootless dependency drops: apt-get download writes .deb files into the CWD (the repo root)
*.deb
frames/

# stray artifacts found in the tree (not build outputs, not sources).
# Patterns only -- a '#' is a comment only at the START of a line, so trailing comments make the
# whole line a literal pattern that matches nothing.
*.spv
tools/__pycache__/
tower_vulkan
assets/wqy-zenhei.ttc
