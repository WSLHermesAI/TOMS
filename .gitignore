frames/
build-linux/
build-web/
split_nodes/
*.o

# font asset not part of source
assets/wqy-zenhei.ttc
build-webgpu/
web/tower_vulkan_web.*

# emscripten build artifact
tower_vulkan

# Title phase runtime data: player saves/settings (local machine state, not source).
# See docs/TITLE_PHASE.md.
save/
# ImGui writes its window layout here on exit (desktop debug overlay).
imgui.ini

# Visual Studio / CMake (Windows) build output
build/
Debug/
Release/
.vs/
editor/out/
*.pdb
*.ilk

# Python bytecode from the tools/ generators (gen_floors.py imports gen_mazes.py)
__pycache__/
*.pyc

# runtime logs
*.log

# local Claude Code tool settings (machine-specific permission approvals)
.claude/

# Browser build output dirs (build_web.sh) — deployed via the gh-pages branch, not tracked here
web-gl/
web-gpu/
build-web-debug/
web-debug/

# build_web.sh writes a per-build *stamped* copy of every artifact (toms_web.<sha>-<timestamp>.{js,wasm,data})
# next to the plain-named ones; the stamp is the cache-buster the page references, and both sets are
# regenerated on every build, so they are not source. The plain-named copies in web/ stay tracked.
/web/toms_web.*.*

# Stray shader blobs a local build/run drops in the repo root: byte-identical duplicates of the
# tracked assets/shaders/ copies (they showed up as untracked noise in every `git status`).
# Root-anchored so assets/shaders/*.spv keeps being tracked.
/sprite.frag.spv
/sprite.vert.spv

# test output capture
/log_test_out.log
