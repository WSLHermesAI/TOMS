{
  "version": "0.2.1",
  "defaults": {},
  "configurations": [
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "battle_editor.exe (bin\\battle_editor.exe)",
      "name": "battle_editor (monsters, weapons, test battles)"
    },
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "atlas_editor.exe (bin\\atlas_editor.exe)",
      "name": "atlas_editor (game atlas)",
      "args": [
        "${workspaceRoot}\\art_raw\\atlas\\game.atlasproj"
      ]
    },
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "anim_editor.exe (bin\\anim_editor.exe)",
      "name": "anim_editor (preview clip)",
      "args": [
        "${workspaceRoot}\\tests\\smoke\\anim_preview.anim"
      ]
    },
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "gltf_viewer.exe (bin\\gltf_viewer.exe)",
      "name": "gltf_viewer (skinned test model)",
      "args": [
        "${workspaceRoot}\\tests\\gltf\\skin_tube.gltf"
      ]
    },
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "gltf_viewer.exe (bin\\gltf_viewer.exe)",
      "name": "gltf_viewer (Fox sample, after tools/gltf_viewer/fetch_samples.py)",
      "args": [
        "${workspaceRoot}\\Build\\gltf_samples\\Fox.glb"
      ]
    },
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "atlaspack.exe (bin\\atlaspack.exe)",
      "name": "atlaspack (rebuild game atlas)",
      "args": [
        "build",
        "${workspaceRoot}\\art_raw\\atlas\\game.atlasproj",
        "--all-variants"
      ]
    }
  ]
}
