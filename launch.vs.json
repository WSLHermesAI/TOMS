{
  "version": "0.2.1",
  "defaults": {},
  "configurations": [
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "toms_game.exe (bin\\toms_game.exe)",
      "name": "toms_game (auto renderer)"
    },
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "toms_game.exe (bin\\toms_game.exe)",
      "name": "toms_game (Direct3D 11)",
      "args": [ "--renderer=d3d11" ]
    },
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "toms_game.exe (bin\\toms_game.exe)",
      "name": "toms_game (Vulkan)",
      "args": [ "--renderer=vulkan" ]
    },
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "toms_editor.exe (bin\\toms_editor.exe)",
      "name": "toms_editor (Qt + bgfx)"
    },
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "atlas_editor.exe (bin\\atlas_editor.exe)",
      "name": "atlas_editor (game atlas)",
      "args": [ "${workspaceRoot}\\assets\\media\\atlas\\game.atlasproj" ]
    },
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "anim_editor.exe (bin\\anim_editor.exe)",
      "name": "anim_editor (preview clip)",
      "args": [ "${workspaceRoot}\\tests\\smoke\\anim_preview.anim" ]
    },
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "atlaspack.exe (bin\\atlaspack.exe)",
      "name": "atlaspack (rebuild game atlas)",
      "args": [ "build", "${workspaceRoot}\\assets\\media\\atlas\\game.atlasproj", "--all-variants" ]
    }
  ]
}
