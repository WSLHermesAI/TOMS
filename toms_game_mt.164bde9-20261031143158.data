    "ev_library_scholar_whisper.text": {
      "zh_TW": "æ›¸æ¶å¾Œå‚³ä¾†ä¹¾æ¾€çš„ä½èªï¼šã€Œé‚„æ²’æ‰¾åˆ°å—ï¼Ÿã€",
      "en": "A dry whisper comes from behind the shelves: \"Still haven't found it?\"",
