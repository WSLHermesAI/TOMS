    "ev_common_relic_road_v2.title": {
      "en": "Cart Ruts in Stone"
    },
    "ev_common_relic_road_v2.desc": {
      "en": "Two ruts worn deep into the stone road, by carts that stopped coming long ago."
    },
    "ev_common_relic_road_v2.text": {
      "en": "Two ruts are worn deep into the stone. Whatever carts made them stopped coming long ago."
    },
    "ev_common_relic_road_v3.title": {
      "en": "The Worn Seal"
    },
    "ev_common_relic_road_v3.desc": {
      "en": "A seal worn smooth is set into a dip in the road; no one can tell how old it is."
    },
    "ev_common_relic_road_v4.title": {
      "en": "The Defaced Milestone"
    },
    "ev_common_relic_road_v4.desc": {
      "en": "Half a milestone lies in the grass, its words chiselled off on purpose."
    },
    "ev_common_relic_road_v5.title": {
      "en": "The Dry Stone Lantern"
    },
    "ev_common_relic_road_v5.desc": {
      "en": "A nameless stone lantern stands where the old road ends; its oil dried up long ago."
    },
    "ev_common_whisper_old_road_v2.title": {
      "en": "Footsteps Ahead"
    },
    "ev_common_whisper_old_road_v2.desc": {
      "en": "A voice on the old road says someone walked it just before you."
    },
    "ev_common_whisper_old_road_v2.text": {
      "en": "\"You are not the first up this road today,\" a voice breathes. \"Just the slowest.\""
    },
    "ev_common_whisper_old_road_v3.title": {
      "en": "The Road Remembers"
    },
    "ev_common_whisper_old_road_v3.desc": {
      "en": "The old road whispers the names of those who never came back down."
    },
    "ev_common_whisper_old_road_v3.text": {
      "en": "The stones murmur names, one after another. None of them came back down."
    },
    "ev_common_whisper_old_road_v4.title": {
      "en": "A Warning Unfinished"
    },
    "ev_common_whisper_old_road_v4.desc": {
      "en": "A whisper begins a warning about the stairs and breaks off halfway."
    },
    "ev_common_whisper_old_road_v4.text": {
      "en": "\"Whatever you do on the stairs, don't...\" The whisper stops, as if a hand covered its mouth."
    },
    "ev_common_whisper_old_road_v5.title": {
      "en": "Those Who Wait Above"
    },
    "ev_common_whisper_old_road_v5.desc": {
      "en": "A whisper warns that the ones above have been waiting longer than you think."
    },
    "ev_common_cache_wall_v2.title": {
      "en": "The Hollow Brick"
    },
    "ev_common_cache_wall_v2.desc": {
      "en": "A brick that sounds hollow hides a small cache."
    },
    "ev_common_cache_wall_v2.text": {
      "en": "One brick sounds hollow under your knuckles. Behind it, someone left a small bundle."
    },
    "ev_common_cache_wall_v3.title": {
      "en": "The Oilpaper Parcel"
    },
    "ev_common_cache_wall_v3.desc": {
      "en": "Half an oilpaper parcel is stuffed into a crack in the wall, still fresh."
    },
    "ev_common_cache_wall_v4.title": {
      "en": "The Marked Nail"
    },
    "ev_common_cache_wall_v4.desc": {
      "en": "A copper nail stamped with a mark is hidden between the bricks."
    },
    "ev_common_cache_wall_v5.title": {
      "en": "Fresh Dust"
    },
    "ev_common_cache_wall_v5.desc": {
      "en": "The hiding place behind a loose brick is empty, but the dust is new."
    },
    "ev_common_trap_rubble_v2.title": {
      "en": "Pulled Supports"
    },
    "ev_common_trap_rubble_v2.desc": {
      "en": "Another rockfall: this time the wooden supports were pulled out."
    },
    "ev_common_trap_rubble_v3.title": {
      "en": "Loose Ceiling"
    },
    "ev_common_trap_rubble_v3.desc": {
      "en": "Pebbles trickle from a ceiling that is ready to come down."
    },
    "ev_common_trap_rubble_v3.text": {
      "en": "Pebbles trickle down from above. The ceiling here is one footstep from coming down."
    },
    "ev_common_trap_rubble_v4.title": {
      "en": "The Widening Crack"
    },
    "ev_common_trap_rubble_v4.desc": {
      "en": "A crack in the ceiling keeps widening; the falling rock is only the start."
    },
    "ev_common_trap_rubble_v5.title": {
      "en": "Tripwire in the Dust"
    },
    "ev_common_trap_rubble_v5.desc": {
      "en": "A thin wire across the passage brings the stones down."
    },
    "ev_common_trap_rubble_v5.text": {
      "en": "A thin wire runs across the passage, grey with dust. You see it a step too late."
    },
    "ev_common_rescue_lost_soldier_v2.title": {
      "en": "The Soldier Without a Squad"
    },
    "ev_common_rescue_lost_soldier_v2.desc": {
      "en": "A soldier who lost the squad asks you to lead the way to the stairs."
    },
    "ev_common_rescue_lost_soldier_v2.text": {
      "en": "\"My squad went up and I went the wrong way,\" the soldier says. \"Get me to the stairs and I'll owe you.\""
    },
    "ev_common_rescue_lost_soldier_v3.title": {
      "en": "Whose Side?"
    },
    "ev_common_rescue_lost_soldier_v3.desc": {
      "en": "A wounded soldier wants to know whose side you are on before taking your help."
    },
    "ev_common_rescue_lost_soldier_v4.title": {
      "en": "Relief at the Wall"
    },
    "ev_common_rescue_lost_soldier_v4.desc": {
      "en": "A soldier slumped against a broken wall is relieved to see you."
    },
    "ev_common_rescue_lost_soldier_v5.title": {
      "en": "The Last Ration"
    },
    "ev_common_rescue_lost_soldier_v5.desc": {
      "en": "A lost soldier shares a last ration in exchange for safe passage."
    },
    "ev_common_rescue_lost_soldier_v5.text": {
      "en": "\"Take half,\" the soldier says, holding out a last ration. \"Just don't leave me on this floor.\""
    },
    "ev_common_merchant_echo_ash_v2.title": {
      "en": "One More Ware"
    },
    "ev_common_merchant_echo_ash_v2.desc": {
      "en": "The merchant's echo in the ashes is back, with one more ware than before."
    },
    "ev_common_merchant_echo_ash_v3.title": {
      "en": "Prices in Ash"
    },
    "ev_common_merchant_echo_ash_v3.desc": {
      "en": "The echo names its prices in coins no one uses any more."
    },
    "ev_common_merchant_echo_ash_v3.text": {
      "en": "The echo names its prices in coins that have not been minted for a hundred years. You pay in what you have."
    },
    "ev_common_merchant_echo_ash_v4.title": {
      "en": "The Haggling Echo"
    },
    "ev_common_merchant_echo_ash_v4.desc": {
      "en": "The merchant's echo haggles with a customer who is not there."
    },
    "ev_common_merchant_echo_ash_v4.text": {
      "en": "The merchant's echo argues over a price with someone you cannot see, and loses."
    },
    "ev_common_merchant_echo_ash_v5.title": {
      "en": "Empty Crates"
    },
    "ev_common_merchant_echo_ash_v5.desc": {
      "en": "The echo sorts through empty crates, still waiting for business."
    },
    "ev_common_shard_wandering_v2.title": {
      "en": "The Unclaimed Shard"
    },
    "ev_common_shard_wandering_v2.desc": {
      "en": "A memory shard circles in place, as if waiting to be claimed."
    },
    "ev_common_shard_wandering_v3.title": {
      "en": "The Low Shard"
    },
    "ev_common_shard_wandering_v3.desc": {
      "en": "A memory shard drifts low along the floor, unwilling to leave it."
    },
    "ev_common_shard_wandering_v4.title": {
      "en": "A Borrowed Memory"
    },
    "ev_common_shard_wandering_v4.desc": {
      "en": "A memory shard shows a room you have never seen, yet somehow remember."
    },
    "ev_common_shard_wandering_v4.text": {
      "en": "Inside the shard: a room you have never stood in, and yet you know where the door is."
    },
    "ev_common_shard_wandering_v5.title": {
      "en": "The Fading Shard"
    },
    "ev_common_shard_wandering_v5.desc": {
      "en": "A memory shard is fading; touching it keeps a little of it."
    },
    "ev_common_shard_wandering_v5.text": {
      "en": "The shard is fading at the edges. When you touch it, a little of it stays with you."
    },
    "ev_library_torn_page.title": {
      "en": "The Torn Page"
    },
    "ev_library_torn_page.desc": {
      "en": "A page with one corner torn away neatly, as if left as a mark."
    },
    "ev_library_torn_page_v2.title": {
      "en": "The Second Page"
    },
    "ev_library_torn_page_v2.desc": {
      "en": "Another torn page, in the same hand as the first."
    },
    "ev_library_torn_page_v4.title": {
      "en": "The Fingerprint"
    },
    "ev_library_torn_page_v4.desc": {
      "en": "A ragged page on the lowest shelf carries a fresh fingerprint."
    },
    "ev_library_scholar_whisper.title": {
      "en": "The Scholar's Whisper"
    },
    "ev_library_scholar_whisper.desc": {
      "en": "A dry whisper behind the shelves asks whether you have found it yet."
    },
    "ev_library_scholar_whisper_v2.title": {
      "en": "Not Here"
    },
    "ev_library_scholar_whisper_v2.desc": {
      "en": "The whisper says the answer is not on this floor, but further down."
    },
    "ev_library_scholar_whisper_v4.title": {
      "en": "Don't Rush It"
    },
    "ev_library_scholar_whisper_v4.desc": {
      "en": "From deep in the stacks: once you find it, don't hurry to finish reading."
    },
    "ev_library_shelf_collapse.title": {
      "en": "The Falling Shelf"
    },
    "ev_library_shelf_collapse.desc": {
      "en": "A bookshelf crashes down as you pass, scattering bats and pages."
    },
    "ev_library_shelf_collapse_v3.title": {
      "en": "Knocked Over"
    },
    "ev_library_shelf_collapse_v3.desc": {
      "en": "Another shelf has fallen, as if a patrol pushed it on purpose."
    },
    "ev_crypt_ten_year_candle.title": {
      "en": "The Ten-Year Candle"
    },
    "ev_crypt_ten_year_candle.desc": {
      "en": "A candle in the crypt that someone has kept lit for ten years."
    },
    "ev_crypt_ten_year_candle.text": {
      "en": "A candle burns in a niche. By the wax, someone has kept it lit for ten years."
    },
    "ev_crypt_ten_year_candle_v4.title": {
      "en": "The Snuffed Candle"
    },
    "ev_crypt_ten_year_candle_v4.desc": {
      "en": "The ten-year candle's twin, put out only today."
    },
    "ev_crypt_ten_year_candle_v4.text": {
      "en": "A second candle, the twin of the first. Its wick is still warm: someone put it out today."
    },
    "ev_crypt_nameless_brick.title": {
      "en": "The Nameless Brick"
    },
    "ev_crypt_nameless_brick.desc": {
      "en": "A grave brick with no name whispers the name it lost."
    },
    "ev_crypt_nameless_brick.text": {
      "en": "The brick has no name carved on it. Up close, it whispers one."
    },
    "ev_crypt_nameless_brick_v2.title": {
      "en": "Another Blank Brick"
    },
    "ev_crypt_nameless_brick_v2.desc": {
      "en": "Another nameless brick asks you to remember it."
    },
    "ev_crypt_nameless_brick_v2.text": {
      "en": "\"Remember me,\" murmurs another blank brick. \"Nobody else is going to.\""
    },
    "ev_crypt_nameless_brick_v4.title": {
      "en": "The Brick That Counts"
    },
    "ev_crypt_nameless_brick_v4.desc": {
      "en": "A nameless brick counts everyone who passes it."
    },
    "ev_crypt_nameless_brick_v4.text": {
      "en": "The brick is counting under its breath. When you pass, it says the next number."
    },
    "ev_crypt_choir_echo.title": {
      "en": "The Choir's Echo"
    },
    "ev_crypt_choir_echo.desc": {
      "en": "An echo of the wraith choir drifts through the crypt."
    },
    "ev_crypt_choir_echo.text": {
      "en": "Far off, voices rise in a hymn. Every note is a little out of tune, on purpose."
    },
    "ev_crypt_choir_echo_v2.title": {
      "en": "The Missing Voice"
    },
    "ev_crypt_choir_echo_v2.desc": {
      "en": "The choir's echo has one voice missing."
    },
    "ev_crypt_choir_echo_v2.text": {
      "en": "The hymn again. One voice is missing, and the others leave a gap where it should be."
    },
    "ev_crypt_choir_echo_v3.title": {
      "en": "The Lullaby"
    },
    "ev_crypt_choir_echo_v3.desc": {
      "en": "The choir's echo sings a lullaby instead of a hymn."
    },
    "ev_crypt_choir_echo_v3.text": {
      "en": "This time the choir sings a lullaby. Somehow that is worse."
    },
    "ev_crypt_choir_echo_v4.title": {
      "en": "The Choir Calls You"
    },
    "ev_crypt_choir_echo_v4.desc": {
      "en": "The choir's echo sings your name in the refrain."
    },
    "ev_crypt_choir_echo_v4.text": {
      "en": "In the refrain, very softly, the choir sings your name."
    },
    "ev_cavern_twin_crystal.title": {
      "en": "The Twin Crystal"
    },
    "ev_cavern_twin_crystal.desc": {
      "en": "Two crystals grown from one stem, each humming a different note."
    },
    "ev_cavern_twin_crystal.text": {
      "en": "Two crystals grow from one stem. Each hums a different note; together they almost sound like words."
    },
    "ev_cavern_twin_crystal_v3.title": {
      "en": "The Cracked Twin"
    },
    "ev_cavern_twin_crystal_v3.desc": {
      "en": "One of a pair of twin crystals has cracked; the other still glows."
    },
    "ev_cavern_twin_crystal_v3.text": {
      "en": "Two crystals again: one cracked down the middle, one still glowing as if nothing happened."
    },
    "ev_cavern_twin_crystal_v4.title": {
      "en": "Crystal Reflection"
    },
    "ev_cavern_twin_crystal_v4.desc": {
      "en": "A twin crystal shows two reflections of you, not quite alike."
    },
    "ev_cavern_twin_crystal_v4.text": {
      "en": "In the crystal you see yourself twice. The second one moves a moment late."
    },
    "ev_cavern_echo_wall.title": {
      "en": "The Echo Wall"
    },
    "ev_cavern_echo_wall.desc": {
      "en": "A cavern wall that answers back in someone else's voice."
    },
    "ev_cavern_echo_wall.text": {
      "en": "You call out. The wall answers, but not in your voice."
    },
    "ev_cavern_echo_wall_v2.title": {
      "en": "The Echo Asks"
    },
    "ev_cavern_echo_wall_v2.desc": {
      "en": "The echo wall asks a question before you speak."
    },
    "ev_cavern_echo_wall_v2.text": {
      "en": "Before you can say anything, the wall asks: \"Which of you is the real one?\""
    },
    "ev_cavern_echo_wall_v4.title": {
      "en": "The Echo Lies"
    },
    "ev_cavern_echo_wall_v4.desc": {
      "en": "The echo wall repeats what you said, changed."
    },
    "ev_cavern_echo_wall_v4.text": {
      "en": "The wall repeats your words back, but changes one of them. You cannot tell which."
    },
    "ev_cavern_miner_cache.title": {
      "en": "The Miner's Cache"
    },
    "ev_cavern_miner_cache.desc": {
      "en": "Supplies left by a miner who never came back."
    },
    "ev_cavern_miner_cache.text": {
      "en": "Behind a stack of ore, a miner's pack: tools, rope, a little food. Whoever left it meant to return."
    },
    "ev_cavern_miner_cache_v2.title": {
      "en": "Lamp Oil"
    },
    "ev_cavern_miner_cache_v2.desc": {
      "en": "A miner's cache with lamp oil and a note: for whoever needs it."
    },
    "ev_cavern_miner_cache_v2.text": {
      "en": "A jar of lamp oil, and a note in a rough hand: \"For whoever needs it more than I do.\""
    },
    "ev_cavern_miner_cache_v3.title": {
      "en": "The Pick Marks"
    },
    "ev_cavern_miner_cache_v3.desc": {
      "en": "Pick marks in the rock point to a hidden cache."
    },
    "ev_cavern_miner_cache_v3.text": {
      "en": "Pick marks in the rock make a little arrow. It points to a hollow, and a cache inside."
    },
    "ev_cavern_miner_cache_v4.title": {
      "en": "The Last Shift"
    },
    "ev_cavern_miner_cache_v4.desc": {
      "en": "A miner's lunch box, packed for a shift that never ended."
    },
    "ev_cavern_miner_cache_v4.text": {
      "en": "A lunch box, still shut, packed for a shift that never ended. There is more than food inside."
    },
    "ev_barracks_night_fire_v2.title": {
      "en": "Smoke in the Barracks"
    },
    "ev_barracks_night_fire_v2.desc": {
      "en": "A soldier trapped by the night fire calls for help."
    },
    "ev_barracks_night_fire_v2.text": {
      "en": "Smoke fills the bunk room. Someone is coughing under a fallen beam: \"Here! Over here!\""
    },
    "ev_barracks_night_fire_v4.title": {
      "en": "Two at a Time"
    },
    "ev_barracks_night_fire_v4.desc": {
      "en": "A soldier pulling survivors out of the night fire asks for your help."
    },
    "ev_barracks_night_fire_v4.text": {
      "en": "A soldier is dragging people out of the fire one by one. \"Take that one. I can't carry both.\""
    },
    "ev_barracks_forge_t3.title": {
      "en": "The Third Forge"
    },
    "ev_barracks_forge_t3.desc": {
      "en": "A cold forge with good steel still in its racks."
    },
    "ev_barracks_forge_t3.text": {
      "en": "The third forge is cold, but the racks still hold good steel. Nobody will miss it now."
    },
    "ev_barracks_forge_t3_v3.title": {
      "en": "The Quenching Trough"
    },
    "ev_barracks_forge_t3_v3.desc": {
      "en": "Something was dropped in the forge's quenching trough and left there."
    },
    "ev_barracks_forge_t3_v3.text": {
      "en": "At the bottom of the quenching trough, under black water, something was dropped and never fished out."
    },
    "ev_barracks_forge_t3_v4.title": {
      "en": "The Armourer's Chest"
    },
    "ev_barracks_forge_t3_v4.desc": {
      "en": "The armourer's chest is locked, but its hinges are not."
    },
    "ev_barracks_forge_t3_v4.text": {
      "en": "The armourer locked the chest and forgot about the hinges. Inside, the good stuff."
    },
    "ev_barracks_deserter.title": {
      "en": "The Deserter"
    },
    "ev_barracks_deserter.desc": {
      "en": "A deserter trades army supplies for your silence."
    },
    "ev_barracks_deserter.text": {
      "en": "\"You didn't see me,\" the deserter says, opening a sack of army supplies. \"And I'll make it worth your while.\""
    },
    "ev_barracks_deserter_v2.title": {
      "en": "The Deserter's Price"
    },
    "ev_barracks_deserter_v2.desc": {
      "en": "The deserter is back, and the prices have gone up."
    },
    "ev_barracks_deserter_v2.text": {
      "en": "The deserter again. \"Prices went up. So did the risk.\""
    },
    "ev_barracks_deserter_v4.title": {
      "en": "The Captain's Goods"
    },
    "ev_barracks_deserter_v4.desc": {
      "en": "The deserter sells goods taken from the traitor captain."
    },
    "ev_barracks_deserter_v4.text": {
      "en": "\"The captain's own stock,\" the deserter grins. \"Won't be needed where that one is going.\""
    },
    "ev_sanctum_seventh_bell.title": {
      "en": "The Seventh Bell"
    },
    "ev_sanctum_seventh_bell.desc": {
      "en": "The seventh bell of the sanctum, cracked and silent."
    },
    "ev_sanctum_seventh_bell.text": {
      "en": "Six bells hang in a row, and a seventh lies on the floor, cracked. It still feels warm."
    },
    "ev_sanctum_seventh_bell_v3.title": {
      "en": "The Bell's Clapper"
    },
    "ev_sanctum_seventh_bell_v3.desc": {
      "en": "The seventh bell's clapper, wrapped in cloth so it would never ring."
    },
    "ev_sanctum_seventh_bell_v3.text": {
      "en": "The seventh bell's clapper, wrapped tight in cloth. Someone made sure it would never ring again."
    },
    "ev_sanctum_seventh_bell_v4.title": {
      "en": "The Bell Rope"
    },
    "ev_sanctum_seventh_bell_v4.desc": {
      "en": "A bell rope with a knot for every year the seventh bell was silent."
    },
    "ev_sanctum_seventh_bell_v4.text": {
      "en": "A bell rope, tied in knots: one knot for every year the seventh bell stayed silent. You stop counting at forty."
    },
    "ev_sanctum_warden_oath_v2.title": {
      "en": "The Warden's Oath"
    },
    "ev_sanctum_warden_oath_v2.desc": {
      "en": "A whisper repeats the bell warden's oath."
    },
    "ev_sanctum_warden_oath_v2.text": {
      "en": "\"Nothing rings unless I say so,\" the whisper recites. \"Nothing leaves unless I say so.\""
    },
    "ev_sanctum_warden_oath_v3.title": {
      "en": "The Oath Broken"
    },
    "ev_sanctum_warden_oath_v3.desc": {
      "en": "The whisper admits the warden broke the oath once."
    },
    "ev_sanctum_warden_oath_v3.text": {
      "en": "\"Once,\" the whisper says, \"I let one bell ring. Only once. Look what came of it.\""
    },
    "ev_sanctum_warden_oath_v4.title": {
      "en": "The Oath Passed On"
    },
    "ev_sanctum_warden_oath_v4.desc": {
      "en": "The warden's whisper asks you to take up the oath."
    },
    "ev_sanctum_warden_oath_v4.text": {
      "en": "\"Someone has to keep the oath after me,\" the whisper says. It sounds as if it is looking at you."
    },
    "ev_sanctum_crack_prayer_v2.title": {
      "en": "Prayer in the Crack"
    },
    "ev_sanctum_crack_prayer_v2.desc": {
      "en": "A prayer whispered into a crack in the sanctum wall."
    },
    "ev_sanctum_crack_prayer_v2.text": {
      "en": "Someone pushed a prayer into a crack in the wall, folded small. It is still whispering."
    },
    "ev_sanctum_crack_prayer_v4.title": {
      "en": "The Answered Prayer"
    },
    "ev_sanctum_crack_prayer_v4.desc": {
      "en": "From the crack, a voice answers a prayer that was never finished."
    },
    "ev_sanctum_crack_prayer_v4.text": {
      "en": "From the crack comes an answer to a prayer no one finished: \"Yes. But not like this.\""
    },
    "ev_antechamber_mirror_self.title": {
      "en": "The Mirror"
    },
    "ev_antechamber_mirror_self.desc": {
      "en": "A mirror in the antechamber that shows you as you were."
    },
    "ev_antechamber_mirror_self.text": {
      "en": "The mirror shows you as you were when you first came to the tower. That face looks at you as if asking something."
    },
    "ev_antechamber_mirror_self_v2.title": {
      "en": "The Smiling Reflection"
    },
    "ev_antechamber_mirror_self_v2.desc": {
      "en": "Your reflection smiles when you don't."
    },
    "ev_antechamber_mirror_self_v2.text": {
      "en": "Your reflection smiles. You did not."
    },
    "ev_antechamber_mirror_self_v3.title": {
      "en": "The Reflection Speaks"
    },
    "ev_antechamber_mirror_self_v3.desc": {
      "en": "Your reflection says the thing you have avoided saying."
    },
    "ev_antechamber_mirror_self_v3.text": {
      "en": "\"You already know how this ends,\" your reflection says. \"You just won't say it.\""
    },
    "ev_antechamber_mirror_self_v4.title": {
      "en": "The Empty Mirror"
    },
    "ev_antechamber_mirror_self_v4.desc": {
      "en": "A mirror that shows the room, but not you."
    },
    "ev_antechamber_mirror_self_v4.text": {
      "en": "The mirror shows the antechamber perfectly. You are not in it."
    },
    "ev_antechamber_old_sword_rack.title": {
      "en": "The Old Sword Rack"
    },
    "ev_antechamber_old_sword_rack.desc": {
      "en": "A rack of old swords; one of them is still sharp."
    },
    "ev_antechamber_old_sword_rack.text": {
      "en": "An old rack of swords, all rusted through, all but one, which someone keeps oiled."
    },
    "ev_antechamber_old_sword_rack_v2.title": {
      "en": "The Teacher's Sword"
    },
    "ev_antechamber_old_sword_rack_v2.desc": {
      "en": "A sword on the rack bears your teacher's mark."
    },
    "ev_antechamber_old_sword_rack_v2.text": {
      "en": "On the rack, a sword with your teacher's mark on the guard. Under it, a small bundle of supplies."
    },
    "ev_antechamber_old_sword_rack_v3.title": {
      "en": "The Empty Slot"
    },
    "ev_antechamber_old_sword_rack_v3.desc": {
      "en": "One slot in the sword rack is empty, with supplies left in its place."
    },
    "ev_antechamber_old_sword_rack_v3.text": {
      "en": "One slot in the rack is empty. Someone left supplies there instead, as if to say sorry."
    },
    "ev_antechamber_liora_voice.title": {
      "en": "Liora's Voice"
    },
    "ev_antechamber_liora_voice.desc": {
      "en": "Princess Liora's voice, faint, from beyond the door."
    },
    "ev_antechamber_liora_voice.text": {
      "en": "Through the door, faintly: \"Is someone there? Please, keep climbing.\""
    },
    "ev_antechamber_liora_voice_v2.title": {
      "en": "Liora Remembers"
    },
    "ev_antechamber_liora_voice_v2.desc": {
      "en": "Liora's voice recalls something only you would know."
    },
    "ev_antechamber_liora_voice_v2.text": {
      "en": "\"You used to hum when you were nervous,\" Liora's voice says. \"You're humming now.\""
    },
    "ev_antechamber_liora_voice_v3.title": {
      "en": "Liora's Warning"
    },
    "ev_antechamber_liora_voice_v3.desc": {
      "en": "Liora's voice warns you about what waits at the top."
    },
    "ev_antechamber_liora_voice_v3.text": {
      "en": "\"What waits at the top wears a face you know,\" Liora's voice whispers. \"Don't trust it.\""
    },
    "ev_peak_bone_field.title": {
      "en": "The Bone Field"
    },
    "ev_peak_bone_field.desc": {
      "en": "A field of bones below the peak, from everyone who came before."
    },
    "ev_peak_bone_field.text": {
      "en": "The ground near the peak is white with bones. Every climber who came before you stopped here."
    },
    "ev_peak_bone_field_v2.title": {
      "en": "The Bone with a Name"
    },
    "ev_peak_bone_field_v2.desc": {
      "en": "A bone in the field has a name scratched into it."
    },
    "ev_peak_bone_field_v2.text": {
      "en": "One bone has a name scratched into it, in a hand you almost recognise."
    },
    "ev_peak_bone_field_v3.title": {
      "en": "The Bone Ring"
    },
    "ev_peak_bone_field_v3.desc": {
      "en": "Bones laid in a ring around a single sword."
    },
    "ev_peak_bone_field_v3.text": {
      "en": "Someone laid the bones in a ring around a single sword, point down. A grave, or a warning."
    },
    "ev_peak_bone_field_v4.title": {
      "en": "The Fresh Bones"
    },
    "ev_peak_bone_field_v4.desc": {
      "en": "Among the old bones, some are new."
    },
    "ev_peak_bone_field_v4.text": {
      "en": "Most of the bones are old. A few are not."
    },
    "ev_peak_star_crack.title": {
      "en": "The Star Crack"
    },
    "ev_peak_star_crack.desc": {
      "en": "A crack in the sky above the peak, with stars that should not be there."
    },
    "ev_peak_star_crack.text": {
      "en": "Above the peak the sky is cracked. Through the crack shine stars that do not belong to this world."
    },
    "ev_peak_star_crack_v3.title": {
      "en": "The Star Speaks"
    },
    "ev_peak_star_crack_v3.desc": {
      "en": "A star through the crack whispers about the demon lord."
    },
    "ev_peak_star_crack_v3.text": {
      "en": "\"It came through here,\" a star whispers through the crack. \"It will try to leave the same way.\""
    },
    "ev_peak_star_crack_v4.title": {
      "en": "The Crack Widens"
    },
    "ev_peak_star_crack_v4.desc": {
      "en": "The crack in the sky is wider than it was."
    },
    "ev_peak_star_crack_v4.text": {
      "en": "The crack is wider than when you last looked up. Something on the other side is pushing."
    },
    "ev_peak_wushang_memory.title": {
      "en": "Wushang's Memory"
    },
    "ev_peak_wushang_memory.desc": {
      "en": "A memory of Wushang, the last to reach the peak."
    },
    "ev_peak_wushang_memory.text": {
      "en": "A memory rises: Wushang at the peak, sword raised, turning back once to look down."
    },
    "ev_peak_wushang_memory_v2.title": {
      "en": "Wushang's Choice"
    },
    "ev_peak_wushang_memory_v2.desc": {
      "en": "A memory of the moment Wushang made a choice at the peak."
    },
    "ev_peak_wushang_memory_v2.text": {
      "en": "In the memory, Wushang lowers the sword. \"Not like this.\" What came next, the memory does not show."
    },
    "ev_peak_wushang_memory_v3.title": {
      "en": "Wushang's Wound"
    },
    "ev_peak_wushang_memory_v3.desc": {
