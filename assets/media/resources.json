{
  "version": 1,
  "about": [
    "Every file the game reads, by key (docs/engine/12_RESOURCE_MANAGER.md). Code names a key (src/core/game/core/res_keys.h,",
    "made from this file by tools/make_res_keys.py), never a path: move a file and only its path here changes.",
    "Paths are relative to this file (assets/media); ../data/ is the game data. preload: loaded at startup.",
    "Types: texture, atlas, anim, particle, font, json (loaded by the resource cache); file (read by something else: an",
    "RmlUi document, a data file with its own loader); folder (read file by file). optional: the file may not be there (an editor makes it when first needed).",
    "patterns: families of files, one per id ({id}); code asks pathFor(pattern, id).",
    "After adding or removing a key: python tools/make_res_keys.py (unit.res_keys_test fails until then)."
  ],
  "resources": {
    "atlas.game":          { "type": "atlas",    "path": "atlas/game.atlas" },
    "atlas.fx":            { "type": "atlas",    "path": "atlas/fx.atlas", "preload": true },
    "anim.monster_idle":   { "type": "anim",     "path": "anim/monster_idle.anim", "preload": true },
    "anim.npc_idle":       { "type": "anim",     "path": "anim/npc_idle.anim", "preload": true },
    "anim.door_open":      { "type": "anim",     "path": "anim/door_open.anim", "preload": true },
    "anim.monster_battle": { "type": "anim",     "path": "anim/monster_battle.anim" },
    "fx.battle":           { "type": "particle", "path": "fx/battle.particle" },
    "styles.index":        { "type": "json",     "path": "styles/styles.json" },
    "folder.sfx":          { "type": "folder",   "path": "sfx" },

    "ui.hud":              { "type": "file",     "path": "ui/hud.rml" },
    "ui.battle":           { "type": "file",     "path": "ui/battle.rml" },
    "ui.dialogue":         { "type": "file",     "path": "ui/dialogue.rml" },
    "ui.store":            { "type": "file",     "path": "ui/store.rml" },
    "ui.stage_select":     { "type": "file",     "path": "ui/stage_select.rml" },
    "ui.player":           { "type": "file",     "path": "ui/player.rml" },
    "ui.saveload":         { "type": "file",     "path": "ui/saveload.rml" },
    "ui.dialogs":          { "type": "file",     "path": "ui/dialogs.rml" },
    "ui.title":            { "type": "file",     "path": "ui/title.rml" },
    "ui.ending":           { "type": "file",     "path": "ui/ending.rml" },
    "ui.minigame":         { "type": "file",     "path": "ui/minigame.rml" },
    "ui.overlay":          { "type": "file",     "path": "ui/overlay.rml" },

    "data.text":           { "type": "json",     "path": "../data/text.json" },
    "data.items":          { "type": "json",     "path": "../data/items.json" },
    "data.enemies":        { "type": "json",     "path": "../data/enemies.json" },
    "data.stats":          { "type": "json",     "path": "../data/stats.json" },
    "data.battle":         { "type": "json",     "path": "../data/battle.json" },
    "data.weapon_play":    { "type": "json",     "path": "../data/weapon_play.json" },
    "data.minigames":      { "type": "json",     "path": "../data/minigames.json" },
    "data.character_fit":  { "type": "json",     "path": "../data/character_fit.json" },
    "data.footprints":     { "type": "json",     "path": "../data/footprints.json" },
    "data.store":          { "type": "json",     "path": "../data/store.json" },
    "data.missions":       { "type": "json",     "path": "../data/missions.json" },
    "data.skills":         { "type": "json",     "path": "../data/skills.json" },
    "data.forge":          { "type": "json",     "path": "../data/forge.json" },
    "data.hub":            { "type": "json",     "path": "../data/hub.json" },
    "data.actives":        { "type": "json",     "path": "../data/actives.json" },
    "data.story.counters": { "type": "json",     "path": "../data/story/counters.json" },
    "data.story.endings":  { "type": "json",     "path": "../data/story/endings.json" },
    "data.story.cycles":   { "type": "json",     "path": "../data/story/cycles.json" },
    "data.story.vars":     { "type": "json",     "path": "../data/story/vars.json" },
    "data.event_kinds":    { "type": "json",     "path": "../data/events/kinds.json", "optional": true },

    "folder.assets":       { "type": "folder",   "path": ".." },
    "folder.events":       { "type": "folder",   "path": "../data/events" },
    "folder.npcs":         { "type": "folder",   "path": "../data/npcs" },
    "folder.floors":       { "type": "folder",   "path": "../data/story/floors" },
    "folder.chapters":     { "type": "folder",   "path": "../data/story/chapters" },
    "folder.stages":       { "type": "folder",   "path": "../data/stages" }
  },
  "patterns": {
    "stage":       "../data/stages/{id}.json",
    "floor_stage": "../data/story/floors/{id}.stage.json",
    "dialogue":    "../data/dialogue/{id}.json",
    "chapter":     "../data/story/chapters/{id}.json",
    "style_atlas": "styles/{id}/atlas/game.atlas"
  }
}
