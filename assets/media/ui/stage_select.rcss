/* stage_select.rcss -- the floor list (stage_select.rml). */
body { z-index: 45; }

#panel { position: absolute; left: 60px; top: 50px; right: 60px; bottom: 50px; padding: 18px 24px; }
#title { font-size: 30px; color: #f9e9b1; }
#hint  { margin-top: 4px; font-size: 17px; color: #cad0e1; }
#list  { position: absolute; left: 24px; right: 24px; top: 96px; bottom: 76px; overflow-y: auto; }
.row   { margin: 0 8px 8px 0; padding: 8px 14px; }
.label { font-size: 21px; color: #ffffff; }
.row.disabled .label { color: #a9adbd; }
.sub   { margin-top: 2px; font-size: 16px; color: #cad0e1; }
#close { position: absolute; right: 24px; bottom: 18px; width: 140px; height: 44px; line-height: 44px; font-size: 19px; }
