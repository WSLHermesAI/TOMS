<rml>
<head>
    <title>Pad</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="pad.rcss"/>
</head>
<!-- The on-screen gamepad (touch / mouse): hold an arrow to keep walking, A = interact,
     P = show/hide the pad. Data: pad.* (UiPad). -->
<body data-model="game">
    <div id="toggle" class="key" data-event-click="act('pad_toggle')">P</div>
    <div data-if="pad.on">
        <div id="dpad" data-style-transform="'scale(' + pad.scale + ')'">
            <div id="up"    class="key dir" data-event-mousedown="act('pad_dir', 0)" data-event-mouseup="act('pad_release')" data-event-mouseout="act('pad_release')">^</div>
            <div id="down"  class="key dir" data-event-mousedown="act('pad_dir', 1)" data-event-mouseup="act('pad_release')" data-event-mouseout="act('pad_release')">v</div>
            <div id="left"  class="key dir" data-event-mousedown="act('pad_dir', 2)" data-event-mouseup="act('pad_release')" data-event-mouseout="act('pad_release')">&lt;</div>
            <div id="right" class="key dir" data-event-mousedown="act('pad_dir', 3)" data-event-mouseup="act('pad_release')" data-event-mouseout="act('pad_release')">&gt;</div>
        </div>
        <div id="a" class="key" data-style-transform="'scale(' + pad.scale + ')'" data-event-click="act('pad_a')">A</div>
    </div>
</body>
</rml>
