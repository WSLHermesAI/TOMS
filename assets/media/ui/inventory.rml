<rml>
<head>
    <title>Inventory</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="inventory.rcss"/>
</head>
<!-- The backpack: item list on the left (click to select), the selected item's details and
     Use / Drop / Close on the right. Data: inventory.* (UiInventory). -->
<body data-model="game">
    <div class="fill focus"></div>
    <div id="panel">
        <div id="bar">
            <div id="title">{{inventory.title}}</div>
            <div id="hint">{{inventory.hint}}</div>
        </div>

        <div id="empty" data-if="inventory.empty">
            <div id="empty-title">{{inventory.empty_title}}</div>
            <div id="empty-hint">{{inventory.empty_hint}}</div>
            <div id="empty-close" class="btn btn-no" data-event-click="act('inv_close')">{{inventory.close_label}}</div>
        </div>

        <div data-if="!inventory.empty">
            <div id="list">
                <div data-for="it, i : inventory.items">
                    <div class="item" data-class-selected="it.selected" data-event-click="act('inv_select', i)">
                        <img class="item-icon" data-attr-src="it.icon"/>
                        <div class="item-name">{{it.name}}</div>
                        <div class="item-effect">{{it.effect}}</div>
                        <div class="item-count">x1</div>
                    </div>
                </div>
            </div>
            <div id="detail">
                <div id="d-title">{{inventory.detail_title}}</div>
                <img id="d-icon" data-attr-src="inventory.d_icon"/>
                <div id="d-name">{{inventory.d_name}}</div>
                <div id="d-id">{{inventory.d_id}}</div>
                <div id="d-file">{{inventory.icon_label}}: {{inventory.d_icon_file}}</div>
                <div id="d-desc">{{inventory.d_desc}}</div>
                <div id="d-stats">{{inventory.stats_label}}</div>
                <div id="pills"><div class="pill" data-for="p : inventory.d_pills">{{p}}</div></div>
                <div id="footer-hint">{{inventory.footer_hint}}</div>
                <div id="buttons">
                    <div class="btn btn-yes" data-event-click="act('inv_use')">{{inventory.use_label}}</div>
                    <div class="btn drop" data-event-click="act('inv_drop')">{{inventory.drop_label}}</div>
                    <div class="btn btn-plain close" data-event-click="act('inv_close')">{{inventory.close_label}}</div>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
