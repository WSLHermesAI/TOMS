/* store.rcss -- the item store (store.rml). */

body { z-index: 40; }

/* Full-screen dim behind the panel (the old store's 50% black splash). Clicking it closes. */
#backdrop {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: #00000080;
}

#panel {
    position: absolute; left: 40px; top: 40px; right: 40px; bottom: 40px;
    background-color: #505a6ff5;
    border: 2px #8291af;
    border-radius: 14px;
}

#header { position: absolute; left: 20px; right: 20px; top: 16px; height: 40px; }
#title  { position: absolute; left: 0; top: 0; font-size: 28px; color: #fff3ba; }
#gold   { position: absolute; right: 120px; top: 8px; font-size: 20px; color: #fff9a8; }
.gold   { color: #ffe984; }
#hint   { position: absolute; left: 20px; top: 58px; font-size: 14px; color: #e6edffe6; }

#close {
    position: absolute; right: 0; top: 2px; width: 90px; height: 34px; line-height: 34px;
    background-color: #ba7b7b; color: #ffffff;
}
#close:hover { background-color: #ce8888; }

#tabs { position: absolute; left: 20px; top: 84px; height: 34px; }
.tab-slot { float: left; }
.tab { width: 100px; height: 34px; line-height: 34px; margin-right: 12px;
    font-size: 17px; background-color: #65697be6; color: #e6e9f3;
}
.tab:hover  { background-color: #737b97; }
.tab.active { background-color: #8593af; color: #fff9ca; }

/* The cards: a centred row of 300x300 cards, like storeCardRects(). */
#cards {
    position: absolute; left: 0; right: 0; top: 174px; height: 300px;
    display: flex; justify-content: center;
}
.card-slot { flex: 0 0 auto; margin: 0 8px; }
.card {
    position: relative; box-sizing: border-box;
    width: 290px; height: 300px;
    background-color: #697085f5;
    border: 3px #00000000;
    border-radius: 10px;
    transition: background-color 0.12s;
}
.card.selected { background-color: #808aa5; border-color: #ffed7b; }

.icon   { display: block; width: 80px; height: 80px; margin: 10px auto 0 auto; }
.name   { margin: 6px 14px 0 14px; font-size: 24px; color: #ffffff; }
.desc   { margin: 4px 14px 0 14px; font-size: 15px; color: #edf3ff; height: 20px; white-space: nowrap; overflow: hidden; }
.effect { margin: 4px 14px 0 14px; font-size: 15px; line-height: 19px;   /* may wrap to 2 lines */
          color: #caffd9; }
.status { margin: 2px 14px 0 14px; font-size: 14px; color: #d9d9e6; }
.status.equipped { color: #baffca; }
.price  { margin: 2px 14px 0 14px; font-size: 20px; color: #fff9a8; }

.buy {
    position: absolute; left: 14px; right: 14px; bottom: 10px; height: 36px; line-height: 36px;
    font-size: 16px; background-color: #7bba93; color: #ffffff;
    transition: background-color 0.12s;
}
.buy:hover  { background-color: #88cea4; }
.buy:active { background-color: #6dac85; }
