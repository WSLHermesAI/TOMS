/* battle.rcss -- the battle screen (battle.rml). Laid out 1.4x larger than the map UI so it
   reads well on phones (the old screen's "battle scale").

   Landscape and portrait (docs/gameplay/12_UI_LAYOUT.md; the owner 2026-10-25). The canvas's short side is always
   768 px and the long side follows the screen (canvas.h), so:
   - landscape: one 700 px block, its left edge 250 px left of the centre (on the 1024 canvas: x 262, as it always was);
     a wider screen keeps it in the middle;
   - portrait: full-width rows, 40 px from the edges; the fighters at the top, the controls anchored to the bottom (for
     thumbs). A tall phone (16:9 and longer, the canvas 1300+ high) stacks the monster above the player; a shorter
     portrait screen keeps them side by side.
   The game draws the animated fighters in #player / .foe .fbox and reads where they are (GameUi::sync), so these rules
   are the only place a fighter's position is written.
   One to three monsters (.foe; docs/gameplay/13 §4.6): .n1/.n2/.n3 is how many, .f1/.f2 which one. One monster is
   placed as the single monster always was. */
body { z-index: 30; }

#title  { position: absolute; left: 50%; margin-left: -250px; top: 14px; font-size: 38px; color: #ffcaa8; }
.fighter { position: absolute; top: 84px; width: 134px; height: 134px; }
.fighter img { width: 100%; height: 100%; }
#player { left: 50%; margin-left: -250px; }

.hp      { position: absolute; top: 238px; width: 280px; height: 22px; background-color: #7b7b88; }
#player-hp { left: 50%; margin-left: -250px; }
.fill-bar { height: 100%; }
.fill-bar.good  { background-color: #94f3a8; }
.fill-bar.bad   { background-color: #f39494; }
.fill-bar.clock { background-color: #edb17b; }
.fill-bar.clock.stamina { background-color: #8fd8a0; }   /* the stamina pace (docs/gameplay/13 §6.3) */
.hp-text { position: absolute; top: 262px; font-size: 22px; color: #ffffff; white-space: nowrap; }
#player-hp-text { left: 50%; margin-left: -250px; }

/* the monsters: each a slot with its next move over its box, the target mark under it, its HP bar (with its break gauge) and text */
.foe      { position: absolute; left: 50%; margin-left: 140px; top: 84px; width: 280px; height: 200px; }
.foe.down { opacity: 0.45; }
.fbox     { position: absolute; left: 0; top: 0; width: 134px; height: 134px; }
.fbox img { width: 100%; height: 100%; }
.mark     { position: absolute; left: 0; bottom: -12px; width: 100%; height: 6px; background-color: #ffe27a; }   /* under its box */
.fhp      { position: absolute; left: 0; top: 154px; width: 280px; height: 22px; background-color: #7b7b88; }
.ftext    { position: absolute; left: 0; top: 178px; width: 280px; font-size: 22px; color: #ffffff; white-space: nowrap; overflow: hidden; }
/* its break gauge, along the bottom of its HP bar (docs/gameplay/13 §6.4) */
.fbreak   { position: absolute; left: 0; bottom: 0; height: 5px; background-color: #ffe27a; }
/* its next move over its box (§6.1): the words and how far its wind-up is; the colour says what answers it */
.intent   { position: absolute; left: 0; top: -24px; width: 100%; height: 22px; }
.itext    { font-size: 16px; line-height: 18px; color: #f3e0ba; white-space: nowrap; overflow: hidden; }
.ibar     { position: absolute; left: 0; bottom: 0; width: 100%; height: 3px; background-color: #41414c; }
.ifill    { height: 100%; background-color: #edb17b; }
.intent.heavy .itext { color: #ff9a7a; }    .intent.heavy .ifill { background-color: #ff7a5a; }   /* parry it */
.intent.jabs .itext { color: #ffd27a; }     .intent.jabs .ifill { background-color: #ffc04a; }    /* guard, do not attack */
.intent.spell .itext { color: #c7a2ff; }    .intent.spell .ifill { background-color: #a77aff; }   /* break it with a combo */
.intent.guard .itext { color: #9fd8ff; }    .intent.guard .ifill { background-color: #6fb8ff; }   /* a full charge breaks it */
.intent.stagger .itext, .intent.broken .itext { color: #ffe27a; }
/* one monster: "Slime HP 24" on one line; two or three: the name, and the HP under it (narrow slots) */
.ftext.two { display: none; }
.foe.n2 .ftext.one, .foe.n3 .ftext.one { display: none; }
.foe.n2 .ftext.two, .foe.n3 .ftext.two { display: block; white-space: normal; }   /* a long name wraps too */
/* two or three share the 390 px right of the player's HP bar */
.foe.n2 { margin-left: 60px; width: 190px; }
.foe.n2.f1 { margin-left: 260px; }
.foe.n2 .fbox { width: 120px; }
.foe.n2 .fbox { height: 120px; }
.foe.n2 .fhp  { top: 136px; width: 190px; height: 18px; }
.foe.n2 .ftext { top: 158px; width: 190px; font-size: 18px; }
.foe.n3 { margin-left: 60px; width: 125px; }
.foe.n3.f1 { margin-left: 192px; }
.foe.n3.f2 { margin-left: 324px; }
.foe.n3 .fbox { width: 100px; }
.foe.n3 .fbox { height: 100px; }
.foe.n3 .fhp  { top: 114px; width: 125px; height: 16px; }
.foe.n3 .ftext { top: 134px; width: 125px; font-size: 16px; }

/* the message: two lines (a long one, or another language, wraps); everything below starts under them */
#log { position: absolute; left: 50%; margin-left: -250px; width: 738px; top: 294px; height: 56px; line-height: 28px; font-size: 22px; color: #ffffff; }
#continue { position: absolute; left: 50%; margin-left: -250px; top: 368px; font-size: 24px; color: #ffffca; }

#clock-label { position: absolute; left: 50%; margin-left: -250px; top: 352px; font-size: 19px; color: #f3e0ba; }
#clock { position: absolute; left: 50%; margin-left: -250px; top: 376px; width: 700px; height: 14px; background-color: #7b7b88; }

/* Attack / defence columns: prompt, the five-zone timing bar with its marker, the action button. */
.column { position: absolute; top: 400px; width: 322px; }
#attack  { left: 50%; margin-left: -250px; }
#defense { left: 50%; margin-left: 128px; }
.prompt  { font-size: 20px; color: #f3f3ff; height: 30px; }
.power   { position: relative; height: 28px; }
.zones   { display: flex; height: 100%; }
.zone        { height: 100%; }
.zone.red    { background-color: #e08888; }
.zone.blue   { background-color: #94b1ed; }
.zone.green  { background-color: #94e6a8; }
.bar-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #41414c8c; }
.marker  { position: absolute; top: -8px; width: 5px; height: 44px; margin-left: -2px; background-color: #ffffff; }
/* Battle v3's point play (docs/gameplay/07 phase 1): a charge column, then the track with its points */
.combo   { position: relative; height: 28px; }
.charge  { position: absolute; left: 0; top: -8px; width: 12px; height: 44px; background-color: #41414c; }
.charge-fill { position: absolute; left: 0; bottom: 0; width: 100%; background-color: #ffc861; }
.track   { position: absolute; left: 22px; right: 0; top: 0; height: 28px; background-color: #5b6275; }
.track.waiting { background-color: #6e4b52; }
.pt      { position: absolute; top: 4px; width: 20px; height: 20px; margin-left: -10px; border-radius: 10px;
           background-color: #94b1ed; }
.pt.hit  { background-color: #94e6a8; }
/* the marker is in its window: a tap now hits it (the hint, with a sound and a flash; the same window the tap uses) */
.pt.near { top: -2px; width: 32px; height: 32px; margin-left: -16px; border-radius: 16px;
           background-color: #ffe27a; border-width: 3px; border-color: #ffffff; }
.action {
    margin-top: 18px; height: 62px; line-height: 62px; font-size: 21px; color: #ffffff;
    background-color: #8598b3; text-align: left; padding-left: 18px;
}
.action:hover   { background-color: #97aac5; }
.action:active  { background-color: #a9bcd6; }
.action.cooling { background-color: #6f7580; }
.note        { margin-top: 8px; font-size: 19px; color: #cacfd9; }
.note.shield { color: #c2e0ff; }
.note.crit   { color: #ffed94; }

#super { position: absolute; left: 50%; margin-left: -250px; top: 578px; height: 24px; }   /* below the weapon level line (Battle v3) */
#super-label { font-size: 19px; color: #f3f3ff; margin-right: 18px; }
.dot-slot { display: inline-block; }
.dot { width: 17px; height: 17px; margin-right: 8px; background-color: #7b7b88; }
.dot.on { background-color: #ffca88; }

.wide { position: absolute; left: 50%; margin-left: -250px; width: 700px; height: 50px; line-height: 50px; font-size: 22px; color: #ffffff; }
#super-btn  { top: 610px; background-color: #d9887b; }
#super-btn:hover  { background-color: #e89a8d; }
#active-btn { top: 672px; background-color: #88c2d2; }
#active-btn:hover { background-color: #9ad2e2; }

/* damage numbers (UiPopup): a 100 px box over the fighter, rising and fading (placed from #player / .foe .fbox) */
.popup { position: absolute; width: 100px; text-align: center; font-size: 34px; color: #ffffff; font-effect: outline(2px #401010); }
.popup.big { font-size: 46px; color: #ffe066; }
.popup.guard { font-size: 28px; color: #9fd8ff; }

/* ---- portrait: rows across the 768 px width; the controls on the bottom, for thumbs ---- */
@media (orientation: portrait) {
    #title { left: 40px; margin-left: 0; top: 14px; font-size: 30px; }   /* clear of the monsters' intents */
    /* side by side (a short portrait screen; a tall phone stacks them below) */
    .fighter    { top: 80px; }
    #player     { left: 118px; margin-left: 0; }
    .hp         { top: 230px; width: 330px; }
    #player-hp  { left: 40px; margin-left: 0; }
    .hp-text    { top: 256px; }
    #player-hp-text { left: 40px; margin-left: 0; }
    /* the monsters: the right half, 330 px from x 398 */
    .foe.n1, .foe.n2, .foe.n3 { margin-left: 0; top: 80px; }
    .foe.n1 { left: 398px; width: 330px; }
    .foe.n1 .fbox { left: 118px; }
    .foe.n1 .fhp  { top: 150px; width: 330px; }
    .foe.n1 .ftext { top: 176px; width: 330px; }
    .foe.n2 { left: 398px; width: 160px; }
    .foe.n2.f1 { left: 568px; margin-left: 0; }
    .foe.n2 .fbox { left: 25px; }
    .foe.n2 .fhp  { top: 126px; width: 160px; }
    .foe.n2 .ftext { top: 146px; width: 160px; }
    .foe.n3 { left: 398px; width: 105px; }
    .foe.n3.f1 { left: 510px; margin-left: 0; }
    .foe.n3.f2 { left: 622px; margin-left: 0; }
    .foe.n3 .fbox { left: 7px; }
    .foe.n3 .fhp  { top: 104px; width: 105px; }
    .foe.n3 .ftext { top: 122px; width: 105px; }
    .foe.n3 .itext { font-size: 14px; }
    #log        { left: 40px; margin-left: 0; width: 688px; top: 294px; }
    #continue   { left: 40px; margin-left: 0; top: 370px; }

    /* the controls, from the bottom up */
    #clock-label { left: 40px; margin-left: 0; top: auto; bottom: 620px; }
    #clock       { left: 40px; margin-left: 0; width: 688px; top: auto; bottom: 600px; }
    .column      { left: 40px; margin-left: 0; width: 688px; top: auto; }
    #attack      { left: 40px; margin-left: 0; bottom: 390px; }
    #defense     { left: 40px; margin-left: 0; bottom: 200px; }
    #super       { left: 40px; margin-left: 0; top: auto; bottom: 160px; }
    .wide        { left: 40px; margin-left: 0; width: 688px; top: auto; }
    #super-btn   { top: auto; bottom: 92px; }
    #active-btn  { top: auto; bottom: 30px; }
}

/* a tall phone: the monster above, the player below it, each with its HP under it */
@media (orientation: portrait) and (min-height: 1300px) {
    .fighter    { width: 180px; height: 180px; }
    #player     { left: 294px; top: 352px; }
    .hp         { width: 688px; }
    /* the monsters across the width, 688 px from x 40 */
    .foe.n1, .foe.n2, .foe.n3 { top: 88px; }
    .foe.n1 { left: 40px; width: 688px; }
    .foe.n1 .fbox { left: 254px; width: 180px; }
    .foe.n1 .fbox { height: 180px; }
    .foe.n1 .fhp  { top: 192px; width: 688px; }
    .foe.n1 .ftext { top: 218px; width: 688px; }
    .foe.n2 { left: 40px; width: 334px; }
    .foe.n2.f1 { left: 394px; }
    .foe.n2 .fbox { left: 87px; width: 160px; }
    .foe.n2 .fbox { height: 160px; }
    .foe.n2 .fhp  { top: 172px; width: 334px; height: 22px; }
    .foe.n2 .ftext { top: 198px; width: 334px; font-size: 22px; }
    .foe.n3 { left: 40px; width: 220px; }
    .foe.n3.f1 { left: 274px; }
    .foe.n3.f2 { left: 508px; }
    .foe.n3 .fbox { left: 35px; width: 150px; }
    .foe.n3 .fbox { height: 150px; }
    .foe.n3 .fhp  { top: 162px; width: 220px; height: 20px; }
    .foe.n3 .ftext { top: 188px; width: 220px; font-size: 19px; }
    #player-hp  { left: 40px; top: 544px; }
    #player-hp-text { left: 40px; top: 570px; }
    #log        { top: 614px; }
    #continue   { top: 692px; }
}
