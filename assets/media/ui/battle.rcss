/* battle.rcss -- the battle screen (battle.rml). Laid out 1.4x larger than the map UI so it
   reads well on phones (the old screen's "battle scale").

   Landscape and portrait (docs/gameplay/12_UI_LAYOUT.md; the owner 2026-10-25). The canvas's short side is always
   768 px and the long side follows the screen (canvas.h), so:
   - landscape: one 700 px block, its left edge 250 px left of the centre (on the 1024 canvas: x 262, as it always was);
     a wider screen keeps it in the middle;
   - portrait: full-width rows, 40 px from the edges; the fighters at the top, the controls anchored to the bottom (for
     thumbs). A tall phone (16:9 and longer, the canvas 1300+ high) stacks the monster above the player; a shorter
     portrait screen keeps them side by side.
   The revamp (docs/gameplay/15_BATTLE_REVAMP.md §4): the play (#play) under the fighters, the two thumb panels (#guard,
   #attack-state) at the bottom, the banner and the result over everything.
   The game draws the animated fighters in #player / .foe .fbox and reads where they are (GameUi::sync), so these rules
   are the only place a fighter's position is written.
   One to three monsters (.foe; docs/gameplay/13 §4.6): .n1/.n2/.n3 is how many, .f1/.f2 which one. One monster is
   placed as the single monster always was. */
body { z-index: 30; }

#title  { position: absolute; left: 50%; margin-left: -250px; top: 14px; font-size: 38px; color: #ffcaa8; }
.fighter { position: absolute; top: 84px; width: 134px; height: 134px; }
.fighter img { width: 100%; height: 100%; }
#player { left: 50%; margin-left: -250px; }

.hp      { position: absolute; top: 238px; width: 280px; height: 22px; background-color: #7b7b88; }
#player-hp { left: 50%; margin-left: -250px; }
.fill-bar { height: 100%; }
.fill-bar.good  { background-color: #94f3a8; }
.fill-bar.bad   { background-color: #f39494; }
.fill-bar.clock { background-color: #edb17b; }
.fill-bar.clock.stamina { background-color: #8fd8a0; }   /* the stamina pace (docs/gameplay/13 §6.3) */
.hp-text { position: absolute; top: 262px; font-size: 22px; color: #ffffff; white-space: nowrap; }
#player-hp-text { left: 50%; margin-left: -250px; }

/* the monsters: each a slot with its next move over its box, the target mark under it, its HP bar (with its break gauge) and text */
.foe      { position: absolute; left: 50%; margin-left: 140px; top: 84px; width: 280px; height: 200px; }
.foe.down { opacity: 0.45; }
.fbox     { position: absolute; left: 0; top: 0; width: 134px; height: 134px; }
.fbox img { width: 100%; height: 100%; }
.fhp      { position: absolute; left: 0; top: 154px; width: 280px; height: 22px; background-color: #7b7b88; }
.ftext    { position: absolute; left: 0; top: 178px; width: 280px; font-size: 22px; color: #ffffff; white-space: nowrap; overflow: hidden; }
/* its break gauge, along the bottom of its HP bar (docs/gameplay/13 §6.4) */
.fbreak   { position: absolute; left: 0; bottom: 0; height: 5px; background-color: #ffe27a; }
/* its next move over its box (§6.1): the words and how far its wind-up is; the colour says what answers it */
.intent   { position: absolute; left: 0; top: -24px; width: 100%; height: 22px; }
.itext    { font-size: 16px; line-height: 18px; color: #f3e0ba; white-space: nowrap; overflow: hidden; }
.ibar     { position: absolute; left: 0; bottom: 0; width: 100%; height: 3px; background-color: #41414c; }
.ifill    { height: 100%; background-color: #edb17b; }
.intent.heavy .itext { color: #ff9a7a; }    .intent.heavy .ifill { background-color: #ff7a5a; }   /* parry it */
.intent.jabs .itext { color: #ffd27a; }     .intent.jabs .ifill { background-color: #ffc04a; }    /* guard, do not attack */
.intent.spell .itext { color: #c7a2ff; }    .intent.spell .ifill { background-color: #a77aff; }   /* break it with a combo */
.intent.guard .itext { color: #9fd8ff; }    .intent.guard .ifill { background-color: #6fb8ff; }   /* a full charge breaks it */
.intent.stagger .itext, .intent.broken .itext { color: #ffe27a; }
/* one monster: "Slime HP 24" on one line; two or three: the name, and the HP under it (narrow slots) */
.ftext.two { display: none; }
.foe.n2 .ftext.one, .foe.n3 .ftext.one { display: none; }
.foe.n2 .ftext.two, .foe.n3 .ftext.two { display: block; white-space: normal; }   /* a long name wraps too */
/* two or three share the 390 px right of the player's HP bar */
.foe.n2 { margin-left: 60px; width: 190px; }
.foe.n2.f1 { margin-left: 260px; }
.foe.n2 .fbox { width: 120px; }
.foe.n2 .fbox { height: 120px; }
.foe.n2 .fhp  { top: 136px; width: 190px; height: 18px; }
.foe.n2 .ftext { top: 158px; width: 190px; font-size: 18px; }
.foe.n3 { margin-left: 60px; width: 125px; }
.foe.n3.f1 { margin-left: 192px; }
.foe.n3.f2 { margin-left: 324px; }
.foe.n3 .fbox { width: 100px; }
.foe.n3 .fbox { height: 100px; }
.foe.n3 .fhp  { top: 114px; width: 125px; height: 16px; }
.foe.n3 .ftext { top: 134px; width: 125px; font-size: 16px; }

/* ---- the revamp (docs/gameplay/15_BATTLE_REVAMP.md): the play under the fighters, the thumbs at the bottom ---- */
#continue { position: absolute; left: 50%; margin-left: -250px; top: 368px; font-size: 24px; color: #ffffca; }

/* the stamina pace's bar (only then: each monster shows its own clock) */
#clock-label { position: absolute; left: 50%; margin-left: -250px; top: 498px; font-size: 18px; color: #f3e0ba; }
#clock { position: absolute; left: 50%; margin-left: -250px; top: 522px; width: 700px; height: 12px; background-color: #7b7b88; }

/* the play: the attack IS the play (15 §4): tap the track; the charge column on its left */
#play    { position: absolute; left: 50%; margin-left: -250px; top: 296px; width: 700px; height: 104px; }
.prompt  { font-size: 18px; color: #f3f3ff; height: 26px; }
.combo   { position: relative; height: 44px; }
.charge  { position: absolute; left: 0; top: 0; width: 14px; height: 44px; background-color: #41414c; }
.charge-fill { position: absolute; left: 0; bottom: 0; width: 100%; background-color: #ffc861; }
.track   { position: absolute; left: 24px; right: 0; top: 0; height: 44px; background-color: #5b6275; border-radius: 22px; }
.track.waiting { background-color: #6e4b52; }
.pt      { position: absolute; top: 7px; width: 30px; height: 30px; margin-left: -15px; border-radius: 15px; background-color: #94b1ed; }
.pt.hit  { background-color: #94e6a8; }
/* the marker is in its window: a tap now hits it (the hint, with a sound and a flash; the same window the tap uses) */
.pt.near { top: -1px; width: 46px; height: 46px; margin-left: -23px; border-radius: 23px;
           background-color: #ffe27a; border-width: 3px; border-color: #ffffff; }
.bar-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #41414c8c; border-radius: 22px; }
.marker  { position: absolute; top: -8px; width: 6px; height: 60px; margin-left: -3px; background-color: #ffffff; }
.note    { margin-top: 8px; font-size: 16px; color: #cacfd9; }
#chain   { position: absolute; left: 50%; margin-left: -250px; top: 404px; font-size: 24px; color: #ffd54a;
           font-effect: outline(2px #3a2a00); }

/* the super charge, the ultimate (the weapon's finisher) and the equipment's active */
#super { position: absolute; left: 50%; margin-left: -250px; top: 452px; height: 24px; }
#super-label { font-size: 17px; color: #f3f3ff; margin-right: 14px; }
.dot-slot { display: inline-block; }
.dot { width: 16px; height: 16px; margin-right: 7px; background-color: #7b7b88; border-radius: 8px; }
.dot.on { background-color: #ffca88; }
#super-btn  { position: absolute; left: 50%; margin-left: 100px; top: 438px; width: 210px; height: 50px; line-height: 50px;
              font-size: 21px; color: #2a1d00; text-align: center; background-color: #ffd54a; border-radius: 10px; }
#super-btn:hover  { background-color: #ffe27a; }
#active-btn { position: absolute; left: 50%; margin-left: 320px; top: 438px; width: 130px; height: 50px; line-height: 50px;
              font-size: 17px; color: #ffffff; text-align: center; background-color: #88c2d2; border-radius: 10px; overflow: hidden; }
#active-btn:hover { background-color: #9ad2e2; }
#crit { position: absolute; left: 50%; margin-left: -250px; top: 478px; font-size: 16px; color: #ffed94; }

/* the thumbs: GUARD is a button, the attack's panel only says how it is */
.panel   { position: absolute; top: 556px; width: 340px; height: 130px; border-radius: 16px; text-align: center; }
.plabel  { margin-top: 34px; font-size: 30px; color: #ffffff; font-effect: outline(2px #00000080); }
.phint   { margin-top: 6px; font-size: 15px; color: #ffffffb0; }
#guard   { left: 50%; margin-left: -250px; background-color: #17305c; }
#guard:hover  { background-color: #21417a; }
#guard:active, #guard.lit { background-color: #3f78d8; }
#guard.cooling { background-color: #1a2030; }
#guard-bar { position: absolute; left: 50%; margin-left: -250px; top: 520px; width: 340px; }
#guard-bar .panel { position: relative; top: 8px; height: 110px; background-color: #3e5580; }
#guard-bar .panel.cooling { background-color: #2c3548; }
#guard-bar .plabel { margin-top: 30px; font-size: 22px; }
.power   { position: relative; height: 28px; }
.zones   { display: flex; height: 100%; }
.zone        { height: 100%; }
.zone.red    { background-color: #e08888; }
.zone.blue   { background-color: #94b1ed; }
.zone.green  { background-color: #94e6a8; }
#attack-state { left: 50%; margin-left: 110px; background-color: #3a3326; overflow: hidden; }
#attack-state.ready   { background-color: #7a3a14; }
#attack-state.running { background-color: #9c4a18; }
#attack-state.short   { background-color: #3a3326; }
#attack-state .pfill  { position: absolute; left: 8px; top: 8px; bottom: 8px; max-width: 92%; background-color: #6a5434; border-radius: 8px; }
#attack-state.recovering .plabel { color: #9a8a70; }
#attack-state .plabel, #attack-state .phint { position: relative; }

/* damage numbers and words (UiPopup): a 300 px box over the fighter, rising and fading; the style by the result (15 §3.8) */
/* each weapon's own play (touch_play.h, docs/gameplay/15 §3.3): plain boxes the game places, sizes and turns (.tp) */
.tp { position: absolute; pointer-events: none; z-index: 2; text-align: center; font-size: 22px; color: #ffffff;
      font-effect: outline(2px #202020); }
.tp.target  { border-width: 4px; border-color: #ff5a5a; background-color: #ff5a5a33; }
.tp.target.idle { border-color: #ff9a9a; }
.tp.bull    { background-color: #ffd54a; }
.tp.count   { font-size: 20px; color: #ffe8a0; }
.tp.time    { background-color: #ffd54a; }
.tp.pull    { background-color: #ffffffb0; }
.tp.shot    { background-color: #ffd54a80; }
.tp.anchor  { background-color: #ffffff; }
.tp.cross   { border-width: 3px; border-color: #ffd54a; }
.tp.arrow   { background-color: #9aa1b3; }
.tp.arrow.head { background-color: transparent; border-top-width: 6px; border-right-width: 6px; border-color: #9aa1b3; }
.tp.arrow.now   { background-color: #ffffff; }
.tp.arrow.now.head { background-color: transparent; border-color: #ffffff; }
.tp.arrow.cut   { background-color: #6fe08a; }
.tp.arrow.cut.head { background-color: transparent; border-color: #6fe08a; }
.tp.arrow.missed { background-color: #ff6a6a; }
.tp.arrow.missed.head { background-color: transparent; border-color: #ff6a6a; }
.tp.arrow.hidden { background-color: #c8a0ff; }
.tp.swipe   { background-color: #e0f4ffc0; }
.tp.circle  { border-width: 4px; border-color: #ffffff; background-color: #7f5affb0; font-size: 30px; line-height: 60px; }
.tp.circle.idle { background-color: #7f5aff70; }
.tp.ring    { border-width: 3px; border-color: #ffd54a; }
.tp.mark.ok { border-width: 4px; border-color: #ffe066; }
/* docs/gameplay/16: the bow's charge and tutorial, the sword's open window, the staff's "!", a move's shape */
.tp.charge  { border-width: 3px; border-color: #ffd54a90; }
.tp.charge.full { border-color: #ff7a3a; border-width: 4px; }
.tp.ghost   { background-color: #ffffff70; border-width: 2px; border-color: #ffffff; }
.tp.tutorial { font-size: 20px; color: #ffe8a0; }
.tp.arrow.now.open { background-color: #ffd54a; }
.tp.arrow.now.open.head { background-color: transparent; border-color: #ffd54a; }
.tp.time.open { background-color: #ff9a3a; }
.tp.warn    { font-size: 34px; color: #ffd54a; font-effect: outline(3px #402800); }
.tp.star    { background-color: #c8a0ff60; }
.tp.star.done { background-color: #ffe066; }
.tp.corner  { border-width: 3px; border-color: #c8a0ff; }
.tp.corner.next { border-color: #ffffff; background-color: #ffffff40; }
.tp.corner.done { border-color: #ffe066; background-color: #ffe06690; }
/* the monster's "!" before its hit (16 §4): guard now */
.foe .warn { position: absolute; left: 70%; top: -14px; width: 48px; text-align: center; font-size: 60px;
             color: #ffd54a; font-effect: outline(4px #402800); }
#skill-prompt { position: absolute; left: 0; right: 0; top: 340px; text-align: center; font-size: 30px; color: #ffffff;
                font-effect: outline(3px #301848); z-index: 4; }
#skill-time { color: #ffd54a; }
.tp.mark.bad { background-color: #ff6a6a; }

.popup { position: absolute; width: 300px; text-align: center; font-size: 32px; color: #ffffff; font-effect: outline(2px #401010); }
.popup.great   { font-size: 38px; color: #7fe0ff; }
.popup.perfect { font-size: 50px; color: #ffe066; }
.popup.miss    { font-size: 26px; color: #9aa1b3; }
.popup.guard   { font-size: 28px; color: #9fd8ff; }
.popup.hurt    { font-size: 32px; color: #ff8a8a; }
.popup.parry   { font-size: 34px; color: #ffd54a; font-effect: outline(2px #3a2a00); }
.popup.block   { font-size: 28px; color: #9fd8ff; }
.popup.early   { font-size: 26px; color: #ffb070; }
.popup.chain   { font-size: 26px; color: #ffd54a; }
.popup.move-hit, .popup.move-great, .popup.move-perfect, .popup.move-miss { font-size: 26px; }
.popup.move-perfect { color: #ffe066; font-size: 30px; }
.popup.move-great   { color: #7fe0ff; }
.popup.move-miss    { color: #9aa1b3; }

/* a moment across the screen (15 §3.4): BREAK!, a monster's line, the ultimate's cut-in */
#banner { position: absolute; left: 0; right: 0; top: 330px; height: 96px; background-color: #000000a0; text-align: center; }
#banner-text { font-size: 64px; line-height: 96px; color: #ffd54a; font-effect: outline(3px #3a2a00); white-space: nowrap; }
#banner.line { height: 70px; }
#banner.line #banner-text { font-size: 28px; line-height: 70px; color: #ff9a7a; font-effect: outline(2px #300000); }
#banner.ultimate { background-color: #ffd54a; }
#banner.ultimate #banner-text { font-size: 40px; color: #2a1d00; font-effect: none; }

/* the result (15 §3.6) */
#result { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #080a10; z-index: 5; }   /* opaque: linear blending lets even 4 % show */
#result-box { position: absolute; left: 50%; margin-left: -300px; top: 40px; width: 600px; text-align: center; }
#result-title { font-size: 46px; color: #ffd54a; font-effect: outline(3px #3a2a00); }
#grade   { font-size: 130px; line-height: 150px; color: #e8eaf0; font-effect: outline(4px #00000080); }
#grade.s { color: #ffd54a; }
.rline   { margin-top: 8px; font-size: 24px; color: #e8eaf0; }
.rline.dim    { font-size: 18px; color: #9aa1b3; }
.rline.weapon { margin-top: 18px; font-size: 26px; }
.rline.up     { color: #8fe0a0; }
.rline.next   { color: #7fe0ff; }
.rline.gold   { margin-top: 18px; }
.rline.card   { color: #ffca88; }
.rline.tap    { margin-top: 24px; }
#wbar  { width: 420px; height: 16px; margin: 10px auto 0 auto; background-color: #3a3f50; border-radius: 8px; }
#wfill { height: 100%; background-color: #ffd54a; border-radius: 8px; }

/* ---- the scene layout (docs/gameplay/17 §19, the owner's two pictures, 2026-11-06): the monsters large in the middle, the hero large at the
   left (landscape) or the bottom left (portrait), the HP bar under the monsters, the buttons in a column at the right. On a canvas 768 px high. ---- */
#title { left: 0; right: 0; margin-left: 0; top: 12px; text-align: center; font-size: 38px; color: #f6e2b8; font-effect: outline(2px #1a1208); }
#player { left: 10px; margin-left: 0; top: 270px; width: 480px; height: 480px; }
#player-hp { left: 50%; margin-left: -70px; top: 688px; width: 330px; height: 22px; }
#player-hp-text { left: 50%; margin-left: -70px; top: 712px; font-effect: outline(2px #000000); }
#super { margin-left: -300px; top: 692px; }
#super-label { font-effect: outline(2px #000000); }
#super-btn { margin-left: -300px; top: 636px; width: 200px; height: 44px; line-height: 44px; }
#active-btn { margin-left: -90px; top: 636px; height: 44px; line-height: 44px; }
#crit { margin-left: -300px; top: 664px; }
#chain { margin-left: -70px; top: 652px; }
#play { margin-left: -250px; width: 500px; top: 560px; }
#clock-label { margin-left: -70px; top: 640px; }
#clock { margin-left: -70px; top: 664px; width: 330px; }
#continue { margin-left: -70px; top: 640px; font-effect: outline(2px #000000); }
#skill-prompt { top: 540px; }
/* the thumbs: a column at the right */
.panel { width: 190px; height: 100px; border-radius: 12px; }
.plabel { margin-top: 22px; font-size: 26px; }
.phint { font-size: 13px; }
#guard { left: auto; right: 24px; margin-left: 0; top: 628px; height: 120px; }
#guard-bar { left: auto; right: 24px; margin-left: 0; top: 590px; width: 190px; }
#attack-state { left: auto; right: 24px; margin-left: 0; top: 516px; }
/* the monsters, across the middle */
.ftext { text-align: center; font-size: 19px; font-effect: outline(2px #000000); }
.itext { font-effect: outline(1px #000000); }
.fhp { height: 8px; background-color: #00000090; }
.fbreak { height: 3px; }
.foe.n1, .foe.n2, .foe.n3 { left: 50%; }
.foe.n1 { margin-left: -150px; top: 170px; width: 340px; height: 420px; }
.foe.n1 .fbox { left: 0; top: 0; width: 340px; height: 340px; }
.foe.n1 .fhp { top: 352px; width: 340px; height: 8px; }
.foe.n1 .ftext { top: 364px; width: 340px; font-size: 22px; }
.foe.n2 { margin-left: -330px; top: 240px; width: 270px; height: 340px; }
.foe.n2.f1 { margin-left: 70px; }
.foe.n2 .fbox { left: 0; top: 0; width: 270px; height: 270px; }
.foe.n2 .fhp { top: 282px; width: 270px; height: 8px; }
.foe.n2 .ftext { top: 294px; width: 270px; font-size: 19px; }
/* three: the middle one large at the back, the other two smaller in front; their clocks in one row at the top */
.foe.n3 { margin-left: -245px; top: 420px; width: 170px; height: 220px; z-index: 2; }
.foe.n3 .fbox { left: 0; top: 0; width: 170px; height: 170px; }
.foe.n3 .fhp { top: 178px; width: 170px; height: 8px; }
.foe.n3 .ftext { top: 188px; width: 170px; font-size: 18px; }
.foe.n3 .intent { left: 8px; top: -262px; width: 154px; }
.foe.n3.f1 { margin-left: -160px; top: 180px; width: 360px; height: 420px; z-index: 1; }
.foe.n3.f1 .fbox { width: 360px; height: 360px; }
.foe.n3.f1 .fhp { top: 428px; left: 95px; width: 170px; }
.foe.n3.f1 .ftext { top: 438px; width: 360px; }
.foe.n3.f1 .intent { left: 103px; top: -22px; width: 154px; }
.foe.n3.f2 { margin-left: 125px; top: 400px; width: 190px; height: 240px; z-index: 2; }
.foe.n3.f2 .fbox { width: 190px; height: 190px; }
.foe.n3.f2 .fhp { top: 198px; width: 190px; }
.foe.n3.f2 .ftext { top: 208px; width: 190px; }
.foe.n3.f2 .intent { left: 18px; top: -242px; width: 154px; }

/* the six cells (docs/gameplay/19 §2.1): in front of the monster, the near row on top */
#cells { position: absolute; left: 50%; margin-left: -225px; top: 556px; width: 450px; height: 122px; transform-origin: 50% 100%; }
.cellbox { position: absolute; decorator: image(battle/cell_normal.png); }
.cellbox:hover { image-color: #ffffff; opacity: 0.85; }
.cellbox.danger { decorator: image(battle/cell_danger.png); }
.cfill { position: absolute; left: 9px; top: 9px; bottom: 9px; max-width: 94%; background-color: #ff5a3a70; border-radius: 6px; }
.cme { position: absolute; left: 50%; top: 50%; margin-left: -46px; margin-top: -46px; width: 92px; height: 92px; decorator: image(battle/cell_here.png); }
/* the first danger's moment (battle.json cells.intro): only the monster and its banner are shown */
body.focus #title, body.focus #player-hp, body.focus #player-hp-text, body.focus #guard, body.focus #guard-bar, body.focus #attack-state,
body.focus #super, body.focus #super-btn, body.focus #active-btn, body.focus #tutorial, body.focus .fhp, body.focus .ftext, body.focus .intent, body.focus .tp,
body.focus #play, body.focus .fhead, body.focus #chain, body.focus #crit, body.focus #clock, body.focus #clock-label { visibility: hidden; }
/* the new game's tutorial (docs/gameplay/19 B6): its words across the top of the fight, and a gold edge on what they mean */
#tutorial { position: absolute; left: 50%; margin-left: -400px; width: 800px; top: 10px; padding: 12px 14px; text-align: center;
            font-size: 28px; color: #ffffff; font-effect: outline(2px #000000); background-color: #0a0608e0;
            border-top: 2px #ff4034; border-bottom: 2px #ff4034; }
#guard.tutmark { border: 4px #ffd860; }
/* the thumbs (the owner's picture, 2026-11-07): a frame and an icon, the state's colour under them */
#guard, #attack-state { decorator: image(battle/btn_guard.png); }
#attack-state { decorator: image(battle/btn_attack.png); overflow: visible; }
.picon { position: absolute; left: 10px; top: 50%; margin-top: -29px; width: 58px; height: 58px; }
#guard .picon { decorator: image(battle/icon_guard.png); }
#attack-state .picon { decorator: image(battle/icon_attack.png); }
#guard .plabel, #attack-state .plabel { padding-left: 54px; }
#guard .phint, #attack-state .phint { padding-left: 62px; padding-right: 10px; }
#cell-hint { position: absolute; left: 0; width: 450px; top: -24px; text-align: center; font-size: 16px; color: #f3e0ba; font-effect: outline(2px #000000); }
/* with or without cells, the ultimate and the active button sit in the right column */
#super-btn { left: auto; right: 24px; margin-left: 0; top: 452px; width: 190px; }
#active-btn { left: auto; right: 24px; margin-left: 0; top: 402px; width: 190px; }
/* one monster: large */
.foe.n1 { margin-left: -190px; top: 102px; width: 380px; }
.foe.n1 .fbox { width: 380px; height: 380px; }
.foe.n1 .fhp { top: 386px; width: 380px; }
.foe.n1 .ftext { top: 396px; width: 380px; }

/* a canvas close to 4:3: the hero smaller, so it stays clear of the monsters */
@media (orientation: landscape) and (max-width: 1200px) {
    #player { left: -30px; top: 400px; width: 340px; height: 340px; }
}

/* ---- portrait: the same scene upright; the bottom row is anchored to the bottom, for thumbs ---- */
@media (orientation: portrait) {
    #title { top: 14px; font-size: 32px; }
    #player { left: -10px; top: auto; bottom: 16px; width: 270px; height: 270px; }
    .hp { top: auto; }
    .hp-text { top: auto; }
    #player-hp { left: 270px; margin-left: 0; top: auto; bottom: 70px; width: 280px; }
    #player-hp-text { left: 270px; margin-left: 0; top: auto; bottom: 38px; }
    #super { left: 24px; margin-left: 0; top: auto; bottom: 8px; }
    #super-btn { left: 290px; margin-left: 0; top: auto; bottom: 110px; width: 150px; }
    #active-btn { left: 448px; margin-left: 0; top: auto; bottom: 110px; width: 110px; }
    #crit { left: 24px; margin-left: 0; top: auto; bottom: 36px; }
    #chain { left: 290px; margin-left: 0; top: auto; bottom: 160px; }
    #play { left: 40px; margin-left: 0; width: 688px; top: auto; bottom: 340px; }
    #clock-label { left: 290px; margin-left: 0; top: auto; bottom: 126px; }
    #clock { left: 290px; margin-left: 0; width: 260px; top: auto; bottom: 104px; }
    #continue { left: 290px; margin-left: 0; top: auto; bottom: 150px; }
    #skill-prompt { top: 560px; }
    #cells { top: 612px; margin-left: -225px; }
    #tutorial { margin-left: -360px; width: 720px; font-size: 26px; }
    #super-btn { left: 270px; right: auto; top: auto; bottom: 110px; width: 150px; }
    #active-btn { left: 428px; right: auto; top: auto; bottom: 110px; width: 110px; }
    .foe.n1 { margin-left: -190px; top: 110px; }
    #banner { top: 440px; }
    .panel { top: auto; width: 170px; }
    #guard { right: 16px; top: auto; bottom: 24px; height: 120px; }
    #guard-bar { right: 16px; top: auto; bottom: 24px; width: 170px; }
    #guard-bar .panel { bottom: auto; }
    #attack-state { right: 16px; top: auto; bottom: 154px; }
    #result-box { margin-left: -330px; width: 660px; top: 80px; }
    .foe.n1 { margin-left: -170px; top: 150px; }
    .foe.n2 { margin-left: -350px; top: 220px; width: 330px; }
    .foe.n2.f1 { margin-left: 20px; }
    .foe.n2 .fbox { left: 30px; }
    .foe.n2 .fhp, .foe.n2 .ftext { width: 330px; }
    .foe.n3 { margin-left: -300px; top: 410px; }
    .foe.n3 .intent { left: 30px; top: -335px; width: 110px; }
    .foe.n3 .itext { font-size: 14px; }
    .foe.n3.f1 { margin-left: -180px; top: 100px; }
    .foe.n3.f1 .intent { left: 125px; top: -25px; width: 110px; }
    .foe.n3.f2 { margin-left: 120px; top: 400px; }
    .foe.n3.f2 .intent { left: 40px; top: -325px; width: 110px; }
}

/* a tall phone: the monsters lower, nearer the thumbs */
@media (orientation: portrait) and (min-height: 1300px) {
    .foe.n1 { top: 350px; }
    .foe.n2 { top: 430px; }
    .foe.n3 { top: 620px; }
    .foe.n3.f1 { top: 310px; }
    .foe.n3.f2 { top: 610px; }
    #skill-prompt { top: 800px; }
    #cells { top: 850px; }
    #banner { top: 640px; }
}

/* ---- last, over every layout above (the owner, 2026-11-12: the target line, the long HP bars, and everything mixed on
   the monster were ugly) ---- */
/* each monster's head (battle.rml .fhead): placed by the game at the top middle of where it stands; from the top: the
   "!" before its hit, its next move, its name and HP, a short HP bar just over its head */
.fhead { position: absolute; width: 220px; height: 66px; margin-left: -110px; margin-top: -70px; text-align: center; }
.fhead.down { opacity: 0.45; }
.fhead .warn { position: absolute; left: 50%; margin-left: -24px; top: -58px; width: 48px; text-align: center; font-size: 56px;
               color: #ffd54a; font-effect: outline(4px #402800); }
.fhead .intent { position: absolute; left: 35px; top: 0; width: 150px; height: 20px; }
.fhead .itext { font-size: 15px; line-height: 16px; }
.fhead .fname { position: absolute; left: 0; width: 220px; top: 24px; font-size: 19px; line-height: 22px; color: #ffffff;
                white-space: nowrap; font-effect: outline(2px #000000); }
.fhead .fhpnum { font-size: 15px; color: #dcdcdc; }
.fhead .fhp { position: absolute; left: 50%; margin-left: -55px; top: 52px; width: 110px; height: 6px; border-radius: 3px;
              background-color: #000000b0; }
.fhead .fhp .fill-bar { border-radius: 3px; }
.fhead .fbreak { height: 2px; }
/* the target, with two or three monsters: its name glows (no line of words under it) */
.fhead.target .fname { color: #fff3c4; font-effect: glow(1px 6px 0px 0px #ffb21e); }
.fhead.target .fhpnum { color: #fff3c4; }

/* ---- the bottom of the battle screen, landscape (the owner, 2026-11-14, Q96): the hero's HP at the bottom left, the cells at
   the bottom middle, the attack track over them; what sat beside the HP bar (the ultimate's dots, the chain, the crit, the
   stamina pace) stacked over it at the left ---- */
@media (orientation: landscape) {
    #player-hp { left: 24px; margin-left: 0; top: 730px; width: 300px; }
    #player-hp-text { left: 24px; margin-left: 0; top: 700px; }
    #super { left: 24px; margin-left: 0; top: 670px; }
    #crit { left: 24px; margin-left: 0; top: 642px; }
    #chain { left: 24px; margin-left: 0; top: 614px; }
    #clock-label { left: 24px; margin-left: 0; top: 560px; }
    #clock { left: 24px; margin-left: 0; top: 586px; width: 300px; }
    #cells { top: 622px; }
    #play { top: 488px; }
    #continue { top: 530px; }
}

/* a boss's introduction (the owner, 2026-11-14, Q82: "like Mega Man"): a dark banner with gold edges across the lower screen,
   "BOSS" and the boss's name typed in, while the camera holds on the boss */
#boss-intro { position: absolute; left: 0; right: 0; top: 548px; height: 160px; z-index: 6; }
.bi-band { position: absolute; left: 0; right: 0; top: 0; height: 160px; text-align: center; background-color: #06040ce0;
           border-top: 4px #ffcf4a; border-bottom: 4px #ffcf4a; }
.bi-label { margin-top: 16px; font-size: 28px; line-height: 32px; color: #ff6a50; font-effect: outline(2px #2a0000); }
.bi-name { margin-top: 10px; font-size: 68px; line-height: 76px; color: #ffe590; font-effect: glow(2px 10px 0px 0px #ff8a1e); }
@media (orientation: portrait) { #boss-intro { top: 900px; } }
