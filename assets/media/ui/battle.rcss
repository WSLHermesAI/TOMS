/* battle.rcss -- the battle screen (battle.rml). Laid out 1.4x larger than the map UI so it
   reads well on phones (the old screen's "battle scale").

   Landscape and portrait (docs/gameplay/12_UI_LAYOUT.md; the owner 2026-10-25). The canvas's short side is always
   768 px and the long side follows the screen (canvas.h), so:
   - landscape: one 700 px block, its left edge 250 px left of the centre (on the 1024 canvas: x 262, as it always was);
     a wider screen keeps it in the middle;
   - portrait: full-width rows, 40 px from the edges; the fighters at the top, the controls anchored to the bottom (for
     thumbs). A tall phone (16:9 and longer, the canvas 1300+ high) stacks the monster above the player; a shorter
     portrait screen keeps them side by side.
   The revamp (docs/gameplay/15_BATTLE_REVAMP.md §4): the play (#play) under the fighters, the two thumb panels (#guard,
   #attack-state) at the bottom, the banner and the result over everything.
   The game draws the animated fighters in #player / .foe .fbox and reads where they are (GameUi::sync), so these rules
   are the only place a fighter's position is written.
   One to three monsters (.foe; docs/gameplay/13 §4.6): .n1/.n2/.n3 is how many, .f1/.f2 which one. One monster is
   placed as the single monster always was. */
body { z-index: 30; }

#title  { position: absolute; left: 50%; margin-left: -250px; top: 14px; font-size: 38px; color: #ffcaa8; }
.fighter { position: absolute; top: 84px; width: 134px; height: 134px; }
.fighter img { width: 100%; height: 100%; }
#player { left: 50%; margin-left: -250px; }

.hp      { position: absolute; top: 238px; width: 280px; height: 22px; background-color: #7b7b88; }
#player-hp { left: 50%; margin-left: -250px; }
.fill-bar { height: 100%; }
.fill-bar.good  { background-color: #94f3a8; }
.fill-bar.bad   { background-color: #f39494; }
.fill-bar.clock { background-color: #edb17b; }
.fill-bar.clock.stamina { background-color: #8fd8a0; }   /* the stamina pace (docs/gameplay/13 §6.3) */
.hp-text { position: absolute; top: 262px; font-size: 22px; color: #ffffff; white-space: nowrap; }
#player-hp-text { left: 50%; margin-left: -250px; }

/* the monsters: each a slot with its next move over its box, the target mark under it, its HP bar (with its break gauge) and text */
.foe      { position: absolute; left: 50%; margin-left: 140px; top: 84px; width: 280px; height: 200px; }
.foe.down { opacity: 0.45; }
.fbox     { position: absolute; left: 0; top: 0; width: 134px; height: 134px; }
.fbox img { width: 100%; height: 100%; }
.mark     { position: absolute; left: 0; bottom: -12px; width: 100%; height: 6px; background-color: #ffe27a; }   /* under its box */
.fhp      { position: absolute; left: 0; top: 154px; width: 280px; height: 22px; background-color: #7b7b88; }
.ftext    { position: absolute; left: 0; top: 178px; width: 280px; font-size: 22px; color: #ffffff; white-space: nowrap; overflow: hidden; }
/* its break gauge, along the bottom of its HP bar (docs/gameplay/13 §6.4) */
.fbreak   { position: absolute; left: 0; bottom: 0; height: 5px; background-color: #ffe27a; }
/* its next move over its box (§6.1): the words and how far its wind-up is; the colour says what answers it */
.intent   { position: absolute; left: 0; top: -24px; width: 100%; height: 22px; }
.itext    { font-size: 16px; line-height: 18px; color: #f3e0ba; white-space: nowrap; overflow: hidden; }
.ibar     { position: absolute; left: 0; bottom: 0; width: 100%; height: 3px; background-color: #41414c; }
.ifill    { height: 100%; background-color: #edb17b; }
.intent.heavy .itext { color: #ff9a7a; }    .intent.heavy .ifill { background-color: #ff7a5a; }   /* parry it */
.intent.jabs .itext { color: #ffd27a; }     .intent.jabs .ifill { background-color: #ffc04a; }    /* guard, do not attack */
.intent.spell .itext { color: #c7a2ff; }    .intent.spell .ifill { background-color: #a77aff; }   /* break it with a combo */
.intent.guard .itext { color: #9fd8ff; }    .intent.guard .ifill { background-color: #6fb8ff; }   /* a full charge breaks it */
.intent.stagger .itext, .intent.broken .itext { color: #ffe27a; }
/* one monster: "Slime HP 24" on one line; two or three: the name, and the HP under it (narrow slots) */
.ftext.two { display: none; }
.foe.n2 .ftext.one, .foe.n3 .ftext.one { display: none; }
.foe.n2 .ftext.two, .foe.n3 .ftext.two { display: block; white-space: normal; }   /* a long name wraps too */
/* two or three share the 390 px right of the player's HP bar */
.foe.n2 { margin-left: 60px; width: 190px; }
.foe.n2.f1 { margin-left: 260px; }
.foe.n2 .fbox { width: 120px; }
.foe.n2 .fbox { height: 120px; }
.foe.n2 .fhp  { top: 136px; width: 190px; height: 18px; }
.foe.n2 .ftext { top: 158px; width: 190px; font-size: 18px; }
.foe.n3 { margin-left: 60px; width: 125px; }
.foe.n3.f1 { margin-left: 192px; }
.foe.n3.f2 { margin-left: 324px; }
.foe.n3 .fbox { width: 100px; }
.foe.n3 .fbox { height: 100px; }
.foe.n3 .fhp  { top: 114px; width: 125px; height: 16px; }
.foe.n3 .ftext { top: 134px; width: 125px; font-size: 16px; }

/* ---- the revamp (docs/gameplay/15_BATTLE_REVAMP.md): the play under the fighters, the thumbs at the bottom ---- */
#continue { position: absolute; left: 50%; margin-left: -250px; top: 368px; font-size: 24px; color: #ffffca; }

/* the stamina pace's bar (only then: each monster shows its own clock) */
#clock-label { position: absolute; left: 50%; margin-left: -250px; top: 498px; font-size: 18px; color: #f3e0ba; }
#clock { position: absolute; left: 50%; margin-left: -250px; top: 522px; width: 700px; height: 12px; background-color: #7b7b88; }

/* the play: the attack IS the play (15 §4): tap the track; the charge column on its left */
#play    { position: absolute; left: 50%; margin-left: -250px; top: 296px; width: 700px; height: 104px; }
.prompt  { font-size: 18px; color: #f3f3ff; height: 26px; }
.combo   { position: relative; height: 44px; }
.charge  { position: absolute; left: 0; top: 0; width: 14px; height: 44px; background-color: #41414c; }
.charge-fill { position: absolute; left: 0; bottom: 0; width: 100%; background-color: #ffc861; }
.track   { position: absolute; left: 24px; right: 0; top: 0; height: 44px; background-color: #5b6275; border-radius: 22px; }
.track.waiting { background-color: #6e4b52; }
.pt      { position: absolute; top: 7px; width: 30px; height: 30px; margin-left: -15px; border-radius: 15px; background-color: #94b1ed; }
.pt.hit  { background-color: #94e6a8; }
/* the marker is in its window: a tap now hits it (the hint, with a sound and a flash; the same window the tap uses) */
.pt.near { top: -1px; width: 46px; height: 46px; margin-left: -23px; border-radius: 23px;
           background-color: #ffe27a; border-width: 3px; border-color: #ffffff; }
.bar-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #41414c8c; border-radius: 22px; }
.marker  { position: absolute; top: -8px; width: 6px; height: 60px; margin-left: -3px; background-color: #ffffff; }
.note    { margin-top: 8px; font-size: 16px; color: #cacfd9; }
#chain   { position: absolute; left: 50%; margin-left: -250px; top: 404px; font-size: 24px; color: #ffd54a;
           font-effect: outline(2px #3a2a00); }

/* the super charge, the ultimate (the weapon's finisher) and the equipment's active */
#super { position: absolute; left: 50%; margin-left: -250px; top: 452px; height: 24px; }
#super-label { font-size: 17px; color: #f3f3ff; margin-right: 14px; }
.dot-slot { display: inline-block; }
.dot { width: 16px; height: 16px; margin-right: 7px; background-color: #7b7b88; border-radius: 8px; }
.dot.on { background-color: #ffca88; }
#super-btn  { position: absolute; left: 50%; margin-left: 100px; top: 438px; width: 210px; height: 50px; line-height: 50px;
              font-size: 21px; color: #2a1d00; text-align: center; background-color: #ffd54a; border-radius: 10px; }
#super-btn:hover  { background-color: #ffe27a; }
#active-btn { position: absolute; left: 50%; margin-left: 320px; top: 438px; width: 130px; height: 50px; line-height: 50px;
              font-size: 17px; color: #ffffff; text-align: center; background-color: #88c2d2; border-radius: 10px; overflow: hidden; }
#active-btn:hover { background-color: #9ad2e2; }
#crit { position: absolute; left: 50%; margin-left: -250px; top: 478px; font-size: 16px; color: #ffed94; }

/* the thumbs: GUARD is a button, the attack's panel only says how it is */
.panel   { position: absolute; top: 556px; width: 340px; height: 130px; border-radius: 16px; text-align: center; }
.plabel  { margin-top: 34px; font-size: 30px; color: #ffffff; font-effect: outline(2px #00000080); }
.phint   { margin-top: 6px; font-size: 15px; color: #ffffffb0; }
#guard   { left: 50%; margin-left: -250px; background-color: #3e5580; }
#guard:hover  { background-color: #4b6595; }
#guard:active, #guard.lit { background-color: #6a9be0; }
#guard.cooling { background-color: #2c3548; }
#guard-bar { position: absolute; left: 50%; margin-left: -250px; top: 520px; width: 340px; }
#guard-bar .panel { position: relative; top: 8px; height: 110px; background-color: #3e5580; }
#guard-bar .panel.cooling { background-color: #2c3548; }
#guard-bar .plabel { margin-top: 30px; font-size: 22px; }
.power   { position: relative; height: 28px; }
.zones   { display: flex; height: 100%; }
.zone        { height: 100%; }
.zone.red    { background-color: #e08888; }
.zone.blue   { background-color: #94b1ed; }
.zone.green  { background-color: #94e6a8; }
#attack-state { left: 50%; margin-left: 110px; background-color: #3a3326; overflow: hidden; }
#attack-state.ready   { background-color: #b0663a; }
#attack-state.running { background-color: #c4733f; }
#attack-state.short   { background-color: #3a3326; }
#attack-state .pfill  { position: absolute; left: 0; top: 0; bottom: 0; background-color: #6a5434; }
#attack-state.recovering .plabel { color: #9a8a70; }
#attack-state .plabel, #attack-state .phint { position: relative; }

/* damage numbers and words (UiPopup): a 300 px box over the fighter, rising and fading; the style by the result (15 §3.8) */
/* each weapon's own play (touch_play.h, docs/gameplay/15 §3.3): plain boxes the game places, sizes and turns (.tp) */
.tp { position: absolute; pointer-events: none; z-index: 2; text-align: center; font-size: 22px; color: #ffffff;
      font-effect: outline(2px #202020); }
.tp.target  { border-width: 4px; border-color: #ff5a5a; background-color: #ff5a5a33; }
.tp.target.idle { border-color: #ff9a9a; }
.tp.bull    { background-color: #ffd54a; }
.tp.count   { font-size: 20px; color: #ffe8a0; }
.tp.time    { background-color: #ffd54a; }
.tp.pull    { background-color: #ffffffb0; }
.tp.shot    { background-color: #ffd54a80; }
.tp.anchor  { background-color: #ffffff; }
.tp.cross   { border-width: 3px; border-color: #ffd54a; }
.tp.arrow   { background-color: #9aa1b3; }
.tp.arrow.head { background-color: transparent; border-top-width: 6px; border-right-width: 6px; border-color: #9aa1b3; }
.tp.arrow.now   { background-color: #ffffff; }
.tp.arrow.now.head { background-color: transparent; border-color: #ffffff; }
.tp.arrow.cut   { background-color: #6fe08a; }
.tp.arrow.cut.head { background-color: transparent; border-color: #6fe08a; }
.tp.arrow.missed { background-color: #ff6a6a; }
.tp.arrow.missed.head { background-color: transparent; border-color: #ff6a6a; }
.tp.arrow.hidden { background-color: #c8a0ff; }
.tp.swipe   { background-color: #e0f4ffc0; }
.tp.circle  { border-width: 4px; border-color: #ffffff; background-color: #7f5affb0; font-size: 30px; line-height: 60px; }
.tp.circle.idle { background-color: #7f5aff70; }
.tp.ring    { border-width: 3px; border-color: #ffd54a; }
.tp.mark.ok { border-width: 4px; border-color: #ffe066; }
.tp.mark.bad { background-color: #ff6a6a; }

.popup { position: absolute; width: 300px; text-align: center; font-size: 32px; color: #ffffff; font-effect: outline(2px #401010); }
.popup.great   { font-size: 38px; color: #7fe0ff; }
.popup.perfect { font-size: 50px; color: #ffe066; }
.popup.miss    { font-size: 26px; color: #9aa1b3; }
.popup.guard   { font-size: 28px; color: #9fd8ff; }
.popup.hurt    { font-size: 32px; color: #ff8a8a; }
.popup.parry   { font-size: 34px; color: #ffd54a; font-effect: outline(2px #3a2a00); }
.popup.block   { font-size: 28px; color: #9fd8ff; }
.popup.early   { font-size: 26px; color: #ffb070; }
.popup.chain   { font-size: 26px; color: #ffd54a; }
.popup.move-hit, .popup.move-great, .popup.move-perfect, .popup.move-miss { font-size: 26px; }
.popup.move-perfect { color: #ffe066; font-size: 30px; }
.popup.move-great   { color: #7fe0ff; }
.popup.move-miss    { color: #9aa1b3; }

/* a moment across the screen (15 §3.4): BREAK!, a monster's line, the ultimate's cut-in */
#banner { position: absolute; left: 0; right: 0; top: 330px; height: 96px; background-color: #000000a0; text-align: center; }
#banner-text { font-size: 64px; line-height: 96px; color: #ffd54a; font-effect: outline(3px #3a2a00); white-space: nowrap; }
#banner.line { height: 70px; }
#banner.line #banner-text { font-size: 28px; line-height: 70px; color: #ff9a7a; font-effect: outline(2px #300000); }
#banner.ultimate { background-color: #ffd54a; }
#banner.ultimate #banner-text { font-size: 40px; color: #2a1d00; font-effect: none; }

/* the result (15 §3.6) */
#result { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #080a10; z-index: 5; }   /* opaque: linear blending lets even 4 % show */
#result-box { position: absolute; left: 50%; margin-left: -300px; top: 40px; width: 600px; text-align: center; }
#result-title { font-size: 46px; color: #ffd54a; font-effect: outline(3px #3a2a00); }
#grade   { font-size: 130px; line-height: 150px; color: #e8eaf0; font-effect: outline(4px #00000080); }
#grade.s { color: #ffd54a; }
.rline   { margin-top: 8px; font-size: 24px; color: #e8eaf0; }
.rline.dim    { font-size: 18px; color: #9aa1b3; }
.rline.weapon { margin-top: 18px; font-size: 26px; }
.rline.up     { color: #8fe0a0; }
.rline.next   { color: #7fe0ff; }
.rline.gold   { margin-top: 18px; }
.rline.card   { color: #ffca88; }
.rline.tap    { margin-top: 24px; }
#wbar  { width: 420px; height: 16px; margin: 10px auto 0 auto; background-color: #3a3f50; border-radius: 8px; }
#wfill { height: 100%; background-color: #ffd54a; border-radius: 8px; }

/* ---- portrait: rows across the 768 px width; the controls on the bottom, for thumbs ---- */
@media (orientation: portrait) {
    #title { left: 40px; margin-left: 0; top: 14px; font-size: 30px; }   /* clear of the monsters' intents */
    /* side by side (a short portrait screen; a tall phone stacks them below) */
    .fighter    { top: 80px; }
    #player     { left: 118px; margin-left: 0; }
    .hp         { top: 230px; width: 330px; }
    #player-hp  { left: 40px; margin-left: 0; }
    .hp-text    { top: 256px; }
    #player-hp-text { left: 40px; margin-left: 0; }
    /* the monsters: the right half, 330 px from x 398 */
    .foe.n1, .foe.n2, .foe.n3 { margin-left: 0; top: 80px; }
    .foe.n1 { left: 398px; width: 330px; }
    .foe.n1 .fbox { left: 118px; }
    .foe.n1 .fhp  { top: 150px; width: 330px; }
    .foe.n1 .ftext { top: 176px; width: 330px; }
    .foe.n2 { left: 398px; width: 160px; }
    .foe.n2.f1 { left: 568px; margin-left: 0; }
    .foe.n2 .fbox { left: 25px; }
    .foe.n2 .fhp  { top: 126px; width: 160px; }
    .foe.n2 .ftext { top: 146px; width: 160px; }
    .foe.n3 { left: 398px; width: 105px; }
    .foe.n3.f1 { left: 510px; margin-left: 0; }
    .foe.n3.f2 { left: 622px; margin-left: 0; }
    .foe.n3 .fbox { left: 7px; }
    .foe.n3 .fhp  { top: 104px; width: 105px; }
    .foe.n3 .ftext { top: 122px; width: 105px; }
    .foe.n3 .itext { font-size: 14px; }
    #continue   { left: 40px; margin-left: 0; top: 370px; }
    /* the play under the fighters; the rest from the bottom up (for thumbs) */
    /* the play just above the thumbs' row (a phone in one hand: within reach) */
    #play        { left: 40px; margin-left: 0; width: 688px; top: auto; bottom: 282px; }
    #chain       { left: 40px; margin-left: 0; top: auto; bottom: 392px; }
    #clock-label { left: 40px; margin-left: 0; top: auto; bottom: 330px; }
    #clock       { left: 40px; margin-left: 0; width: 688px; top: auto; bottom: 310px; }
    #super       { left: 40px; margin-left: 0; top: auto; bottom: 238px; }
    #super-btn   { left: 330px; margin-left: 0; top: auto; bottom: 226px; width: 230px; }
    #active-btn  { left: 578px; margin-left: 0; top: auto; bottom: 226px; width: 150px; }
    #crit        { left: 40px; margin-left: 0; top: auto; bottom: 200px; }
    .panel       { top: auto; bottom: 30px; height: 160px; width: 334px; }
    .plabel      { margin-top: 48px; }
    #guard       { left: 40px; margin-left: 0; }
    #guard-bar   { left: 40px; margin-left: 0; top: auto; bottom: 30px; width: 334px; }
    #guard-bar .panel { bottom: auto; height: 124px; }
    #attack-state { left: 394px; margin-left: 0; }
    #banner      { top: 440px; }
    #result-box  { margin-left: -330px; width: 660px; top: 80px; }
}

/* a tall phone: the monster above, the player below it, each with its HP under it */
@media (orientation: portrait) and (min-height: 1300px) {
    .fighter    { width: 180px; height: 180px; }
    #player     { left: 294px; top: 352px; }
    .hp         { width: 688px; }
    /* the monsters across the width, 688 px from x 40 */
    .foe.n1, .foe.n2, .foe.n3 { top: 88px; }
    .foe.n1 { left: 40px; width: 688px; }
    .foe.n1 .fbox { left: 254px; width: 180px; }
    .foe.n1 .fbox { height: 180px; }
    .foe.n1 .fhp  { top: 192px; width: 688px; }
    .foe.n1 .ftext { top: 218px; width: 688px; }
    .foe.n2 { left: 40px; width: 334px; }
    .foe.n2.f1 { left: 394px; }
    .foe.n2 .fbox { left: 87px; width: 160px; }
    .foe.n2 .fbox { height: 160px; }
    .foe.n2 .fhp  { top: 172px; width: 334px; height: 22px; }
    .foe.n2 .ftext { top: 198px; width: 334px; font-size: 22px; }
    .foe.n3 { left: 40px; width: 220px; }
    .foe.n3.f1 { left: 274px; }
    .foe.n3.f2 { left: 508px; }
    .foe.n3 .fbox { left: 35px; width: 150px; }
    .foe.n3 .fbox { height: 150px; }
    .foe.n3 .fhp  { top: 162px; width: 220px; height: 20px; }
    .foe.n3 .ftext { top: 188px; width: 220px; font-size: 19px; }
    #player-hp  { left: 40px; top: 544px; }
    #player-hp-text { left: 40px; top: 570px; }
    #continue   { top: 692px; }
    #banner     { top: 700px; }
}
