/* saveload.rcss -- Save / Load (saveload.rml), over the player menu. Design space 1024x768. */
body { z-index: 50; }

#panel { position: absolute; left: 112px; top: 70px; width: 800px; height: 628px; word-break: break-word; }
#title { position: absolute; left: 30px; top: 22px; font-size: 30px; color: #f9e9b1; }
#modes { position: absolute; left: 30px; top: 76px; height: 44px; }
.slot  { display: inline-block; vertical-align: top; }
.mode {
    display: inline-block; width: 150px; height: 44px; line-height: 44px; margin-right: 10px; text-align: center;
    font-size: 21px; color: #e9eef9; background-color: #6f7285; border-radius: 22px; cursor: pointer;
}
.mode:hover { background-color: #7d8197; }
.mode.active { background-color: #ead98f; color: #2e3140; }
#close { position: absolute; right: 24px; top: 20px; width: 110px; height: 44px; line-height: 44px; font-size: 19px; }

#cards { position: absolute; left: 30px; right: 30px; top: 140px; }
.card {
    height: 96px; margin-bottom: 14px; padding: 12px 20px; cursor: pointer;
    background-color: #6f7285f5; border: 2px #00000000; border-radius: 8px;
}
.card:hover { background-color: #7d8197; }
.card.selected { background-color: #8594b0; border-color: #ffed7b; }
.card.off { background-color: #5f6273; }
.card.off .card-title, .card.off .card-line1 { color: #a9adbd; }
.card-title { font-size: 23px; color: #fff6c2; }
.card-tag   { margin-left: 14px; padding: 2px 10px; font-size: 15px; color: #2e3140; background-color: #9ff0b4; border-radius: 10px; }
.card-line1 { margin-top: 10px; font-size: 19px; color: #ffffff; }
.card-line2 { margin-top: 6px; font-size: 16px; color: #cad0e1; }

#hint { position: absolute; left: 30px; bottom: 16px; font-size: 15px; color: #cad0e1; }

#confirm  { position: absolute; left: 232px; top: 279px; width: 560px; height: 210px; text-align: center; word-break: break-word; }
#confirm.with-body { top: 254px; height: 260px; }
#question { margin-top: 50px; padding: 0 20px; font-size: 26px; color: #f9e9b1; }
#confirm.with-body #question { margin-top: 34px; }
#body     { margin-top: 12px; padding: 0 20px; font-size: 18px; color: #cad0e1; }
#answers  { position: absolute; left: 0; right: 0; bottom: 26px; }
.answer   { display: inline-block; width: 160px; height: 52px; line-height: 52px; margin: 0 20px; text-align: center; font-size: 20px; color: #ffffff; }
