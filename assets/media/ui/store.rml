<rml>
<head>
    <title>Store</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="store.rcss"/>
</head>
<!-- The item store: tabs, up to three cards per tab, buy buttons. A click outside the panel
     closes it. Purchase messages are the overlay's toast. Data: store.* (UiStore). -->
<body data-model="game">
    <div id="backdrop" data-event-click="act('store_close')"></div>

    <div id="panel">
        <div id="header">
            <div id="title">{{store.title}}</div>
            <div id="gold">{{store.gold_label}}: <span class="gold">{{store.gold}}</span></div>
            <div id="close" class="btn" data-event-click="act('store_close')">{{store.close_label}} X</div>
        </div>
        <div id="hint">{{store.hint}}</div>

        <div id="tabs">
            <div class="tab-slot" data-for="tab, i : store.tabs">
                <div class="tab btn" data-class-active="tab.active" data-event-click="act('store_tab', i)">{{tab.label}}</div>
            </div>
        </div>

        <div id="cards">
            <div class="card-slot" data-for="item, i : store.items">
            <div class="card" data-class-selected="item.selected" data-event-mouseover="act('store_hover', i)">
                <img class="icon" data-attr-src="item.icon"/>
                <div class="name">{{item.name}}</div>
                <div class="desc">{{item.desc}}</div>
                <div class="effect">{{store.effect_label}}: {{item.effect}}</div>
                <div class="status" data-class-equipped="item.equipped">{{item.status}}</div>
                <div class="price">{{store.price_label}}: {{item.price}} G</div>
                <div class="buy btn" data-event-click="act('store_buy', i)">{{store.buy_label}}</div>
            </div>
            </div>
        </div>
    </div>
</body>
</rml>
