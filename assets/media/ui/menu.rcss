/* menu.rcss -- the in-game menu (menu.rml). The panel grows with its rows, centred on screen. */
body { z-index: 45; }

#frame { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; }
#panel { width: 460px; padding: 22px 30px 20px 30px; text-align: center; }
#header    { font-size: 30px; color: #f9e9b1; }
#subheader { margin-top: 6px; font-size: 18px; color: #cad0e1; }
#rows { margin-top: 18px; max-height: 520px; overflow-y: auto; }
.row  { height: 56px; line-height: 56px; margin-bottom: 10px; padding-left: 18px; font-size: 21px; color: #ffffff; text-align: left; }
#close { display: block; width: 140px; height: 46px; line-height: 46px; margin: 10px auto 0 auto; padding: 0; text-align: center; }

#confirm  { position: absolute; left: 232px; top: 279px; width: 560px; height: 210px; text-align: center; }
#question { margin-top: 60px; font-size: 28px; color: #f9e9b1; }
#answers  { position: absolute; left: 0; right: 0; bottom: 26px; }
.answer   { display: inline-block; width: 160px; height: 56px; line-height: 56px; margin: 0 20px; padding: 0; text-align: center; }
