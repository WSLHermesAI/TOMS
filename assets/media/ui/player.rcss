/* player.rcss -- the player menu (player.rml). Landscape and portrait (docs/gameplay/12_UI_LAYOUT.md): landscape is a
   992 x 744 panel in the middle of the canvas (on the 1024 canvas at x 16, as it always was); portrait fills the
   screen less a 12 px edge and stacks each page's two columns. The lists (grid, events, system rows) take the height
   left under their filters, so they never run out of the panel. Rules for portrait are at the end. */
body { z-index: 45; }

#panel { position: absolute; left: 50%; margin-left: -496px; top: 12px; width: 992px; height: 744px; background-color: #5a6175f8; }
/* Chinese and Japanese have no spaces to break lines at: break a too-long run where it overflows. */
#panel, .confirm { word-break: break-word; }

.slot { display: inline-block; vertical-align: top; }   /* a data-for wrapper laid out in a row */

/* ---- tabs ---- */
#tabs { position: absolute; left: 16px; right: 16px; top: 10px; height: 52px; }
.tab {
    display: inline-block; height: 48px; line-height: 48px; padding: 0 22px; margin-right: 8px;
    font-size: 22px; color: #e9eef9; background-color: #6f7285; border-radius: 6px 6px 0 0; cursor: pointer;
}
.tab:hover { background-color: #7d8197; }
.tab.active { background-color: #8594b0; color: #fff6c2; }
.dot { display: inline-block; width: 10px; height: 10px; margin-left: 6px; border-radius: 5px; background-color: #ff6b5e; }
#close { position: absolute; right: 0; top: 0; width: 48px; height: 48px; line-height: 48px; font-size: 28px; }

.page { position: absolute; left: 16px; right: 16px; top: 68px; bottom: 34px; }
#hint { position: absolute; left: 20px; bottom: 8px; font-size: 15px; color: #cad0e1; }
.heading { margin: 10px 0 6px 0; font-size: 18px; color: #f9e9b1; }
.line { height: 30px; line-height: 30px; font-size: 19px; color: #ffffff; }
.l-label { display: inline-block; width: 120px; color: #cad0e1; }
.l-value { color: #ffffff; }
.gap { height: 10px; }
.empty { padding: 30px 10px; font-size: 19px; color: #e9f1ff; }
.hint-center { padding: 120px 20px 0 20px; text-align: center; font-size: 19px; color: #cad0e1; }

/* ---- Status ---- */
#st-left  { position: absolute; left: 8px; top: 0; width: 470px; bottom: 0; }
#st-right { position: absolute; left: 500px; right: 8px; top: 0; bottom: 0; }
#st-level { font-size: 34px; color: #fff6c2; margin-bottom: 8px; }
.bar { width: 300px; height: 14px; margin-top: 8px; background-color: #3d4252; border-radius: 4px; }
.fill-hp  { height: 100%; background-color: #f37b7b; border-radius: 4px; }
.fill-exp { height: 100%; background-color: #8fc7f5; border-radius: 4px; }
.bar-text { font-size: 17px; color: #e9eef9; }
#attrs { max-height: 380px; overflow-y: auto; }
.attr { height: 42px; line-height: 42px; margin-bottom: 6px; padding: 0 16px; font-size: 20px; color: #ffffff; }
.attr-value { float: right; color: #fff6c2; }
.attr-add { float: right; width: 30px; height: 30px; line-height: 30px; margin: 6px 0 0 12px; text-align: center;
            font-size: 22px; color: #2e3140; background-color: #9ff0b4; border-radius: 15px; }
.attr-add:hover { background-color: #b8f5c8; }
.attr-sub { float: right; width: 30px; height: 30px; line-height: 30px; margin: 6px 0 0 12px; text-align: center;
            font-size: 22px; color: #3a1d14; background-color: #f0b8a8; border-radius: 15px; }
.attr-sub:hover { background-color: #ffd2c6; }
/* points placed, not kept yet: Confirm keeps them (and saves), Reset drops them */
#attr-actions { margin-top: 10px; text-align: right; }
.attr-confirm, .attr-reset { display: inline-block; height: 38px; line-height: 38px; padding: 0 20px; margin-left: 12px;
                             border-radius: 8px; font-size: 18px; }
.attr-confirm { background-color: #9ff0b4; color: #12321c; }
.attr-confirm:hover { background-color: #c4f7d2; }
.attr-reset { background-color: #5a6478; color: #ffffff; }
.attr-reset:hover { background-color: #78839a; }
.attr-confirm, .attr-reset { border-width: 3px; border-color: transparent; }
.attr-confirm.selected, .attr-reset.selected { border-color: #ffed7b; }
#attr-points { margin-left: 16px; font-size: 16px; color: #9ff0b4; }
.attr-eff { margin-top: 8px; font-size: 17px; color: #cfe7ff; }
.attr-eff.now { color: #9ff0b4; }
.attr-eff.hint { color: #ffd28f; font-size: 15px; }
#attr-desc {
    position: absolute; left: 0; right: 0; bottom: 0; height: 150px; padding: 14px 16px;
    background-color: #4d5466; border-radius: 6px; font-size: 18px; color: #f1f6ff;
}

/* ---- the split layout: list | detail ---- */
/* a column: headings and filters, then the list filling the rest */
.left  { position: absolute; left: 0; top: 0; width: 548px; bottom: 0; display: flex; flex-direction: column; }
.left .heading, .left #worn, .left .chips { flex: 0 0 auto; }
#grid, #events, #sys-rows { flex: 1 1 0; height: auto; min-height: 0; }
.right {
    position: absolute; left: 564px; right: 0; top: 0; bottom: 0; padding: 14px 16px;
    background-color: #555d75; border-radius: 6px;
}
.chips { height: 44px; }
.chip {
    display: inline-block; height: 36px; line-height: 36px; padding: 0 16px; margin-right: 8px;
    font-size: 18px; color: #e9eef9; background-color: #6f7285; border-radius: 18px; cursor: pointer;
}
.chip:hover { background-color: #7d8197; }
.chip.active { background-color: #ead98f; color: #2e3140; }

/* Equipment: what each slot wears (click = that slot) */
#worn { height: 112px; }
.worn-line { height: 34px; line-height: 34px; padding: 0 12px; margin-bottom: 4px; font-size: 19px; border-radius: 6px; cursor: pointer; background-color: #616678; }
.worn-line.current { background-color: #73809e; }

/* the 3-per-row grid (scrolls) */
#grid { padding: 8px 0 8px 8px; background-color: #4d5466; border-radius: 6px; overflow-y: auto; }
.cell {
    position: relative; display: inline-block; width: 164px; height: 128px; margin: 0 8px 8px 0;
    background-color: #686f85; border: 2px #00000000; border-radius: 6px; text-align: center; cursor: pointer;
}
.cell:hover { background-color: #747c93; }
.cell.selected { background-color: #8088a4; border-color: #ffed7b; }
.cell-icon  { width: 60px; height: 60px; margin-top: 12px; }
.cell-name  { position: absolute; left: 4px; right: 4px; bottom: 10px; font-size: 17px; color: #ffffff; white-space: nowrap; overflow: hidden; }
.cell-badge { position: absolute; right: 8px; top: 6px; font-size: 18px; color: #fff9ba; }
.cell-worn  { position: absolute; left: 8px; top: 4px; font-size: 20px; color: #9ff0b4; }
.cell-lock  { position: absolute; left: 8px; bottom: 36px; width: 10px; height: 10px; border-radius: 2px; background-color: #ead98f; }

/* the selected entry */
#d-icon { width: 72px; height: 72px; float: left; margin-right: 14px; }
#d-name { height: 72px; line-height: 72px; font-size: 26px; color: #ffffff; }
#d-desc { clear: both; margin: 10px 0; font-size: 18px; color: #f1f6ff; }
#compare { margin-top: 10px; padding: 8px 10px; background-color: #4d5466; border-radius: 6px; }
.cmp { height: 28px; line-height: 28px; font-size: 17px; color: #ffffff; }
.cmp.head { color: #cad0e1; font-size: 15px; }
.c-label { display: inline-block; width: 120px; color: #cad0e1; }
.c-now   { display: inline-block; width: 110px; }
.c-with  { display: inline-block; width: 110px; }
.cmp.better .c-with { color: #9ff0b4; }
.cmp.worse .c-with  { color: #ff9c92; }
#d-note { margin-top: 10px; font-size: 16px; color: #ffd28f; }
#d-buttons { position: absolute; left: 16px; right: 16px; bottom: 14px; height: 44px; }
.dbtn {
    display: inline-block; min-width: 96px; height: 44px; line-height: 44px; padding: 0 12px; margin-right: 10px;
    font-size: 19px; color: #ffffff; background-color: #7bba94;
}
.dbtn:hover { background-color: #8cccaa; }
.dbtn.off { background-color: #7a7e92; color: #b4b8c6; }

/* ---- Events ---- */
#events { padding: 8px; background-color: #4d5466; border-radius: 6px; overflow-y: auto; }
.evrow { height: 46px; line-height: 46px; margin-bottom: 6px; padding: 0 14px; font-size: 19px; color: #ffffff; white-space: nowrap; overflow: hidden; }
.evrow.done { color: #a9adbd; }
.ev-sub { float: right; font-size: 15px; color: #cad0e1; }
#ev-kind  { font-size: 16px; color: #f9e9b1; }
#ev-title { margin-top: 6px; font-size: 26px; color: #ffffff; }
#ev-desc  { margin-top: 14px; font-size: 19px; color: #f1f6ff; }
.ev-link  { font-size: 18px; color: #e9eef9; margin-left: 10px; }

/* ---- System ---- */
#sys-rows { overflow-y: auto; }
.sysrow { height: 52px; line-height: 52px; margin-bottom: 8px; padding: 0 18px; font-size: 21px; color: #ffffff; }
.rsub { float: right; font-size: 16px; color: #cad0e1; }
#sys-header { font-size: 26px; color: #f9e9b1; }
#sys-sub { margin-top: 4px; font-size: 17px; color: #cad0e1; }
#sys-list { margin-top: 12px; height: 500px; overflow-y: auto; }
#sys-list .row { height: 46px; line-height: 46px; margin-bottom: 8px; padding: 0 14px; font-size: 19px; color: #ffffff; }
#sys-list.compact .row { height: 36px; line-height: 36px; margin-bottom: 4px; font-size: 18px; }
.section { margin: 6px 0 4px 4px; font-size: 16px; color: #f9e9b1; }
#sys-back { position: absolute; right: 16px; bottom: 14px; width: 120px; height: 42px; line-height: 42px; font-size: 18px; }

/* ---- confirm dialogs ---- */
/* in the middle of the canvas, whatever its shape (on the 1024 x 768 canvas: x 232, y 279) */
.confirm  { position: absolute; left: 50%; top: 50%; margin-left: -280px; margin-top: -105px; width: 560px; height: 210px; text-align: center; }
.confirm.with-body { margin-top: -130px; height: 260px; }
.question { margin-top: 50px; padding: 0 20px; font-size: 25px; color: #f9e9b1; }
.confirm.with-body .question { margin-top: 30px; }
.body     { margin-top: 10px; font-size: 18px; color: #cad0e1; }
.answers  { position: absolute; left: 0; right: 0; bottom: 26px; }
.answer   { display: inline-block; width: 160px; height: 52px; line-height: 52px; margin: 0 20px; text-align: center; font-size: 20px; color: #ffffff; }

/* ---- portrait: the panel fills the screen; each page's two columns are stacked (the list above, the detail below) ---- */
@media (orientation: portrait) {
    #panel  { left: 12px; right: 12px; margin-left: 0; width: auto; top: 12px; bottom: 12px; height: auto; }
    .tab    { padding: 0 14px; margin-right: 6px; font-size: 20px; }
    /* Status: one column. The stats take the height they need; the attributes the rest: their heading, the list
       (scrolling when it must), Confirm / Reset, the description. */
    .page.status { display: flex; flex-direction: column; }
    #st-left  { position: relative; left: auto; top: auto; bottom: auto; width: auto; flex: 0 0 auto; padding: 0 8px 12px 8px; }
    #st-right { position: relative; left: auto; right: auto; top: auto; bottom: auto; flex: 1 1 0; min-height: 0;
                padding: 0 8px; display: flex; flex-direction: column; }
    #st-right .heading, #attr-actions { flex: 0 0 auto; }
    #attrs    { flex: 1 1 0; min-height: 0; max-height: none; overflow-y: auto; }
    #attr-desc { position: relative; left: auto; right: auto; bottom: auto; flex: 0 0 auto; height: 140px; margin-top: 10px; }
    /* the lists over their detail */
    .left   { width: auto; right: 0; bottom: 47%; }
    .right  { left: 0; top: 55%; }
    .cell   { width: 152px; }
    .confirm { width: 600px; margin-left: -300px; }
}

/* a short portrait screen (3:4): the stats scroll in a fixed share, so the six attributes still show */
@media (orientation: portrait) and (max-height: 1299px) {
    #st-left { flex: 0 0 auto; height: 360px; overflow-y: auto; }
}
