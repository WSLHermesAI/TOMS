    "play": { "kind": "freeTap", "timeMs": 2000, "hitDamage": 0.4 },
    "demo": [ { "at": 0, "do": "name", "ms": 700 }, { "at": 0, "do": "fx", "fx": "staff_great", "on": "player" }, { "at": 600, "do": "dim" } ],
    "step": [ { "do": "fx", "fx": "staff_perfect" } ],
    "finish": [ { "at": 0, "do": "shake", "value": 5, "ms": 300 } ]
  },
  "star_seal": {
    "_comment": "The staff's ultimate (the owner, 2026-11-20; docs/gameplay/22 §4.1): the pentagram shown by particles, then traced in 6 s; big, in the middle of the screen, with its own stronger effects (seal_*; the owner, 2026-11-25). Then the shared rundown: the hero's introduction, then the attack. 5 of 5: the star drawn again, 10 falling stars, a last burst; 3 or 4: 4 hits; fewer: it fizzles.",
    "name": "skill.star_seal",
    "weapon": "staff",
    "use": "ultimate",
    "prompt": "skill.prompt_draw",
    "damage": 10,
    "play": { "around": "center",
      "kind": "drawShape",
      "minHits": 3,
      "shape": "pentagram",
      "timeMs": 6000,
      "size": 360,
      "cornerRadius": 60
    },
    "demo": [
      {
        "at": 0,
        "do": "pathFx",
        "shape": "pentagram",
        "fx": "seal_trail",
        "corner": "seal_corner",
        "ms": 2000
      },
      {
        "at": 2100,
        "do": "dim"
      },
      {
        "at": 2100,
        "do": "countdown"
      }
    ],
    "step": [
      {
        "do": "fx",
        "fx": "seal_step"
      },
      {
        "do": "count"
      }
    ],
    "finish": [
      { "at": 0, "do": "intro", "text": "battle.ultimate_label", "ms": 1700, "when": "landed" },
      { "at": 0, "do": "camera", "zoom": 1.45, "on": "player", "ms": 1700, "move": "low", "deg": 12, "value": 0.85, "when": "landed" },
      { "at": 0, "do": "clip", "clip": "charge", "speed": 0.75, "when": "landed" },
      { "at": 0, "do": "fx", "fx": "seal_great", "on": "player", "when": "landed" },
      { "at": 0, "do": "sound", "fx": "sfx.boss_intro", "when": "landed" },
      { "at": 900, "do": "fx", "fx": "seal_great", "on": "player", "when": "landed" },
      { "at": 900, "do": "sound", "fx": "sfx.magic_cast", "when": "landed" },
      { "at": 1800, "do": "camera", "zoom": 1.12, "on": "player", "ms": 2100, "when": "full" },
      { "at": 1800, "do": "dim", "ms": 1800, "when": "full" },
      { "at": 1800, "do": "pathFx", "shape": "pentagram", "fx": "seal_trail", "corner": "seal_corner", "ms": 700, "when": "full" },
      { "at": 1800, "do": "fx", "fx": "seal_great", "on": "player", "when": "full" },
      { "at": 2300, "do": "hits", "count": 10, "gapMs": 110, "clip": "attack", "speed": 3, "fx": "staff_great",
        "projectile": "seal_meteor", "impact": "seal_impact", "flightMs": 320, "when": "full" },
      { "at": 2600, "do": "shake", "value": 7, "ms": 1200, "when": "full" },
      { "at": 3700, "do": "clip", "clip": "attack_big", "when": "full" },
      { "at": 3800, "do": "fx", "fx": "seal_finale", "on": "monster", "when": "full" },
      { "at": 3800, "do": "fx", "fx": "seal_impact", "on": "monster", "when": "full" },
      { "at": 3800, "do": "shake", "value": 13, "ms": 450, "when": "full" },
      { "at": 3800, "do": "sound", "fx": "sfx.explosion", "when": "full" },
      { "at": 1800, "do": "banner", "text": "skill.ultimate_partial", "ms": 800, "when": "partial" },
      { "at": 1800, "do": "hits", "count": 4, "gapMs": 160, "clip": "attack", "speed": 2.5, "fx": "staff_great", "impact": "seal_impact", "when": "partial" },
      { "at": 1800, "do": "fx", "fx": "seal_great", "on": "player", "when": "partial" },
      { "at": 1850, "do": "shake", "value": 4, "ms": 700, "when": "partial" }
    ]
  },
