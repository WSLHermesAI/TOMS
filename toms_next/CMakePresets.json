{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ]
        }
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug (game + editor)",
      "description": "Debug build of toms_game and toms_editor (the editor needs Qt 6 MSVC 64-bit).",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release (game + editor)",
      "description": "Optimized build with debug info; use this for day-to-day play testing.",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-shipping",
      "displayName": "Windows x64 Shipping (game only, no Qt)",
      "description": "What ships: toms_game only. Qt is not searched for.",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TOMS_BUILD_EDITOR": "OFF"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI (no popups)",
      "inherits": "windows-release",
      "cacheVariables": {
        "TOMS_POPUP_WARNINGS": "OFF"
      }
    },
    {
      "name": "web-debug",
      "displayName": "Web/WASM Debug (WSL/Linux)",
      "description": "Emscripten/wasm32 from $env{EMSDK}. Signed-off on WSL2: configure OK, 364/422 objects incl. shaderc.js link.",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_CROSSCOMPILING_EMULATOR": "node",
        "CMAKE_EXECUTABLE_SUFFIX": ".js",
        "WEB": "ON",
        "CMAKE_C_FLAGS": "-msimd128",
        "CMAKE_CXX_FLAGS": "-msimd128",
        "CMAKE_EXE_LINKER_FLAGS": "-msimd128",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "web-release",
      "displayName": "Web/WASM Release (WSL/Linux)",
      "description": "Emscripten/wasm32 from $env{EMSDK}. Build with --parallel 2 on a 16 GB box (see the progress entry) -- -j16 SIGKILLs on glslang/tint.",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_CROSSCOMPILING_EMULATOR": "node",
        "CMAKE_EXECUTABLE_SUFFIX": ".js",
        "WEB": "ON",
        "CMAKE_C_FLAGS": "-msimd128",
        "CMAKE_CXX_FLAGS": "-msimd128",
        "CMAKE_EXE_LINKER_FLAGS": "-msimd128",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "web-debug-windows",
      "displayName": "Web/WASM Debug (Windows)",
      "description": "Emscripten/wasm32 from $env{EMSDK} (D:\\Work\\emsdk). Run emsdk_env first so EMSDK is set. Same flags as the WSL presets -- -msimd128 is required on every host.",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_CROSSCOMPILING_EMULATOR": "node",
        "CMAKE_EXECUTABLE_SUFFIX": ".js",
        "WEB": "ON",
        "CMAKE_C_FLAGS": "-msimd128",
        "CMAKE_CXX_FLAGS": "-msimd128",
        "CMAKE_EXE_LINKER_FLAGS": "-msimd128",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web-debug-windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "web-release-windows",
      "displayName": "Web/WASM Release (Windows)",
      "description": "Emscripten/wasm32 from $env{EMSDK} (D:\\Work\\emsdk). Run emsdk_env first so EMSDK is set. Same flags as the WSL presets; the host-specific difference is the job count in the build preset.",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_CROSSCOMPILING_EMULATOR": "node",
        "CMAKE_EXECUTABLE_SUFFIX": ".js",
        "WEB": "ON",
        "CMAKE_C_FLAGS": "-msimd128",
        "CMAKE_CXX_FLAGS": "-msimd128",
        "CMAKE_EXE_LINKER_FLAGS": "-msimd128",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web-release-windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-shipping",
      "configurePreset": "windows-shipping"
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows"
    },
    {
      "name": "web-debug",
      "configurePreset": "web-debug",
      "jobs": 2
    },
    {
      "name": "web-release",
      "configurePreset": "web-release",
      "jobs": 2
    },
    {
      "name": "web-debug-windows",
      "configurePreset": "web-debug-windows",
      "jobs": 8
    },
    {
      "name": "web-release-windows",
      "configurePreset": "web-release-windows",
      "jobs": 8
    }
  ]
}