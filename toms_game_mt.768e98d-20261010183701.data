{
  "animations": [],
  "embedded": true,
  "name": "game",
  "output": {
    "dir": ".",
    "formats": [
      "atlas",
      "plist"
    ]
  },
  "references": [
    {
      "path": "../sprites",
      "prefix": "",
      "recursive": false
    }
  ],
  "settings": {
    "alphaThreshold": 0,
    "border": 0,
    "dedupe": true,
    "defaultPivot": [
      0.5,
      0.5
    ],
    "extrude": 1,
    "filter": "Nearest",
    "fixedSize": false,
    "heuristic": "auto",
    "maxHeight": 2048,
    "maxWidth": 2048,
    "minHeight": 16,
    "minWidth": 16,
    "padding": 2,
    "powerOfTwo": false,
    "premultiplyAlpha": false,
    "square": false,
    "trim": false
  },
  "sprites": [],
  "variants": [
    {
      "id": "dark16",
      "images": [
        "bat",
        "boss_demonlord",
        "coin",
        "demon",
