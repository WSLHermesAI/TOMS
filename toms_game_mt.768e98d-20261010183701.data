/* battle.rcss -- the battle screen (battle.rml). Laid out 1.4x larger than the map UI so it
   reads well on phones (the old screen's "battle scale"). */
body { z-index: 30; }

#title  { position: absolute; left: 262px; top: 14px; font-size: 38px; color: #ffcaa8; }
#player { position: absolute; left: 262px; top: 84px; width: 134px; height: 134px; }
#enemy  { position: absolute; left: 652px; top: 84px; width: 134px; height: 134px; }

.hp      { position: absolute; top: 238px; width: 280px; height: 22px; background-color: #7b7b88; }
#player-hp { left: 262px; }
#enemy-hp  { left: 652px; }
.fill-bar { height: 100%; }
.fill-bar.good  { background-color: #94f3a8; }
.fill-bar.bad   { background-color: #f39494; }
.fill-bar.clock { background-color: #edb17b; }
.hp-text { position: absolute; top: 262px; font-size: 22px; color: #ffffff; white-space: nowrap; }
#player-hp-text { left: 262px; }
#enemy-hp-text  { left: 652px; }

#log { position: absolute; left: 262px; right: 24px; top: 294px; font-size: 22px; color: #ffffff; }
#continue { position: absolute; left: 262px; top: 340px; font-size: 24px; color: #ffffca; }

#clock-label { position: absolute; left: 262px; top: 324px; font-size: 19px; color: #f3e0ba; }
#clock { position: absolute; left: 262px; top: 348px; width: 700px; height: 14px; background-color: #7b7b88; }

/* Attack / defence columns: prompt, the five-zone timing bar with its marker, the action button. */
.column { position: absolute; top: 372px; width: 322px; }
#attack  { left: 262px; }
#defense { left: 640px; }
.prompt  { font-size: 20px; color: #f3f3ff; height: 30px; }
.power   { position: relative; height: 28px; }
.zones   { display: flex; height: 100%; }
.zone        { height: 100%; }
.zone.red    { background-color: #e08888; }
.zone.blue   { background-color: #94b1ed; }
.zone.green  { background-color: #94e6a8; }
.bar-dim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #41414c8c; }
.marker  { position: absolute; top: -8px; width: 5px; height: 44px; margin-left: -2px; background-color: #ffffff; }
.action {
    margin-top: 18px; height: 62px; line-height: 62px; font-size: 21px; color: #ffffff;
    background-color: #8598b3; text-align: left; padding-left: 18px;
}
.action:hover   { background-color: #97aac5; }
.action:active  { background-color: #a9bcd6; }
.action.cooling { background-color: #6f7580; }
.note        { margin-top: 8px; font-size: 19px; color: #cacfd9; }
.note.shield { color: #c2e0ff; }
.note.crit   { color: #ffed94; }

#super { position: absolute; left: 262px; top: 530px; height: 24px; }
#super-label { font-size: 19px; color: #f3f3ff; margin-right: 18px; }
.dot-slot { display: inline-block; }
.dot { width: 17px; height: 17px; margin-right: 8px; background-color: #7b7b88; }
.dot.on { background-color: #ffca88; }

.wide { position: absolute; left: 262px; width: 700px; height: 50px; line-height: 50px; font-size: 22px; color: #ffffff; }
#super-btn  { top: 562px; background-color: #d9887b; }
#super-btn:hover  { background-color: #e89a8d; }
#active-btn { top: 624px; background-color: #88c2d2; }
#active-btn:hover { background-color: #9ad2e2; }
<rml>
<head>
    <title>Battle</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="_atlas.rcss"/>
    <link type="text/rcss" href="battle.rcss"/>
</head>
<!-- Battle v2: the attack and defence bars run on their own; tap a button to strike or guard at
     the marker's current zone. Super and the equipment active appear only when usable.
     After a win, a tap anywhere continues. Data: battle.* (UiBattle). -->
<body data-model="game" data-event-click="act('battle_continue')">
    <div class="fill focus"></div>
    <div id="title">{{battle.title}}</div>
    <img id="player" data-attr-sprite="battle.player_sprite"/>
    <img id="enemy" data-attr-sprite="battle.enemy_sprite"/>

    <div id="player-hp" class="hp"><div class="fill-bar good" data-style-width="battle.player_hp_pct + '%'"></div></div>
    <div id="player-hp-text" class="hp-text">{{battle.player_hp_text}}</div>
    <div id="enemy-hp" class="hp"><div class="fill-bar bad" data-style-width="battle.enemy_hp_pct + '%'"></div></div>
    <div id="enemy-hp-text" class="hp-text">{{battle.enemy_hp_text}}</div>
    <div id="log">{{battle.log}}</div>

    <div data-if="battle.active">
        <div id="clock-label">{{battle.clock_label}}</div>
        <div id="clock"><div class="fill-bar clock" data-style-width="battle.clock_pct + '%'"></div></div>

        <div id="attack" class="column">
            <div class="prompt">{{battle.attack.prompt}}</div>
            <div class="power">
                <div class="zones">
                    <div class="zone red" data-style-width="battle.attack.red_l + '%'"></div>
                    <div class="zone blue" data-style-width="battle.attack.blue_l + '%'"></div>
                    <div class="zone green" data-style-width="battle.attack.green + '%'"></div>
                    <div class="zone blue" data-style-width="battle.attack.blue_r + '%'"></div>
                    <div class="zone red" data-style-width="battle.attack.red_r + '%'"></div>
                </div>
                <div class="bar-dim" data-visible="battle.attack.cooling"></div>
                <div class="marker" data-style-left="battle.attack.marker + '%'"></div>
            </div>
            <div class="action btn" data-class-cooling="battle.attack.cooling"
                 data-event-click="act('battle_attack')">{{battle.attack.button_label}}</div>
            <div class="note crit" data-if="battle.crit_armed">{{battle.crit_hint}}</div>
        </div>

        <div id="defense" class="column">
            <div class="prompt">{{battle.defense.prompt}}</div>
            <div class="power">
                <div class="zones">
                    <div class="zone red" data-style-width="battle.defense.red_l + '%'"></div>
                    <div class="zone blue" data-style-width="battle.defense.blue_l + '%'"></div>
                    <div class="zone green" data-style-width="battle.defense.green + '%'"></div>
                    <div class="zone blue" data-style-width="battle.defense.blue_r + '%'"></div>
                    <div class="zone red" data-style-width="battle.defense.red_r + '%'"></div>
                </div>
                <div class="bar-dim" data-visible="battle.defense.cooling"></div>
                <div class="marker" data-style-left="battle.defense.marker + '%'"></div>
            </div>
            <div class="action btn" data-class-cooling="battle.defense.cooling"
                 data-event-click="act('battle_defend')">{{battle.defense.button_label}}</div>
            <div class="note" data-class-shield="battle.shield_armed">{{battle.shield_text}}</div>
        </div>

        <div id="super">
            <span id="super-label">{{battle.super_label}}</span>
            <div class="dot-slot" data-for="d : battle.super_dots"><div class="dot" data-class-on="d == 1"></div></div>
        </div>
        <div id="super-btn" class="wide btn" data-if="battle.super_ready"
             data-event-click="act('battle_super')">{{battle.super_button}}</div>
        <div id="active-btn" class="wide btn" data-if="battle.active_ready"
             data-event-click="act('battle_active')">{{battle.active_button}}</div>
    </div>
    <div id="continue" data-if="!battle.active">{{battle.continue_hint}}</div>
</body>
</rml>
/* common.rcss -- shared by every screen in this folder (see docs/08_RMLUI.md).

   Units: every document is laid out in the game's 1024x768 design space, so px here are design
   pixels (the game scales the whole UI to the window, letterboxed like the map).
   Colours: what you write is what you see (the renderer converts for the sRGB screen).
   Data: every document binds the "game" model -- src/core/game/ui/ui_state.h lists all values;
   buttons call act('<event>', arg), handled in src/core/game/core/game_ui.cpp (Game::uiEvent).
   Edit and press F5 in the game to reload; F8 opens RmlUi's debugger. */

/* RmlUi has no default stylesheet: every element starts inline. */
body, div, p { display: block; }
span, em, strong { display: inline; }
img { display: inline-block; }

body {
    position: absolute; left: 0; top: 0; width: 100%; height: 100%;
    font-family: toms;
    font-size: 18px;
    color: #eef1f8;
}

/* ---- palette ---- */
.gold  { color: #f9e9b1; }
.dim   { color: #cad0e1; }
.white { color: #ffffff; }

/* ---- full-screen layers ---- */
.fill  { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.scrim { background-color: #0000009e; }          /* dims whatever is behind a dialog */
.focus { background-color: #000000cc; }          /* battle / dialogue / inventory backdrop */

/* ---- panels and dialogs ---- */
.panel {
    background-color: #65687dfa;
    border-top: 3px #eddc9e;
    border-radius: 8px;
}
.center-x { margin-left: auto; margin-right: auto; }

/* ---- buttons ---- */
.btn {
    cursor: pointer;
    text-align: center;
    border-radius: 6px;
    transition: background-color 0.1s cubic-out;
}
.btn-yes   { background-color: #7bba94; color: #ffffff; }
.btn-yes:hover   { background-color: #8cccaa; }
.btn-no    { background-color: #ba7b7b; color: #ffffff; }
.btn-no:hover    { background-color: #cc8c8c; }
.btn-plain { background-color: #8f8f9c; color: #ffffff; }
.btn-plain:hover { background-color: #a2a2b0; }

/* A list row / menu button: dark panel, lighter when selected (keyboard) or hovered (mouse). */
.row {
    cursor: pointer;
    background-color: #6f7285f5;
    border-radius: 6px;
    transition: background-color 0.1s cubic-out;
}
.row:hover, .row.selected { background-color: #8594b0; }
.row.disabled { color: #9fa3b3; }
.row.disabled:hover, .row.disabled.selected { background-color: #7a7e92; }

/* Scrollbars of lists with overflow-y: auto (inventory, menu, stage select). */
scrollbarvertical { width: 10px; }
scrollbarvertical slidertrack { background-color: #00000040; }
scrollbarvertical sliderbar { background-color: #cad0e1a0; border-radius: 4px; }

@keyframes pulse {
    from { opacity: 0.55; }
    to   { opacity: 1.0; }
}
/* dialogs.rcss -- the small popups (dialogs.rml). */
body { z-index: 50; }

#stairs-dim { background-color: #0000008c; }
#unlock-dim { background-color: #00000080; }

.box { position: absolute; background-color: #616f8af7; border-radius: 6px; }
.question { position: absolute; left: 30px; right: 30px; top: 28px; font-size: 26px; color: #fff9ca; }
.body     { position: absolute; left: 30px; right: 30px; top: 76px; font-size: 18px; color: #ffffff; }
.btn      { height: 40px; line-height: 40px; font-size: 18px; }

#stairs { left: 322px; top: 304px; width: 380px; height: 160px; }
#stairs .answers { position: absolute; left: 50px; bottom: 24px; }
#stairs .answers .btn { display: inline-block; width: 130px; margin-right: 20px; }

#unlock { left: 302px; top: 294px; width: 420px; height: 180px; }
#unlock .question { color: #fff3ba; }
#unlock-ok { position: absolute; right: 24px; bottom: 20px; width: 120px; }
<rml>
<head>
    <title>Dialogs</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="dialogs.rcss"/>
</head>
<!-- Small yes/no and OK popups: "go up/down the stairs?" (stairs.*) and "the store is open!"
     (store.unlocked_*). -->
<body data-model="game">
    <div data-if="stairs.visible">
        <div class="fill" id="stairs-dim"></div>
        <div id="stairs" class="box">
            <div class="question">{{stairs.question}}</div>
            <div class="answers">
                <div class="btn btn-yes" data-event-click="act('stairs', 1)">{{stairs.yes_label}}</div>
                <div class="btn btn-no" data-event-click="act('stairs', 0)">{{stairs.no_label}}</div>
            </div>
        </div>
    </div>

    <div data-if="store.unlocked_dialog">
        <div class="fill" id="unlock-dim"></div>
        <div id="unlock" class="box">
            <div class="question">{{store.unlocked_title}}</div>
            <div class="body">{{store.unlocked_body}}</div>
            <div id="unlock-ok" class="btn btn-yes" data-event-click="act('store_unlocked_ok')">{{store.unlocked_ok}}</div>
        </div>
    </div>
</body>
</rml>
/* dialogue.rcss -- the dialogue box (dialogue.rml). Anchored to the bottom and grows upward with
   the number of choices; on phones it scales up about its bottom edge (Game::setUiScale). */
body { z-index: 30; }

#box {
    position: absolute; left: 40px; right: 40px; bottom: 30px; min-height: 238px;
    padding: 26px 40px 24px 44px;
    background-color: #5a617bf2; border-radius: 6px;
    transform-origin: 50% 100%;
    cursor: pointer;
}
#text { font-size: 32px; line-height: 44px; color: #ffffff; margin-bottom: 14px; }

.choice {
    font-size: 28px; line-height: 40px; color: #fff3ba;
    padding-left: 8px; border-radius: 4px;
}
.choice .arrow { visibility: hidden; margin-right: 10px; }
.choice:hover, .choice.selected { color: #ffffca; background-color: #ffffff18; }
.choice.selected .arrow { visibility: visible; }
<rml>
<head>
    <title>Dialogue</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="dialogue.rcss"/>
</head>
<!-- An NPC conversation: the line, then its choices. Click a choice to pick it; a click
     elsewhere on the box continues with the highlighted one. Data: dialogue.* (UiDialogue). -->
<body data-model="game">
    <div class="fill focus"></div>
    <div id="box" data-style-transform="'scale(' + dialogue.scale + ')'" data-style-left="dialogue.side + 'px'"
         data-style-right="dialogue.side + 'px'" data-event-click="act('dlg_advance')">
        <div id="text">{{dialogue.text}}</div>
        <div data-for="c, i : dialogue.choices">
            <div class="choice" data-class-selected="c.selected"
                 data-event-click="act('dlg_choose', i)" data-event-mouseover="act('dlg_hover', i)">
                <span class="arrow">â–¶</span>{{c.label}}
            </div>
        </div>
    </div>
</body>
</rml>
/* ending.rcss -- the ending screen (ending.rml). */
body { z-index: 70; background-color: #3b3b4c; text-align: center; }

#name { position: absolute; left: 0; right: 0; top: 246px; font-size: 37px; color: #f9e9b1; }
#text { position: absolute; left: 80px; right: 80px; top: 312px; font-size: 21px; line-height: 32px; color: #ffffff; }
#buttons { position: absolute; left: 0; right: 0; top: 658px; }
#buttons .btn { display: inline-block; width: 220px; height: 48px; line-height: 48px; margin: 0 15px; font-size: 21px; color: #ffffff; }
.rebirth  { background-color: #c2947b; }
.rebirth:hover  { background-color: #d2a48b; }
.to-title { background-color: #7b859c; }
.to-title:hover { background-color: #8b95ac; }
#hint { position: absolute; left: 0; right: 0; top: 704px; font-size: 17px; color: #cdd2e0; }
<rml>
<head>
    <title>Ending</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="ending.rcss"/>
</head>
<!-- The ending: its name and text, then either Rebirth / Back to title, or "tap to continue".
     Data: ending.* (UiEnding). -->
<body data-model="game" data-event-click="act('ending_dismiss')">
    <div id="name">{{ending.name}}</div>
    <div id="text">{{ending.text}}</div>
    <div id="buttons" data-if="ending.rebirth">
        <div class="btn rebirth" data-event-click="act('ending_rebirth')">{{ending.rebirth_label}}</div>
        <div class="btn to-title" data-event-click="act('ending_title')">{{ending.title_label}}</div>
    </div>
    <div id="hint" data-if="!ending.rebirth">{{ending.hint}}</div>
</body>
</rml>
/* hud.rcss -- the walking-scene HUD (hud.rml). */
body { z-index: 10; pointer-events: none; }     /* clicks go through to the map ... */
.click { pointer-events: auto; cursor: pointer; } /* ... except on these */

#title-line { position: absolute; left: 16px; top: 12px; font-size: 25px; color: #ffffff; }
#hp-bar  { position: absolute; left: 16px; top: 46px; width: 200px; height: 14px; background-color: #7b7b88; }
#hp-fill { height: 100%; background-color: #f37b7b; }
#hp-text { position: absolute; left: 226px; top: 40px; font-size: 21px; color: #ffffff; }
#stats   { position: absolute; left: 16px; top: 64px; font-size: 21px; color: #ffffff; }
#res     { position: absolute; left: 16px; top: 88px; font-size: 18px; color: #ffffff; }

/* The one button (â‰¡), top right: big enough for a thumb. The dot = something new inside. */
.icon {
    position: absolute; top: 10px; width: 58px; height: 58px;
    background-color: #6f6f7b; border-radius: 8px; text-align: center;
}
.icon:hover { background-color: #85858f; }
#menu-btn { right: 10px; }
.glyph { font-size: 40px; line-height: 58px; color: #ffffff; }
.icon-label { position: absolute; left: -10px; right: -10px; top: 60px; font-size: 14px; color: #ffffff; }
#news { position: absolute; right: -4px; top: -4px; width: 14px; height: 14px; border-radius: 7px;
        background-color: #ff6b5e; border: 2px #fff6c2; }

/* Name plate over a boss / roaming monster: centred on its x, sitting on its y. */
.banner {
    position: absolute; transform: translate(-50%, -100%);
    padding: 1px 8px; font-size: 18px; color: #ffeec2;
    background-color: #474155c7; border-radius: 3px; white-space: nowrap;
}

/* The act card, shown for a moment when a new act begins. */
#chapter {
    position: absolute; left: 202px; top: 230px; width: 620px; height: 116px;
    background-color: #475168e0;
}
#chapter-title { position: absolute; left: 28px; top: 16px; font-size: 30px; color: #fff8d9; }
#chapter-sub   { position: absolute; left: 28px; top: 64px; font-size: 21px; color: #e9eef9; }
#chapter-rule  { position: absolute; left: 24px; right: 24px; bottom: 14px; height: 2px; background-color: #eddc9ee6; }

#footer { position: absolute; left: 16px; right: 16px; top: 736px; font-size: 18px; color: #e6edff; white-space: nowrap; }
<rml>
<head>
    <title>HUD</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="_atlas.rcss"/>
    <link type="text/rcss" href="hud.rcss"/>
</head>
<!-- Over the map while walking: floor name, HP, stats (click = inventory), the menu and store
     buttons, the story line at the bottom, the act card and the boss/roamer name plates.
     Only the buttons take clicks; everywhere else a click goes through to the map (walk there).
     Data: hud.* (UiHud). -->
<body data-model="game">
    <div id="title-line">{{hud.title_line}}</div>
    <div id="hp-bar"><div id="hp-fill" data-style-width="hud.hp_pct + '%'"></div></div>
    <div id="hp-text">{{hud.hp_text}}</div>
    <div id="stats">{{hud.stats_line}}</div>
    <div id="res">{{hud.res_line}}</div>

    <!-- The walking scene's one button: the player menu (Status, Equipment, Items, Events, System). -->
    <div id="menu-btn" class="icon click" data-event-click="act('hud_menu')">
        <div class="glyph">â‰¡</div>
        <div class="icon-label">{{hud.menu_label}}</div>
        <div id="news" data-if="hud.menu_news"></div>
    </div>

    <div data-for="b : hud.banners">
        <div class="banner" data-style-left="b.x + 'px'" data-style-top="b.y + 'px'">{{b.text}}</div>
    </div>

    <div id="chapter" data-if="hud.chapter_card" data-style-opacity="hud.chapter_alpha">
        <div id="chapter-title">{{hud.chapter_title}}</div>
        <div id="chapter-sub">{{hud.chapter_sub}}</div>
        <div id="chapter-rule"></div>
    </div>

    <div id="footer">{{hud.footer}}</div>
</body>
</rml>
/* overlay.rcss -- toasts and notifications (overlay.rml). */
body { z-index: 90; pointer-events: none; }

#notifications { position: absolute; right: 16px; top: 132px; width: 300px; }   /* below the HUD buttons */
.note {
    margin-bottom: 8px; padding: 8px 12px;
    font-size: 17px; color: #e6ffca; background-color: #61685ae6; border-radius: 4px;
}

#toast-row { position: absolute; left: 0; right: 0; top: 608px; text-align: center; }
#toast {
    display: inline-block; min-width: 236px; padding: 12px 24px;
    font-size: 21px; color: #ffe6e6; background-color: #a85a5af2; border-radius: 6px;
}
<rml>
<head>
    <title>Overlay</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="overlay.rcss"/>
</head>
<!-- Always on top, never takes clicks: the short toast (purchase, "not enough gold", "saved")
     and the notification stack (level up, floor events, ...). Data: overlay.* (UiOverlay). -->
<body data-model="game">
    <div id="notifications">
        <div class="note" data-for="n : overlay.notifications">{{n}}</div>
    </div>
    <div id="toast-row" data-if="overlay.toast"><span id="toast">{{overlay.toast_text}}</span></div>
</body>
</rml>
/* player.rcss -- the player menu (player.rml). Design space 1024x768, see common.rcss. */
body { z-index: 45; }

#panel { position: absolute; left: 16px; top: 12px; width: 992px; height: 744px; background-color: #5a6175f8; }
/* Chinese and Japanese have no spaces to break lines at: break a too-long run where it overflows. */
#panel, .confirm { word-break: break-word; }

.slot { display: inline-block; vertical-align: top; }   /* a data-for wrapper laid out in a row */

/* ---- tabs ---- */
#tabs { position: absolute; left: 16px; right: 16px; top: 10px; height: 52px; }
.tab {
    display: inline-block; height: 48px; line-height: 48px; padding: 0 22px; margin-right: 8px;
    font-size: 22px; color: #e9eef9; background-color: #6f7285; border-radius: 6px 6px 0 0; cursor: pointer;
}
.tab:hover { background-color: #7d8197; }
.tab.active { background-color: #8594b0; color: #fff6c2; }
.dot { display: inline-block; width: 10px; height: 10px; margin-left: 6px; border-radius: 5px; background-color: #ff6b5e; }
#close { position: absolute; right: 0; top: 0; width: 48px; height: 48px; line-height: 48px; font-size: 28px; }

.page { position: absolute; left: 16px; right: 16px; top: 68px; bottom: 34px; }
#hint { position: absolute; left: 20px; bottom: 8px; font-size: 15px; color: #cad0e1; }
.heading { margin: 10px 0 6px 0; font-size: 18px; color: #f9e9b1; }
.line { height: 30px; line-height: 30px; font-size: 19px; color: #ffffff; }
.l-label { display: inline-block; width: 120px; color: #cad0e1; }
.l-value { color: #ffffff; }
.gap { height: 10px; }
.empty { padding: 30px 10px; font-size: 19px; color: #e9f1ff; }
.hint-center { padding: 120px 20px 0 20px; text-align: center; font-size: 19px; color: #cad0e1; }

/* ---- Status ---- */
#st-left  { position: absolute; left: 8px; top: 0; width: 470px; bottom: 0; }
#st-right { position: absolute; left: 500px; right: 8px; top: 0; bottom: 0; }
#st-level { font-size: 34px; color: #fff6c2; margin-bottom: 8px; }
.bar { width: 300px; height: 14px; margin-top: 8px; background-color: #3d4252; border-radius: 4px; }
.fill-hp  { height: 100%; background-color: #f37b7b; border-radius: 4px; }
.fill-exp { height: 100%; background-color: #8fc7f5; border-radius: 4px; }
.bar-text { font-size: 17px; color: #e9eef9; }
#attrs { max-height: 380px; overflow-y: auto; }
.attr { height: 42px; line-height: 42px; margin-bottom: 6px; padding: 0 16px; font-size: 20px; color: #ffffff; }
.attr-value { float: right; color: #fff6c2; }
.attr-add { float: right; width: 30px; height: 30px; line-height: 30px; margin: 6px 0 0 12px; text-align: center;
            font-size: 22px; color: #2e3140; background-color: #9ff0b4; border-radius: 15px; }
.attr-add:hover { background-color: #b8f5c8; }
#attr-points { margin-left: 16px; font-size: 16px; color: #9ff0b4; }
.attr-eff { margin-top: 8px; font-size: 17px; color: #cfe7ff; }
.attr-eff.now { color: #9ff0b4; }
.attr-eff.hint { color: #ffd28f; font-size: 15px; }
#attr-desc {
    position: absolute; left: 0; right: 0; bottom: 0; height: 150px; padding: 14px 16px;
    background-color: #4d5466; border-radius: 6px; font-size: 18px; color: #f1f6ff;
}

/* ---- the split layout: list | detail ---- */
.left  { position: absolute; left: 0; top: 0; width: 548px; bottom: 0; }
.right {
    position: absolute; left: 564px; right: 0; top: 0; bottom: 0; padding: 14px 16px;
    background-color: #555d75; border-radius: 6px;
}
.chips { height: 44px; }
.chip {
    display: inline-block; height: 36px; line-height: 36px; padding: 0 16px; margin-right: 8px;
    font-size: 18px; color: #e9eef9; background-color: #6f7285; border-radius: 18px; cursor: pointer;
}
.chip:hover { background-color: #7d8197; }
.chip.active { background-color: #ead98f; color: #2e3140; }

/* Equipment: what each slot wears (click = that slot) */
#worn { height: 112px; }
.worn-line { height: 34px; line-height: 34px; padding: 0 12px; margin-bottom: 4px; font-size: 19px; border-radius: 6px; cursor: pointer; background-color: #616678; }
.worn-line.current { background-color: #73809e; }

/* the 3-per-row grid (scrolls) */
#grid { height: 586px; padding: 8px 0 8px 8px; background-color: #4d5466; border-radius: 6px; overflow-y: auto; }
#grid.short { height: 470px; }
.cell {
    position: relative; display: inline-block; width: 164px; height: 128px; margin: 0 8px 8px 0;
    background-color: #686f85; border: 2px #00000000; border-radius: 6px; text-align: center; cursor: pointer;
}
.cell:hover { background-color: #747c93; }
.cell.selected { background-color: #8088a4; border-color: #ffed7b; }
.cell-icon  { width: 60px; height: 60px; margin-top: 12px; }
.cell-name  { position: absolute; left: 4px; right: 4px; bottom: 10px; font-size: 17px; color: #ffffff; white-space: nowrap; overflow: hidden; }
.cell-badge { position: absolute; right: 8px; top: 6px; font-size: 18px; color: #fff9ba; }
.cell-worn  { position: absolute; left: 8px; top: 4px; font-size: 20px; color: #9ff0b4; }
.cell-lock  { position: absolute; left: 8px; bottom: 36px; width: 10px; height: 10px; border-radius: 2px; background-color: #ead98f; }

/* the selected entry */
#d-icon { width: 72px; height: 72px; float: left; margin-right: 14px; }
#d-name { height: 72px; line-height: 72px; font-size: 26px; color: #ffffff; }
#d-desc { clear: both; margin: 10px 0; font-size: 18px; color: #f1f6ff; }
#compare { margin-top: 10px; padding: 8px 10px; background-color: #4d5466; border-radius: 6px; }
.cmp { height: 28px; line-height: 28px; font-size: 17px; color: #ffffff; }
.cmp.head { color: #cad0e1; font-size: 15px; }
.c-label { display: inline-block; width: 120px; color: #cad0e1; }
.c-now   { display: inline-block; width: 110px; }
.c-with  { display: inline-block; width: 110px; }
.cmp.better .c-with { color: #9ff0b4; }
.cmp.worse .c-with  { color: #ff9c92; }
#d-note { margin-top: 10px; font-size: 16px; color: #ffd28f; }
#d-buttons { position: absolute; left: 16px; right: 16px; bottom: 14px; height: 44px; }
.dbtn {
    display: inline-block; min-width: 96px; height: 44px; line-height: 44px; padding: 0 12px; margin-right: 10px;
    font-size: 19px; color: #ffffff; background-color: #7bba94;
}
.dbtn:hover { background-color: #8cccaa; }
.dbtn.off { background-color: #7a7e92; color: #b4b8c6; }

/* ---- Events ---- */
#events { height: 586px; padding: 8px; background-color: #4d5466; border-radius: 6px; overflow-y: auto; }
.evrow { height: 46px; line-height: 46px; margin-bottom: 6px; padding: 0 14px; font-size: 19px; color: #ffffff; white-space: nowrap; overflow: hidden; }
.evrow.done { color: #a9adbd; }
.ev-sub { float: right; font-size: 15px; color: #cad0e1; }
#ev-kind  { font-size: 16px; color: #f9e9b1; }
#ev-title { margin-top: 6px; font-size: 26px; color: #ffffff; }
#ev-desc  { margin-top: 14px; font-size: 19px; color: #f1f6ff; }
.ev-link  { font-size: 18px; color: #e9eef9; margin-left: 10px; }

/* ---- System ---- */
#sys-rows { height: 630px; overflow-y: auto; }
.sysrow { height: 52px; line-height: 52px; margin-bottom: 8px; padding: 0 18px; font-size: 21px; color: #ffffff; }
.rsub { float: right; font-size: 16px; color: #cad0e1; }
#sys-header { font-size: 26px; color: #f9e9b1; }
#sys-sub { margin-top: 4px; font-size: 17px; color: #cad0e1; }
#sys-list { margin-top: 12px; height: 500px; overflow-y: auto; }
#sys-list .row { height: 46px; line-height: 46px; margin-bottom: 8px; padding: 0 14px; font-size: 19px; color: #ffffff; }
#sys-list.compact .row { height: 36px; line-height: 36px; margin-bottom: 4px; font-size: 18px; }
.section { margin: 6px 0 4px 4px; font-size: 16px; color: #f9e9b1; }
#sys-back { position: absolute; right: 16px; bottom: 14px; width: 120px; height: 42px; line-height: 42px; font-size: 18px; }

/* ---- confirm dialogs ---- */
.confirm  { position: absolute; left: 232px; top: 279px; width: 560px; height: 210px; text-align: center; }
.confirm.with-body { top: 254px; height: 260px; }
.question { margin-top: 50px; padding: 0 20px; font-size: 25px; color: #f9e9b1; }
.confirm.with-body .question { margin-top: 30px; }
.body     { margin-top: 10px; font-size: 18px; color: #cad0e1; }
.answers  { position: absolute; left: 0; right: 0; bottom: 26px; }
.answer   { display: inline-block; width: 160px; height: 52px; line-height: 52px; margin: 0 20px; text-align: center; font-size: 20px; color: #ffffff; }
<rml>
<head>
    <title>Player menu</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="_atlas.rcss"/>
    <link type="text/rcss" href="player.rcss"/>
</head>
<!-- The player menu (docs/20_PLAYER_MENU.md): the walking scene's one button (â‰¡ / Esc) opens it.
     Tabs: Status, Equipment, Items, Events, System. Equipment, Items, Events and System share one
     layout: a list on the left (Items and Equipment: a grid of 3 per row), the selected entry on the
     right. Data: player.* (UiPlayer); the System tab's rows and pages are menu.* (UiMenu).
     Buttons: act('pm_*', n) -> Game::playerMenuEvent; the System tab's page rows use menu_row.
     Every data-for sits on a wrapper with the bindings on the element inside: when a list shrinks,
     RmlUi removes the extra rows first (bindings on the data-for element itself can be read before
     that and log "Data array index out of bounds"). -->
<body data-model="game">
    <div class="fill scrim"></div>
    <div id="panel" class="panel">
        <div id="tabs">
            <div class="slot" data-for="t, i : player.tabs"><div class="tab" data-class-active="t.active" data-event-click="act('pm_tab', i)">{{t.label}}<span class="dot" data-if="t.news"></span></div></div>
            <div id="close" class="btn btn-plain" data-event-click="act('pm_close')">Ã—</div>
        </div>

        <!-- ===== Status ===== -->
        <div class="page" data-if="player.tab == 0">
            <div id="st-left">
                <div id="st-level">{{player.level}}</div>
                <div class="bar"><div class="fill-hp" data-style-width="player.hp_pct + '%'"></div></div>
                <div class="bar-text">{{player.hp_text}}</div>
                <div class="bar"><div class="fill-exp" data-style-width="player.exp_pct + '%'"></div></div>
                <div class="bar-text">{{player.exp_text}}</div>
                <div class="heading">{{player.combat_title}}</div>
                <div data-for="l : player.combat"><div class="line"><span class="l-label">{{l.label}}</span><span class="l-value">{{l.value}}</span></div></div>
                <div class="gap"></div>
                <div data-for="l : player.more"><div class="line"><span class="l-label">{{l.label}}</span><span class="l-value">{{l.value}}</span></div></div>
            </div>
            <div id="st-right">
                <div class="heading">{{player.attr_title}}<span id="attr-points" data-if="player.attr_points != ''">{{player.attr_points}}</span></div>
                <div id="attrs">
                    <div data-for="a, i : player.attrs"><div class="row attr" data-class-selected="a.selected" data-event-click="act('pm_attr', i)">{{a.label}}<span class="attr-add btn" data-if="player.attr_can_add" data-event-click="act('pm_attr_add', i)">+</span><span class="attr-value">{{a.sub}}</span></div></div>
                </div>
                <div id="attr-desc">{{player.attr_desc}}
                    <div class="attr-eff" data-if="player.attr_per != ''">{{player.attr_per}}</div>
                    <div class="attr-eff now" data-if="player.attr_now != ''">{{player.attr_now}}</div>
                    <div class="attr-eff hint" data-if="player.attr_points_hint != ''">{{player.attr_points_hint}}</div>
                </div>
            </div>
        </div>

        <!-- ===== Equipment / Items: filter chips + a 3-per-row grid | the selected entry ===== -->
        <div class="page" data-if="player.tab == 1 || player.tab == 2">
            <div class="left">
                <div id="worn" data-if="player.tab == 1">
                    <div class="heading">{{player.worn_title}}</div>
                    <div data-for="w, i : player.worn"><div class="worn-line" data-class-current="w.tone > 0" data-event-click="act('pm_slot', i)"><span class="l-label">{{w.label}}</span><span class="l-value">{{w.value}}</span></div></div>
                </div>
                <div class="chips">
                    <div class="slot" data-for="f, i : player.filters"><div class="chip" data-class-active="f.active" data-event-click="act('pm_filter', i)">{{f.label}}</div></div>
                </div>
                <div id="grid" data-class-short="player.tab == 1">
                    <div class="slot" data-for="c, i : player.cells"><div class="cell" data-class-selected="c.selected" data-event-click="act('pm_cell', i)">
                        <img class="cell-icon" data-attr-sprite="c.icon"/>
                        <div class="cell-name">{{c.name}}</div>
                        <div class="cell-badge" data-if="c.badge != ''">{{c.badge}}</div>
                        <div class="cell-worn" data-if="c.worn">âœ“</div>
                        <div class="cell-lock" data-if="c.locked"></div>
                    </div></div>
                    <div class="empty" data-if="player.cells.size == 0">{{player.empty_text}}</div>
                </div>
            </div>
            <div class="right">
                <div class="hint-center" data-if="!player.detail">{{player.select_hint}}</div>
                <div data-if="player.detail">
                    <img id="d-icon" data-attr-sprite="player.d_icon"/>
                    <div id="d-name">{{player.d_name}}</div>
                    <div id="d-desc">{{player.d_desc}}</div>
                    <div data-for="l : player.d_lines"><div class="line"><span class="l-label">{{l.label}}</span><span class="l-value">{{l.value}}</span></div></div>
                    <div id="compare" data-if="player.d_compare">
                        <div class="cmp head"><span class="c-label"></span><span class="c-now">{{player.d_now_label}}</span><span class="c-with">{{player.d_with_label}}</span></div>
                        <div data-for="l : player.d_compare_lines"><div class="cmp" data-class-better="l.tone > 0" data-class-worse="l.tone < 0"><span class="c-label">{{l.label}}</span><span class="c-now">{{l.value}}</span><span class="c-with">{{l.extra}}</span></div></div>
                    </div>
                    <div id="d-note" data-if="player.d_note != ''">{{player.d_note}}</div>
                    <div id="d-buttons">
                        <div class="slot" data-for="b, i : player.d_buttons"><div class="btn dbtn" data-class-off="!b.enabled" data-event-click="act('pm_btn', i)">{{b.label}}</div></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===== Events: Unfinished / All + the list | title, description, connected events ===== -->
        <div class="page" data-if="player.tab == 3">
            <div class="left">
                <div class="chips">
                    <div class="slot" data-for="f, i : player.ev_filters"><div class="chip" data-class-active="f.active" data-event-click="act('pm_filter', i)">{{f.label}}</div></div>
                </div>
                <div id="events">
                    <div data-for="r, i : player.ev_rows"><div class="row evrow" data-class-selected="r.selected" data-class-done="!r.enabled" data-event-click="act('pm_event', i)">{{r.label}}<span class="ev-sub">{{r.sub}}</span></div></div>
                    <div class="empty" data-if="player.ev_rows.size == 0">{{player.ev_empty}}</div>
                </div>
            </div>
            <div class="right">
                <div class="hint-center" data-if="!player.ev_detail">{{player.ev_hint}}</div>
                <div data-if="player.ev_detail">
                    <div id="ev-kind">{{player.ev_kind}}</div>
                    <div id="ev-title">{{player.ev_title}}</div>
                    <div id="ev-desc">{{player.ev_desc}}</div>
                    <div data-if="player.ev_connected.size > 0">
                        <div class="heading">{{player.ev_connected_title}}</div>
                        <div data-for="c : player.ev_connected"><div class="ev-link">{{c}}</div></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ===== System: the old â‰¡ list | the page it opens ===== -->
        <div class="page" data-if="player.tab == 4">
            <div class="left">
                <div id="sys-rows">
                    <div data-for="r, i : menu.main_rows"><div class="row sysrow" data-class-selected="r.selected" data-class-disabled="!r.enabled"
                         data-event-click="act('pm_sys', i)" data-event-mouseover="act('pm_sys_hover', i)">{{r.label}}<span class="rsub" data-if="r.sub != ''">{{r.sub}}</span></div></div>
                </div>
            </div>
            <div class="right">
                <div class="hint-center" data-if="menu.page == 0">{{player.sys_hint}}</div>
                <div id="sys-page" data-if="menu.page != 0">
                    <div id="sys-header">{{menu.header}}</div>
                    <div id="sys-sub" data-if="menu.subheader != ''">{{menu.subheader}}</div>
                    <div id="sys-list" data-class-compact="menu.rows.size > 7">
                        <div data-for="r, i : menu.rows">
                            <div class="section" data-if="r.section != ''">{{r.section}}</div>
                            <div class="row" data-class-selected="r.selected" data-class-disabled="!r.enabled"
                                 data-event-click="act('menu_row', i)" data-event-mouseover="act('menu_hover', i)">{{r.label}}<span class="rsub" data-if="r.sub != ''">{{r.sub}}</span></div>
                        </div>
                    </div>
                    <div id="sys-back" class="btn btn-plain" data-event-click="act('menu_close')">{{menu.close_label}}</div>
                </div>
            </div>
        </div>

        <div id="hint">{{player.hint}}</div>
    </div>

    <!-- "Drop <item>?" -->
    <div data-if="player.confirm_open">
        <div class="fill scrim"></div>
        <div class="confirm panel">
            <div class="question">{{player.confirm_question}}</div>
            <div class="answers">
                <div class="row answer" data-class-selected="player.confirm_yes" data-event-click="act('pm_confirm', 1)">{{player.yes_label}}</div>
                <div class="row answer" data-class-selected="!player.confirm_yes" data-event-click="act('pm_confirm', 0)">{{player.no_label}}</div>
            </div>
        </div>
    </div>
    <!-- System: "Switch to <language>?" / "Switch the art style to ...?" -->
    <div data-if="player.tab == 4 && menu.confirm_open">
        <div class="fill scrim"></div>
        <div class="confirm panel" data-class-with-body="menu.confirm_body != ''">
            <div class="question">{{menu.confirm_question}}</div>
            <div class="body" data-if="menu.confirm_body != ''">{{menu.confirm_body}}</div>
            <div class="answers">
                <div class="row answer" data-class-selected="menu.confirm_yes" data-event-click="act('menu_confirm', 1)">{{menu.yes_label}}</div>
                <div class="row answer" data-class-selected="!menu.confirm_yes" data-event-click="act('menu_confirm', 0)">{{menu.no_label}}</div>
            </div>
        </div>
    </div>
</body>
</rml>
/* saveload.rcss -- Save / Load (saveload.rml), over the player menu. Design space 1024x768. */
body { z-index: 50; }

#panel { position: absolute; left: 112px; top: 70px; width: 800px; height: 628px; word-break: break-word; }
#title { position: absolute; left: 30px; top: 22px; font-size: 30px; color: #f9e9b1; }
#modes { position: absolute; left: 30px; top: 76px; height: 44px; }
.slot  { display: inline-block; vertical-align: top; }
.mode {
    display: inline-block; width: 150px; height: 44px; line-height: 44px; margin-right: 10px; text-align: center;
    font-size: 21px; color: #e9eef9; background-color: #6f7285; border-radius: 22px; cursor: pointer;
}
.mode:hover { background-color: #7d8197; }
.mode.active { background-color: #ead98f; color: #2e3140; }
#close { position: absolute; right: 24px; top: 20px; width: 110px; height: 44px; line-height: 44px; font-size: 19px; }

#cards { position: absolute; left: 30px; right: 30px; top: 140px; }
.card {
    height: 96px; margin-bottom: 14px; padding: 12px 20px; cursor: pointer;
    background-color: #6f7285f5; border: 2px #00000000; border-radius: 8px;
}
.card:hover { background-color: #7d8197; }
.card.selected { background-color: #8594b0; border-color: #ffed7b; }
.card.off { background-color: #5f6273; }
.card.off .card-title, .card.off .card-line1 { color: #a9adbd; }
.card-title { font-size: 23px; color: #fff6c2; }
.card-tag   { margin-left: 14px; padding: 2px 10px; font-size: 15px; color: #2e3140; background-color: #9ff0b4; border-radius: 10px; }
.card-line1 { margin-top: 10px; font-size: 19px; color: #ffffff; }
.card-line2 { margin-top: 6px; font-size: 16px; color: #cad0e1; }

#hint { position: absolute; left: 30px; bottom: 16px; font-size: 15px; color: #cad0e1; }

#confirm  { position: absolute; left: 232px; top: 279px; width: 560px; height: 210px; text-align: center; word-break: break-word; }
#confirm.with-body { top: 254px; height: 260px; }
#question { margin-top: 50px; padding: 0 20px; font-size: 26px; color: #f9e9b1; }
#confirm.with-body #question { margin-top: 34px; }
#body     { margin-top: 12px; padding: 0 20px; font-size: 18px; color: #cad0e1; }
#answers  { position: absolute; left: 0; right: 0; bottom: 26px; }
.answer   { display: inline-block; width: 160px; height: 52px; line-height: 52px; margin: 0 20px; text-align: center; font-size: 20px; color: #ffffff; }
<rml>
<head>
    <title>Save / Load</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="saveload.rcss"/>
</head>
<!-- Save / Load: the player menu's System tab -> "Save / Load". A Save tab and a Load tab over the same
     slot cards; choosing a slot opens a confirmation, and nothing is written or loaded before "yes".
     Data: saveload.* (UiSaveLoad). Buttons: act('pm_sl_*', n) -> Game::playerMenuEvent.
     data-for sits on a wrapper, its bindings on the element inside (see player.rml). -->
<body data-model="game">
    <div class="fill scrim"></div>
    <div id="panel" class="panel">
        <div id="title">{{saveload.title}}</div>
        <div id="modes">
            <div class="slot" data-for="m, i : saveload.modes"><div class="mode" data-class-active="m.active" data-event-click="act('pm_sl_mode', i)">{{m.label}}</div></div>
        </div>
        <div id="close" class="btn btn-plain" data-event-click="act('pm_sl_close')">{{saveload.close_label}}</div>

        <div id="cards">
            <div data-for="c, i : saveload.cards"><div class="card" data-class-selected="c.selected" data-class-empty="c.empty" data-class-off="!c.enabled"
                 data-event-click="act('pm_sl_slot', i)" data-event-mouseover="act('pm_sl_hover', i)">
                <div class="card-title">{{c.title}}<span class="card-tag" data-if="c.tag != ''">{{c.tag}}</span></div>
                <div class="card-line1">{{c.line1}}</div>
                <div class="card-line2">{{c.line2}}</div>
            </div></div>
        </div>
        <div id="hint">{{saveload.hint}}</div>
    </div>

    <div data-if="saveload.confirm_open">
        <div class="fill scrim"></div>
        <div id="confirm" class="panel" data-class-with-body="saveload.confirm_body != ''">
            <div id="question">{{saveload.confirm_question}}</div>
            <div id="body" data-if="saveload.confirm_body != ''">{{saveload.confirm_body}}</div>
            <div id="answers">
                <div class="row answer" data-class-selected="saveload.confirm_yes" data-event-click="act('pm_sl_confirm', 1)">{{saveload.yes_label}}</div>
                <div class="row answer" data-class-selected="!saveload.confirm_yes" data-event-click="act('pm_sl_confirm', 0)">{{saveload.no_label}}</div>
            </div>
        </div>
    </div>
</body>
</rml>
/* stage_select.rcss -- the floor list (stage_select.rml). */
body { z-index: 45; }

#panel { position: absolute; left: 60px; top: 50px; right: 60px; bottom: 50px; padding: 18px 24px; }
#title { font-size: 30px; color: #f9e9b1; }
#hint  { margin-top: 4px; font-size: 17px; color: #cad0e1; }
#list  { position: absolute; left: 24px; right: 24px; top: 96px; bottom: 76px; overflow-y: auto; }
.row   { margin: 0 8px 8px 0; padding: 8px 14px; }
.label { font-size: 21px; color: #ffffff; }
.row.disabled .label { color: #a9adbd; }
.sub   { margin-top: 2px; font-size: 16px; color: #cad0e1; }
#close { position: absolute; right: 24px; bottom: 18px; width: 140px; height: 44px; line-height: 44px; font-size: 19px; }
<rml>
<head>
    <title>Stage select</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="stage_select.rcss"/>
</head>
<!-- Tab: jump to any floor reached so far. Locked floors are dimmed and say why.
     Data: stage_select.* (UiStageSelect). -->
<body data-model="game">
    <div class="fill scrim"></div>
    <div id="panel" class="panel">
        <div id="title">{{stage_select.title}}</div>
        <div id="hint">{{stage_select.hint}}</div>
        <div id="list">
            <div data-for="r, i : stage_select.rows">
                <div class="row" data-class-disabled="!r.enabled" data-event-click="act('stage_pick', i)">
                    <div class="label">{{r.label}}</div>
                    <div class="sub" data-if="r.sub != ''">{{r.sub}}</div>
                </div>
            </div>
        </div>
        <div id="close" class="btn btn-plain" data-event-click="act('stage_close')">{{stage_select.close_label}}</div>
    </div>
</body>
</rml>
/* store.rcss -- the item store (store.rml). */

body { z-index: 40; }

/* Full-screen dim behind the panel (the old store's 50% black splash). Clicking it closes. */
#backdrop {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: #00000080;
}

#panel {
    position: absolute; left: 40px; top: 40px; right: 40px; bottom: 40px;
    background-color: #505a6ff5;
    border: 2px #8291af;
    border-radius: 14px;
}

#header { position: absolute; left: 20px; right: 20px; top: 16px; height: 40px; }
#title  { position: absolute; left: 0; top: 0; font-size: 28px; color: #fff3ba; }
#gold   { position: absolute; right: 120px; top: 8px; font-size: 20px; color: #fff9a8; }
.gold   { color: #ffe984; }
#hint   { position: absolute; left: 20px; top: 58px; font-size: 14px; color: #e6edffe6; }

#close {
    position: absolute; right: 0; top: 2px; width: 90px; height: 34px; line-height: 34px;
    background-color: #ba7b7b; color: #ffffff;
}
#close:hover { background-color: #ce8888; }

#tabs { position: absolute; left: 20px; top: 84px; height: 34px; }
.tab-slot { float: left; }
.tab { width: 100px; height: 34px; line-height: 34px; margin-right: 12px;
    font-size: 17px; background-color: #65697be6; color: #e6e9f3;
}
.tab:hover  { background-color: #737b97; }
.tab.active { background-color: #8593af; color: #fff9ca; }

/* The cards: a centred row of 300x300 cards, like storeCardRects(). */
#cards {
    position: absolute; left: 0; right: 0; top: 174px; height: 300px;
    display: flex; justify-content: center;
}
.card-slot { flex: 0 0 auto; margin: 0 8px; }
.card {
    position: relative; box-sizing: border-box;
    width: 290px; height: 300px;
    background-color: #697085f5;
    border: 3px #00000000;
    border-radius: 10px;
    transition: background-color 0.12s;
}
.card.selected { background-color: #808aa5; border-color: #ffed7b; }

.icon   { display: block; width: 80px; height: 80px; margin: 10px auto 0 auto; }
.name   { margin: 6px 14px 0 14px; font-size: 24px; color: #ffffff; }
.desc   { margin: 4px 14px 0 14px; font-size: 15px; color: #edf3ff; height: 20px; white-space: nowrap; overflow: hidden; }
.effect { margin: 4px 14px 0 14px; font-size: 15px; line-height: 19px;   /* may wrap to 2 lines */
          color: #caffd9; }
.status { margin: 2px 14px 0 14px; font-size: 14px; color: #d9d9e6; }
.status.equipped { color: #baffca; }
.price  { margin: 2px 14px 0 14px; font-size: 20px; color: #fff9a8; }

.buy {
    position: absolute; left: 14px; right: 14px; bottom: 10px; height: 36px; line-height: 36px;
    font-size: 16px; background-color: #7bba93; color: #ffffff;
    transition: background-color 0.12s;
}
.buy:hover  { background-color: #88cea4; }
.buy:active { background-color: #6dac85; }
<rml>
<head>
    <title>Store</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="_atlas.rcss"/>
    <link type="text/rcss" href="store.rcss"/>
</head>
<!-- The item store: tabs, up to three cards per tab, buy buttons. A click outside the panel
     closes it. Purchase messages are the overlay's toast. Data: store.* (UiStore). -->
<body data-model="game">
    <div id="backdrop" data-event-click="act('store_close')"></div>

    <div id="panel">
        <div id="header">
            <div id="title">{{store.title}}</div>
            <div id="gold">{{store.gold_label}}: <span class="gold">{{store.gold}}</span></div>
            <div id="close" class="btn" data-event-click="act('store_close')">{{store.close_label}} X</div>
        </div>
        <div id="hint">{{store.hint}}</div>

        <div id="tabs">
            <div class="tab-slot" data-for="tab, i : store.tabs">
                <div class="tab btn" data-class-active="tab.active" data-event-click="act('store_tab', i)">{{tab.label}}</div>
            </div>
        </div>

        <div id="cards">
            <div class="card-slot" data-for="item, i : store.items">
            <div class="card" data-class-selected="item.selected" data-event-mouseover="act('store_hover', i)">
                <img class="icon" data-attr-sprite="item.icon"/>
                <div class="name">{{item.name}}</div>
                <div class="desc">{{item.desc}}</div>
                <div class="effect">{{store.effect_label}}: {{item.effect}}</div>
                <div class="status" data-class-equipped="item.equipped">{{item.status}}</div>
                <div class="price">{{store.price_label}}: {{item.price}} G</div>
                <div class="buy btn" data-event-click="act('store_buy', i)">{{store.buy_label}}</div>
            </div>
            </div>
        </div>
    </div>
</body>
</rml>
/* title.rcss -- the boot screen (title.rml). */
body { z-index: 60; background-color: #414155; text-align: center; }
/* A 3D scene behind the title (the host's TitleScene, docs/18_GLTF.md): the body is see-through (the
   scene is drawn a little dark instead, so there is no 4:3 box over a wide screen). */
body.scene { background-color: transparent; }

.rule {
    position: absolute; left: 0; right: 0; height: 2px;
    background-color: #f9e9b1;
    animation: 1.4s cubic-in-out infinite alternate pulse;
}
#name     { position: absolute; left: 0; right: 0; top: 88px; font-size: 60px; color: #f9e9b1; }
#subtitle { position: absolute; left: 0; right: 0; top: 156px; font-size: 20px; color: #cad0e1; }

/* The current page: a centred column of rows. Width and start depend on the page. */
#page { position: absolute; left: 0; right: 0; top: 330px; }
#page.slots { top: 196px; }
#page.langs { top: 236px; }
#header    { font-size: 34px; color: #f9e9b1; margin-bottom: 8px; }
#subheader { font-size: 22px; color: #cad0e1; margin-bottom: 12px; }

/* One title row: dark panel, gold accent bar on the left, label (+ dimmer second line). */
.trow {
    position: relative; cursor: pointer;
    width: 360px; min-height: 64px; margin: 0 auto 14px auto;
    background-color: #5d6175f5;
    text-align: left;
    transition: background-color 0.12s cubic-out;
}
#page.slots .trow { width: 720px; }
#page.langs .trow { width: 520px; min-height: 48px; margin-bottom: 8px; }
.trow:hover, .trow.selected { background-color: #7b7d94f5; }
.accent {
    position: absolute; left: 0; top: 0; bottom: 0; width: 6px;
    background-color: #f9e9b1; opacity: 0.35;
}
.accent.back { background-color: #cad0e1; }
.trow.selected .accent { opacity: 1; animation: 1.4s cubic-in-out infinite alternate pulse; }
.cursor {
    position: absolute; left: -30px; top: 14px; font-size: 30px; color: #f9e9b1;
    visibility: hidden;
}
.trow.selected .cursor { visibility: visible; }
.label { padding: 14px 16px 0 24px; font-size: 28px; color: #eef1f8; white-space: pre; }   /* keep the column spacing */
#page.langs .label { padding-top: 8px; font-size: 25px; }
/* Settings' section headings (Language / Art style), left-aligned over their rows */
#page.langs .section { width: 520px; margin: 4px auto 6px auto; text-align: left; font-size: 20px; color: #f9e9b1; }
/* Settings with the art style rows too (more than 6 rows): shorter rows so the list stays above
   the Back button; a row's second line ("applies after a restart") moves to its right end. */
#page.langs.compact { top: 226px; }
#page.langs.compact #subheader { margin-bottom: 8px; }
#page.langs.compact .trow { min-height: 34px; margin-bottom: 4px; }
#page.langs.compact .section { margin: 8px auto 4px auto; font-size: 18px; }
#page.langs.compact .label { padding-top: 4px; font-size: 21px; }
#page.langs.compact .cursor { top: 2px; font-size: 26px; }
#page.langs.compact .sub { position: absolute; right: 16px; top: 9px; padding: 0; font-size: 15px; }
.trow.selected .label { color: #fffbee; }
.sub   { padding: 2px 16px 10px 24px; font-size: 17px; color: #cad0e1; white-space: pre; }

#back { position: absolute; left: 402px; top: 668px; width: 220px; min-height: 52px; margin: 0; }
#back .label { padding-top: 10px; text-align: center; }
#empty-hint { position: absolute; left: 0; right: 0; top: 580px; font-size: 21px; color: #cad0e1; }
#hint       { position: absolute; left: 0; right: 0; top: 716px; font-size: 18px; color: #cad0e1; }

/* Confirm dialog ("start a new game in slot N?" / "switch to <language>?") */
#confirm  { position: absolute; left: 232px; top: 279px; width: 560px; height: 210px; }
#question { margin-top: 34px; font-size: 30px; color: #f9e9b1; }
#body     { margin-top: 14px; font-size: 18px; color: #cad0e1; }
#answers  { position: absolute; left: 0; right: 0; bottom: 26px; }
#confirm.with-body { top: 254px; height: 260px; }   /* a two-line question + the body line still clear the answers */
.answer   { display: inline-block; width: 160px; min-height: 56px; margin: 0 20px; }
.answer .label { padding-top: 12px; text-align: center; }
<rml>
<head>
    <title>Title</title>
    <link type="text/rcss" href="common.rcss"/>
    <link type="text/rcss" href="title.rcss"/>
</head>
<!-- The boot screen: New Game / Continue (save slots) / Settings (language), and their two
     confirm dialogs. Data: title.* (UiTitle). Rows are the current page's, in keyboard order. -->
<body data-model="game" data-class-scene="title.scene">
    <div class="rule" style="top: 74px;"></div>
    <div class="rule" style="bottom: 62px;"></div>
    <div id="name">{{title.title}}</div>
    <div id="subtitle">{{title.subtitle}}</div>

    <div id="page" data-class-menu="title.page == 0" data-class-slots="title.page == 1" data-class-langs="title.page == 2"
         data-class-compact="title.rows.size > 6">
        <div id="header" data-if="title.header != ''">{{title.header}}</div>
        <div id="subheader" data-if="title.subheader != ''">{{title.subheader}}</div>
        <div data-for="row, i : title.rows">
            <div class="section" data-if="row.section != ''">{{row.section}}</div>
            <div class="trow" data-class-selected="row.selected"
                 data-event-click="act('title_row', i)" data-event-mouseover="act('title_hover', i)">
                <div class="accent"></div>
                <div class="cursor">&gt;</div>
                <div class="label">{{row.label}}</div>
                <div class="sub" data-if="row.sub != ''">{{row.sub}}</div>
            </div>
        </div>
    </div>

    <div id="empty-hint" data-if="title.show_empty_hint">{{title.empty_hint}}</div>
    <div id="back" class="trow" data-if="title.show_back" data-event-click="act('title_back')">
        <div class="accent back"></div>
        <div class="label">{{title.back_label}}</div>
    </div>
    <div id="hint">{{title.hint}}</div>

    <div data-if="title.confirm_open">
        <div class="fill scrim"></div>
        <div id="confirm" class="panel" data-class-with-body="title.confirm_body != ''">
            <div id="question">{{title.confirm_question}}</div>
            <div id="body" data-if="title.confirm_body != ''">{{title.confirm_body}}</div>
            <div id="answers">
                <div class="trow answer" data-class-selected="title.confirm_yes" data-event-click="act('title_confirm', 1)">
                    <div class="accent"></div><div class="label">{{title.yes_label}}</div>
                </div>
                <div class="trow answer" data-class-selected="!title.confirm_yes" data-event-click="act('title_confirm', 0)">
                    <div class="accent"></div><div class="label">{{title.no_label}}</div>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
