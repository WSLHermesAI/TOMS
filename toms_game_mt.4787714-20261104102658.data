      "en": "The peddler's chest is locked. Pick it: tap as the marker passes each pin. Every pin you free earns you a share of gold."
    },
    "currency": "gold",
    "perHit": 15,
    "bonusAll": 30,
    "points": 4,
    "sweepMs": 1600,
    "turnBack": true,
    "maxSweeps": 2,
    "hitWindow": 0.07,
    "limit": 3
  },
  "crystal_shrine": {
    "title": {
      "zh_TW": "æ°´æ™¶ç¥­å£‡"
    },
    "text": {
      "zh_TW": "å¤è€çš„ç¥­å£‡ä¸Šæµ®è‘—ä¸‰é¡†å¾®å…‰ã€‚å…‰é»æ éæ™‚ï¼Œä»¥æŒ‡å°–è¼•è§¸ï¼Œå°±èƒ½å‡å‡ºæ°´æ™¶ã€‚å…¨éƒ¨å‡æˆï¼Œç¥­å£‡æœƒå¤šè´ˆä¸€é¡†ã€‚"
