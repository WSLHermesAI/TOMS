{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ]
        }
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug (game + editor)",
      "description": "Debug build of toms_game and toms_editor (the editor needs Qt 6 MSVC 64-bit).",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release (game + editor)",
      "description": "Optimized build with debug info; use this for day-to-day play testing.",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-shipping",
      "displayName": "Windows x64 Shipping (game only, no Qt)",
      "description": "What ships: toms_game only. Qt is not searched for.",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TOMS_BUILD_EDITOR": "OFF",
        "TOMS_WINDOWED_EXE": "ON"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI (no popups)",
      "inherits": "windows-release",
      "cacheVariables": {
        "TOMS_POPUP_WARNINGS": "OFF"
      }
    },
    {
      "name": "web-debug",
      "displayName": "Web/WASM Debug (WSL/Linux)",
      "description": "Emscripten/wasm32 from $env{EMSDK}. Signed-off on WSL2: configure OK, 364/422 objects incl. shaderc.js link.",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_CROSSCOMPILING_EMULATOR": "node",
        "CMAKE_EXECUTABLE_SUFFIX": ".js",
        "WEB": "ON",
        "CMAKE_C_FLAGS": "-msimd128 -sSTACK_SIZE=8388608",
        "CMAKE_CXX_FLAGS": "-msimd128 -sSTACK_SIZE=8388608",
        "CMAKE_EXE_LINKER_FLAGS": "-msimd128 -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=268435456",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "web-release",
      "displayName": "Web/WASM Release (WSL/Linux)",
      "description": "Emscripten/wasm32 from $env{EMSDK}. Release, not RelWithDebInfo: DWARF made the wasm 33 MB vs 2.8 MB (their 2026-09-26 finding).",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_CROSSCOMPILING_EMULATOR": "node",
        "CMAKE_EXECUTABLE_SUFFIX": ".js",
        "WEB": "ON",
        "CMAKE_C_FLAGS": "-msimd128 -sSTACK_SIZE=8388608",
        "CMAKE_CXX_FLAGS": "-msimd128 -sSTACK_SIZE=8388608",
        "CMAKE_EXE_LINKER_FLAGS": "-msimd128 -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=268435456",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "web-debug-windows",
      "displayName": "Web/WASM Debug (Windows)",
      "description": "Emscripten/wasm32 from $env{EMSDK} (D:\\Work\\emsdk). Run emsdk_env first so EMSDK is set. Same flags as the WSL presets -- -msimd128 is required on every host.",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_CROSSCOMPILING_EMULATOR": "node",
        "CMAKE_EXECUTABLE_SUFFIX": ".js",
        "WEB": "ON",
        "CMAKE_C_FLAGS": "-msimd128",
        "CMAKE_CXX_FLAGS": "-msimd128",
        "CMAKE_EXE_LINKER_FLAGS": "-msimd128",
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web-debug-windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "web-release-windows",
      "displayName": "Web/WASM Release (Windows)",
      "description": "What gets published: optimized, no DWARF (RelWithDebInfo made a 33 MB .wasm; Release is ~3 MB). Emscripten from $env{EMSDK}; use tools\\build_web.cmd, which sets it up. For C++ debugging in the browser use web-debug-windows.",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "CMAKE_CROSSCOMPILING_EMULATOR": "node",
        "CMAKE_EXECUTABLE_SUFFIX": ".js",
        "WEB": "ON",
        "CMAKE_C_FLAGS": "-msimd128",
        "CMAKE_CXX_FLAGS": "-msimd128",
        "CMAKE_EXE_LINKER_FLAGS": "-msimd128",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web-release-windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "android-debug",
      "displayName": "Android/arm64 Debug",
      "description": "NDK arm64-v8a, android-24, c++_shared. Needs ANDROID_NDK + a host shaderc (see docs/07_BUILD_ANDROID.md).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-android-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_shared",
        "TOMS_HOST_SHADERC": "$env{TOMS_HOST_SHADERC}",
        "TOMS_SHADER_PROFILES": "100_es;300_es",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,-z,max-page-size=16384"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "android-release",
      "displayName": "Android/arm64 Release",
      "description": "NDK arm64-v8a, android-24, c++_shared, 16 KB pages. Needs ANDROID_NDK + TOMS_HOST_SHADERC.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-android-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_shared",
        "TOMS_HOST_SHADERC": "$env{TOMS_HOST_SHADERC}",
        "TOMS_SHADER_PROFILES": "100_es;300_es",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,-z,max-page-size=16384"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-shipping",
      "configurePreset": "windows-shipping"
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows"
    },
    {
      "name": "web-debug",
      "configurePreset": "web-debug",
      "jobs": 2
    },
    {
      "name": "web-release",
      "configurePreset": "web-release",
      "jobs": 2
    },
    {
      "name": "web-debug-windows",
      "configurePreset": "web-debug-windows",
      "jobs": 8
    },
    {
      "name": "web-release-windows",
      "configurePreset": "web-release-windows",
      "jobs": 8
    },
    {
      "name": "android-debug",
      "configurePreset": "android-debug",
      "jobs": 8
    },
    {
      "name": "android-release",
      "configurePreset": "android-release",
      "jobs": 8
    }
  ]
}